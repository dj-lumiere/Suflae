module System

### Raised when a view of part of a memory is asked to grow. Only a whole memory moves into a bigger row: a view shows
### a fixed window of places.
crashable MemoryViewShapeError
    ### What was tried.
    operation: Text

### Returns the message the crash shows.
@override
routine MemoryViewShapeError.crash_message() -> Text
    return f"'{me.operation}' cannot run on a view of part of a buffer: only a whole buffer grows"
