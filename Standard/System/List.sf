module System

import BuilderQuery

### A growable sequence of elements, counted and indexed with `Int`.
###
### `List[T]` keeps its elements in a `Memory[T]`, one after another from the first place. Reading or writing by
### position is O(1). Adding or removing at the back is O(1) amortized: the list moves into a memory twice the size
### when it runs out of room. Adding or removing anywhere else is O(n), since the elements after it move. One list
### is a stack (`add_last` / `remove_last`). For a queue, a deque, rotation or a latest-N history, use
### `RotatableList[T]`, which is O(1) at both ends.
###
### Positions count from 0. A negative position crashes with `NegativeIndexError`, one at or past the end
### with `IndexOutOfBoundsError`.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `add_last` | O(1) amortized |
### | `remove_last` | O(1) |
### | `add_first` / `remove_first` | O(n) |
### | `add_at` / `remove_at` | O(n) |
### | `xs[i]` / `xs[i] = v` | O(1) |
### | `have` | O(n) |
### | `sort` | O(n log n) |
### | Iteration | O(n) |
###
### :typeparam T: The element type stored in the list.
entity List[T]
relates MemoryEmitter[T] as Emitter
obeys Emittable[T], Container, Equatable, Copyable, ListLiteral[T]
    ### The places the elements live in.
    secret items: Memory[T]
    ### How many elements there are.
    secret count: U64

# ============================================================================
# Creators
# ============================================================================

### Creates an empty list.
routine List[T]() -> List[T]
    return List[T](items: Memory[T](capacity: 0), count: 0)

### Creates an empty list with room for at least `capacity` elements.
### :param capacity: The number of elements to make room for.
### :throws: {NegativeIndexError} if `capacity` is negative.
### :throws: {OutOfMemoryError} if the elements take more bytes than a `U64` counts, or there is no memory left for them.
failable routine List[T](capacity: Int) -> List[T]
    return List[T](items: Memory[T](capacity: capacity), count: 0)

### Creates a list of `count` copies of `fill_value`.
### :param count: The number of elements.
### :param fill_value: The value every element starts as.
### :throws: {NegativeIndexError} if `count` is negative.
### :throws: {OutOfMemoryError} if the elements take more bytes than a `U64` counts, or there is no memory left for them.
failable routine List[T](count: Int, fill_value: T) -> List[T]
    return List[T](items: Memory[T](count: count, fill: fill_value), count: count.to[U64]())

### Returns a RazorForge list of copies of the elements, for a RazorForge library routine that takes one.
routine List[T].to[RF::System.List[T]]() -> RF::System.List[T]
    var result = RF::System.List[T](capacity: me.count)
    for element in me
        result.add_last(value: element)
    return result

### Builds a list from its serialized element list.
### :throws: {SerialShapeError} when the value is not a list or an element does not fit `T`.
failable common routine List[T].from_serial(value: SerialValue) -> List[T]
    var result = List[T]()
    when value
        is RF::System.List[SerialValue] as items =>
            for item in items
                result.add_last(value: serial_decode[T](value: item))
        else =>
            throw SerialShapeError(detail: "expected a list")
    return result

### Builds the list a `[a, b, c]` literal writes.
### :param elements: The elements, in order.
common routine List[T].from_literal(elements...: T) -> List[T]
    var result = List[T](capacity: elements.count().to[Int]())
    var i: U64 = 0
    # Each element moves into the list: `add_last` makes the list's holder, and the caller releases the
    # literal's own afterwards.
    until i >= elements.count()
        result.add_last(value: elements.get_raw(index: i))
        i = i +% 1
    return result

# ============================================================================
# Size
# ============================================================================

### Returns the number of elements.
@inline
routine List[T].count() -> Int
    return me.count.to[Int]()

### Returns the number of elements the list holds without growing.
routine List[T].capacity() -> Int
    return me.items.room().to[Int]()

### Returns whether the list has no elements.
@inline
routine List[T].is_empty() -> Bool
    return me.count == 0

# ============================================================================
# Adding and removing
# ============================================================================

### Adds `value` at the back. The list moves into a bigger memory when it is full.
### :param value: The value to add.
@inline
routine List[T].add_last(value: T)
    me.make_room(extra: 1)
    danger
        me.items.put_unchecked(position: me.count, value: value)
    me.count = me.count + 1
    return

### Adds `value` at the front, moving every element one place back. The list moves into a bigger memory when it
### is full.
### :param value: The value to add.
routine List[T].add_first(value: T)
    me.make_room(extra: 1)
    me.items.carry(source: 0, target: 1, count: me.count)
    me.items.put(position: 0, value: value)
    me.count = me.count + 1
    return

### Adds every element of `you` at the back, in order.
### :param you: The elements to add.
routine List[T].add_range(you: Emittable[T])
    for value in you
        me.add_last(value: value)
    return

### Adds `count` elements of `source`, starting at `from`, at the back of this list.
### :param source: The list to copy from.
### :param from: The first position of `source` to copy.
### :param count: How many elements to copy.
failable routine List[T].add_range(source: List[T], from: Int, count: Int)
    var first = position_of(value: from)
    var n = position_of(value: count)
    if first + n > source.count
        throw IndexOutOfBoundsError(index: first + n, count: source.count)
    me.make_room(extra: n)
    var i: U64 = 0
    until i >= n
        me.add_last(value: source.items.at(position: first + i))
        i = i + 1
    return

### Inserts `value` at `index`, moving the elements from there one place back.
### :param index: Where the new element goes, from 0 to `count()`.
### :param value: The value to insert.
failable routine List[T].add_at(index: Int, value: T)
    var at = position_of(value: index)
    if at > me.count
        throw IndexOutOfBoundsError(index: at, count: me.count)
    me.make_room(extra: 1)
    me.items.carry(source: at, target: at + 1, count: me.count - at)
    me.items.put(position: at, value: value)
    me.count = me.count + 1
    return

### Removes and returns the last element.
### :throws: {AbsentValueError} The list is empty.
failable routine List[T].remove_last() -> T
    if me.count == 0
        throw AbsentValueError()
    var value = me.items.take_at(position: me.count - 1)
    me.count = me.count - 1
    return value

### Removes and returns the first element, moving the others one place forward.
### :throws: {AbsentValueError} The list is empty.
failable routine List[T].remove_first() -> T
    if me.count == 0
        throw AbsentValueError()
    var value = me.items.take_at(position: 0)
    me.items.carry(source: 1, target: 0, count: me.count - 1)
    me.count = me.count - 1
    return value

### Removes and returns the element at `index`, moving the elements after it one place forward.
### :param index: The position to remove.
failable routine List[T].remove_at(index: Int) -> T
    var at = me.checked_position(index: index)
    var value = me.items.take_at(position: at)
    me.items.carry(source: at + 1, target: at, count: me.count - at - 1)
    me.count = me.count - 1
    return value

### Keeps the first `new_count` elements and removes the rest.
### :param new_count: How many elements to keep.
failable routine List[T].truncate(new_count: Int)
    var kept = position_of(value: new_count)
    if kept > me.count
        throw IndexOutOfBoundsError(index: kept, count: me.count)
    me.cut(kept: kept)
    return

### Removes every element and keeps the memory.
routine List[T].clear()
    me.cut(kept: 0)
    return

### Makes room for at least `new_capacity` elements without growing again.
### :param new_capacity: The number of elements to make room for.
### :throws: {OutOfMemoryError} if the elements take more bytes than a `U64` counts, or there is no memory left for them. The list then stays
###     as it was.
failable routine List[T].reserve(new_capacity: Int)
    if new_capacity > me.items.room().to[Int]()
        me.items.grow_to(room: room_of(capacity: new_capacity))
    return

# ============================================================================
# Reading and writing by position
# ============================================================================

### Returns the first element.
### :throws: {AbsentValueError} The list is empty.
failable routine List[T].first() -> T
    if me.count == 0
        throw AbsentValueError()
    danger
        return me.items.at_unchecked(position: 0)

### Returns the last element.
### :throws: {AbsentValueError} The list is empty.
failable routine List[T].last() -> T
    if me.count == 0
        throw AbsentValueError()
    danger
        return me.items.at_unchecked(position: me.count - 1)

### Returns the first element, or `default_value` if the list is empty.
### :param default_value: The value to return when there is no element.
routine List[T].first_or_default(default_value: T) -> T
    if me.count == 0
        return default_value
    return me.first()

### Returns the last element, or `default_value` if the list is empty.
### :param default_value: The value to return when there is no element.
routine List[T].last_or_default(default_value: T) -> T
    if me.count == 0
        return default_value
    return me.last()

### Returns the element at `index` (`xs[i]`).
### :param index: The position to read.
@inline
failable routine List[T].getitem(index: Int) -> T
    # The list's own check is the only one: its count never passes the memory's room.
    var at = me.checked_position(index: index)
    danger
        return me.items.at_unchecked(position: at)

### Replaces the element at `index` (`xs[i] = v`).
### :param index: The position to write.
### :param value: The new element.
@inline
failable routine List[T].setitem(index: Int, value: T)
    var at = me.checked_position(index: index)
    danger
        me.items.put_unchecked(position: at, value: value)
    return

### Returns a new list of the elements at the positions in `range` (`xs[a til b]`). Positions outside the
### list are skipped, and a range that counts down (`by -1`) gives the elements in reverse.
### :param range: The positions to copy.
routine List[T].getitem(range: Range[Int]) -> List[T]
    var result = List[T]()
    var count = me.count.to[Int]()
    for i in range
        if not i.is_negative() and i < count
            result.add_last(value: me.items.at(position: i.to[U64]()))
    return result

# ============================================================================
# Iteration, comparison and display
# ============================================================================

### Returns a walk over the elements, front to back.
routine List[T].emitter() -> MemoryEmitter[T]
    return me.items.walk_at(first: 0, count: me.count)

### Returns whether both lists hold equal elements in the same order.
### :param you: The other list.
routine List[T].eq(you: List[T]) -> Bool
needs T obeys Equatable
    if me.count != you.count
        return false
    var i: U64 = 0
    until i >= me.count
        if me.items.at(position: i) != you.items.at(position: i)
            return false
        i = i + 1
    return true

### Returns whether some element equals `value` (`xs have v`).
### :param value: The value to look for.
routine List[T].has(value: T) -> Bool
needs T obeys Equatable
    for element in me
        if element == value
            return true
    return false

### Returns whether `value` is not in this value: the opposite of `has`.
### :param value: The value to look for.
### :returns: `true` when `value` is absent.
routine List[T].lacks(value: T) -> Bool
needs T obeys Equatable
    return not me.has(value)

### Returns the list as text: `[1, 2, 3]`.
@override
routine List[T].represent() -> Text
    return me.elements_text(diagnosing: false)

### Returns the list's diagnostic text: its type, count and elements.
@override
routine List[T].diagnose() -> Text
    return f"{me.full_type_name()}(count: {me.count}, {me.elements_text(diagnosing: true)})"

### Returns a new list holding copies of the elements.
routine List[T].duplicate() -> List[T]
    var result = List[T](capacity: me.count.to[Int]())
    for element in me
        result.add_last(value: element)
    return result

### Returns the list as a `SerialValue.List` of its serialized elements.
@override
routine List[T].serialize() -> SerialValue
    var result = RF::System.List[SerialValue]()
    for element in me
        result.add_last(value: element.serialize())
    return SerialValue(result.duplicate())

# ============================================================================
# Ordering
# ============================================================================

### Sorts the elements in ascending order. The sort is stable: equal elements keep their order.
routine List[T].sort()
needs T obeys Comparable
    me.items.view(first: 0, room: me.count).sort()
    return

### Sorts the elements so that `compare(a, b)` holds for every `a` before `b` it decides. Stable.
### :param compare: Returns whether its first argument goes before its second.
routine List[T].sort_by(compare: failable Callable[(T, T), Bool])
    me.items.view(first: 0, room: me.count).sort_by(compare: compare)
    return

### Returns a new list of the elements in ascending order.
routine List[T].sorted() -> List[T]
needs T obeys Comparable
    var result = me.duplicate()
    result.sort()
    return result

### Returns a new list of the elements, ordered by `compare`.
### :param compare: Returns whether its first argument goes before its second.
routine List[T].sorted_by(compare: failable Callable[(T, T), Bool]) -> List[T]
    var result = me.duplicate()
    result.sort_by(compare: compare)
    return result

### Swaps the elements at `first` and `second` in place.
### :param first: One position.
### :param second: The other position.
@inline
failable routine List[T].swap(first: Int, second: Int)
    var a = me.checked_position(index: first)
    var b = me.checked_position(index: second)
    danger
        me.items.swap_unchecked(first: a, second: b)
    return

### Reverses the order of the elements.
routine List[T].reverse_in_place()
    me.items.view(first: 0, room: me.count).reverse()
    return

# ============================================================================
# Inside the list
# ============================================================================

### The position `index` names, crashing unless it is the position of an element.
@inline
secret failable routine List[T].checked_position(index: Int) -> U64
    var at = position_of(value: index)
    if at >= me.count
        throw IndexOutOfBoundsError(index: at, count: me.count)
    return at

### Tears down the elements from position `kept` on, keeping the first `kept` (at most the count).
secret routine List[T].cut(kept: U64)
    var i = kept
    until i >= me.count
        me.items.erase_at(position: i)
        i = i + 1
    me.count = kept
    return

### Moves into a bigger memory when fewer than `extra` places are free: twice the room, at least four, or as much
### as needed.
@inline
secret routine List[T].make_room(extra: U64)
    var needed = me.count + extra
    if needed > me.items.room()
        me.grow_for(needed: needed)
    return

### Moves into a memory with room for at least `needed` elements: twice the room, at least four, or as much as
### needed.
secret routine List[T].grow_for(needed: U64)
    var room = me.items.room()
    var grown: U64 = if room < 4 then 4 else room * 2
    if grown < needed
        grown = needed
    me.items.grow_to(room: grown)
    return

### The elements as text: `[1, 2, 3]`.
### :param diagnosing: Whether this is for `diagnose()`, where a text element is quoted with its escapes.
secret routine List[T].elements_text(diagnosing: Bool) -> Text
    var result = "["
    var first = true
    for element in me
        if not first
            result = f"{result}, "
        result = f"{result}{nested_form(value: element, diagnosing: diagnosing)}"
        first = false
    return f"{result}]"
