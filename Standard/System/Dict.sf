module System

import BuilderQuery

### A hash-flooding-resistant insertion-ordered key-value dictionary.
###
### `Dict[TKey, TValue]` keeps its keys and values in `Memory` rows in insertion order, with a `HashIndex` probe table
### over them. It hashes with SipHash-2-4 keyed by a per-instance secret, so the probe sequence is unpredictable to
### external attackers. Iteration order follows insertion order; the secret key only affects the probe table.
###
### **When to use**
### - You are storing data derived from untrusted input (e.g. HTTP headers, user IDs, file names).
### - You need insert/lookup/remove by key with insertion-ordered iteration.
###
### **Complexity**
### | Operation | Average | Worst case |
### |---|---|---|
### | `add` | O(1) | O(n) (rehash) |
### | `remove` | O(1) | O(n) |
### | `contains` / `get_or_default` | O(1) | O(n) |
### | Iteration | O(n + removed) | O(n + removed) |
###
### :typeparam TKey: The key type. Must obey {Hashable} and {Equatable}.
### :typeparam TValue: The value type associated with each key.
### :see: {Set[T]} for the set counterpart.
entity Dict[TKey, TValue]
relates DictEmittable[TKey, TValue] as Iter, TKey as Key, TValue as Value
obeys Iterable[DictEntry[TKey, TValue]], KeyFindable, KeyContainer, Copyable, DictLiteral[TKey, TValue]
needs TKey obeys Hashable, Equatable
    ### The probe table from hashes to entry positions.
    secret index: HashIndex
    ### The keys, in insertion order. A removed entry's place is empty until the entries are packed again.
    secret keys: Memory[TKey]
    ### The values, at the same places as their keys.
    secret vals: Memory[TValue]
    ### Whether each entry place holds a live entry.
    secret live: Memory[Bool]
    ### How many live entries there are.
    secret count: U64
    ### How many entry places, from the front, have been used.
    secret used: U64
    ### The first SipHash key word.
    secret k0: U64
    ### The second SipHash key word.
    secret k1: U64

### Walks the entries of a {Dict[TKey, TValue]} in insertion order.
entity DictEmittable[TKey, TValue]
obeys Emittable[DictEntry[TKey, TValue]]
    ### The walk over which entry places are live.
    secret live: MemoryEmittable[Bool]
    ### The walk over the keys.
    secret keys: MemoryEmittable[TKey]
    ### The walk over the values.
    secret vals: MemoryEmittable[TValue]
    ### How many entry places are left to walk.
    secret left: U64

# ============================================================================
# Creators
# ============================================================================

### Creates a dict containing the given key-value `pairs`. Variadic constructor behind the `{k: v, …}`
### dict-literal syntax (the `DictLiteral` opt-in). A later duplicate key overwrites.
### :param pairs: The key-value pairs as `DictEntry[TKey, TValue]` values.
### :returns: A dict of the given pairs.
common routine Dict[TKey, TValue].from_literal(pairs...: DictEntry[TKey, TValue]) -> Dict[TKey, TValue]
needs TKey obeys Hashable, Equatable
    var result = Dict[TKey, TValue](key: SecureHashKey.random(), capacity: pairs.count().to[Integer]())
    var i: U64 = 0
    # Each pair is read in place: `add` makes the dictionary's holders, and the caller releases the
    # literal's own afterwards.
    until i >= pairs.count()
        result[pairs.get_raw(index: i).key] = pairs.get_raw(index: i).value
        i = i +% 1
    return result

### Creates an empty dictionary with a random secret key.
routine Dict[TKey, TValue]() -> Dict[TKey, TValue]
    return Dict[TKey, TValue](key: SecureHashKey.random(), capacity: 0)

### Creates an empty dictionary hashing with `key`.
### :param key: The SipHash key.
routine Dict[TKey, TValue](key: SecureHashKey) -> Dict[TKey, TValue]
    return Dict[TKey, TValue](key: key, capacity: 0)

### Creates an empty dictionary hashing with `key`, with room for `capacity` entries.
### :param key: The SipHash key.
### :param capacity: How many entries to make room for.
routine Dict[TKey, TValue](key: SecureHashKey, capacity: Integer) -> Dict[TKey, TValue]
    var room: U64 = 16
    if capacity > 16
        room = capacity.to[U64]()
    return Dict[TKey, TValue](
        index: new_hash_index(capacity: room),
        keys: Memory[TKey](room: room),
        vals: Memory[TValue](room: room),
        live: Memory[Bool](room: room),
        count: 0,
        used: 0,
        k0: key.k0,
        k1: key.k1,
    )

# ============================================================================
# Core Operations
# ============================================================================

### Returns the number of entries.
routine Dict[TKey, TValue].count() -> Integer
    return me.count.to[Integer]()

### Returns whether the dictionary has no entries.
routine Dict[TKey, TValue].is_empty() -> Bool
    return me.count == 0

### Removes every entry and keeps the room.
routine Dict[TKey, TValue].clear()
    var i: U64 = 0
    until i >= me.used
        if me.live.at(position: i)
            me.keys.erase_at(position: i)
            me.vals.erase_at(position: i)
            me.live.put(position: i, value: false)
        i = i + 1
    me.index.reset(capacity: me.keys.room())
    me.count = 0
    me.used = 0
    return

### Returns whether `key` has an entry (`d have k`).
### :param key: The key to look for.
routine Dict[TKey, TValue].has_key(key: TKey) -> Bool
    return me.index.holds(slot: me.find_slot(key: key))

### Returns whether `key` has no entry (`d lack k`).
### :param key: The key to look for.
routine Dict[TKey, TValue].lacks_key(key: TKey) -> Bool
    return not me.has_key(key: key)

### Adds `key` with `value`, or replaces the value of an existing `key`.
### :param key: The key.
### :param value: The value.
### :returns: `true` when the key was new.
secret routine Dict[TKey, TValue].put(key: TKey, value: TValue) -> Bool
    var slot = me.find_slot(key: key)
    if me.index.holds(slot: slot)
        me.vals.put(position: me.index.entry(slot: slot), value: value)
        return false
    me.add_new(key: key, value: value)
    return true

### Adds `key` with `value` only when `key` has no entry, in one step: `d[k] = v` replaces a value that is there,
### this keeps it. Another job sharing the dict cannot slip an entry in between the check and the adding, as it
### could between `if d lack k` and `d[k] = v`.
### :param key: The key.
### :param value: The value for a new key.
### :returns: `true` when the key was new and went in, `false` when it had an entry (left as it was).
routine Dict[TKey, TValue].set_if_absent(key: TKey, value: TValue) -> Bool
    if me.index.holds(slot: me.find_slot(key: key))
        return false
    me.add_new(key: key, value: value)
    return true

### Adds `key`, which has no entry, with `value`.
secret routine Dict[TKey, TValue].add_new(key: TKey, value: TValue)
    me.make_room()
    var at = me.used
    me.keys.put(position: at, value: key)
    me.vals.put(position: at, value: value)
    me.live.put(position: at, value: true)
    me.used = at + 1
    me.index.place(hash: key.hash(k0: me.k0, k1: me.k1), entry: at)
    me.count = me.count + 1
    return

### Removes the entry of `key`.
### :param key: The key to remove.
### :returns: `true` when there was an entry.
@discardable
routine Dict[TKey, TValue].remove(key: TKey) -> Bool
    var slot = me.find_slot(key: key)
    if not me.index.holds(slot: slot)
        return false
    var at = me.index.entry(slot: slot)
    me.index.retire(slot: slot)
    me.keys.erase_at(position: at)
    me.vals.erase_at(position: at)
    me.live.put(position: at, value: false)
    me.count = me.count - 1
    return true

### Returns the value of `key`, or `default_value` when there is none.
### :param key: The key to look up.
### :param default_value: The value to return for a missing key.
routine Dict[TKey, TValue].get_or_default(key: TKey, default_value: TValue) -> TValue
    var slot = me.find_slot(key: key)
    if not me.index.holds(slot: slot)
        return default_value
    return me.vals.at(position: me.index.entry(slot: slot))

# ============================================================================
# Indexing
# ============================================================================

### Returns the value of `key` (`d[k]`).
### :param key: The key to look up.
### :throws: {AbsentValueError} The key has no entry.
failable routine Dict[TKey, TValue].getitem(key: TKey) -> TValue
    var slot = me.find_slot(key: key)
    if not me.index.holds(slot: slot)
        throw KeyNotFoundError(key: key.represent())
    return me.vals.at(position: me.index.entry(slot: slot))

### Puts `value` at `key` (`d[k] = v`): replaces the value of a key that is there, and adds the key otherwise.
### :param key: The key.
### :param value: The value.
routine Dict[TKey, TValue].setitem(key: TKey, value: TValue)
    me.put(key: key, value: value)
    return

# ============================================================================
# Keys / Values / Entries
# ============================================================================

### Returns all keys in insertion order.
routine Dict[TKey, TValue].keys() -> List[TKey]
    var result = List[TKey](capacity: me.count.to[Integer]())
    var i: U64 = 0
    until i >= me.used
        if me.live.at(position: i)
            result.add_last(value: me.keys.at(position: i))
        i = i + 1
    return result

### Returns all values in insertion order, matching `keys()`.
routine Dict[TKey, TValue].values() -> List[TValue]
    var result = List[TValue](capacity: me.count.to[Integer]())
    var i: U64 = 0
    until i >= me.used
        if me.live.at(position: i)
            result.add_last(value: me.vals.at(position: i))
        i = i + 1
    return result

### Returns a copy of the keys and values as they are now, in insertion order, as pairs:
### `each (k, v) in d.items()`. `each e in d` walks the dict itself and is faster, but crashes when another job
### adds or removes an entry during the walk. Walk `items()` instead over a dict other jobs may change: the copy
### does not change under the loop.
routine Dict[TKey, TValue].items() -> List[(TKey, TValue)]
    var result = List[Tuple[TKey, TValue]](capacity: me.count.to[Integer]())
    var i: U64 = 0
    until i >= me.used
        if me.live.at(position: i)
            result.add_last(value: (me.keys.at(position: i), me.vals.at(position: i)))
        i = i + 1
    return result

# ============================================================================
# Iteration
# ============================================================================

### Returns a walk over the entries in insertion order.
routine Dict[TKey, TValue].iter() -> DictEmittable[TKey, TValue]
    return DictEmittable[TKey, TValue](
        live: me.live.walking(first: 0, count: me.used),
        keys: me.keys.walking(first: 0, count: me.used),
        vals: me.vals.walking(first: 0, count: me.used),
        left: me.used,
    )

### Returns the next entry.
### :throws: {AbsentValueError} The walk is over.
failable routine DictEmittable[TKey, TValue].emit() -> DictEntry[TKey, TValue]
    until me.left == 0
        me.left = me.left - 1
        if me.live.emit()
            return DictEntry[TKey, TValue](key: me.keys.emit(), value: me.vals.emit())
        me.keys.skip()
        me.vals.skip()
    throw AbsentValueError()

# ============================================================================
# Copy
# ============================================================================

### Returns an independent copy of this dictionary: its own entries, each key and value copied (a record is
### copied, an entity is shared).
routine Dict[TKey, TValue].duplicate() -> Dict[TKey, TValue]
    var result = Dict[TKey, TValue](key: SecureHashKey.random(), capacity: me.count.to[Integer]())
    each entry in me
        result[entry.key] = entry.value
    return result

# ============================================================================
# Display
# ============================================================================

@override
routine Dict[TKey, TValue].represent() -> Text
    if me.is_empty()
        return "{:}"
    return f"{{{me.entries_text()}}}"

@override
routine Dict[TKey, TValue].diagnose() -> Text
    return f"{me.full_type_name()}(count: {me.count}, {{{me.entries_text()}}})"

# ============================================================================
# Comparison
# ============================================================================

### Returns whether both dictionaries have the same keys with equal values.
### :param you: The other dictionary.
routine Dict[TKey, TValue].eq(you: Dict[TKey, TValue]) -> Bool
needs TValue obeys Equatable
    if me.count != you.count
        return false
    each entry in me
        var slot = you.find_slot(key: entry.key)
        if not you.index.holds(slot: slot)
            return false
        if you.vals.at(position: you.index.entry(slot: slot)) != entry.value
            return false
    return true

### Serializes this dictionary to a `SerialValue.Dict`; keys render via `represent`, values serialize.
@override
routine Dict[TKey, TValue].serialize() -> SerialValue
    var result = RF::System.Dict[Text, SerialValue]()
    each entry in me
        result[entry.key.represent()] = entry.value.serialize()
    return SerialValue(result.duplicate())

### Builds the dictionary from its serialized entry table.
### :throws: {SerialShapeError} when the value is not a table or an entry does not fit, or a parse error when a key
### does not read as a `TKey`.
failable common routine Dict[TKey, TValue].from_serial(value: SerialValue) -> Dict[TKey, TValue]
    var result = Dict[TKey, TValue]()
    when value
        is RF::System.Dict[Text, SerialValue] as entries =>
            each entry in entries
                result[serial_key[TKey](key: entry.key)] = serial_decode[TValue](value: entry.value)
        else =>
            throw SerialShapeError(detail: "expected an entry table")
    return result

# ============================================================================
# Inside the dictionary
# ============================================================================

### The probe slot whose entry has `key`, or the never-used slot the probe stopped at when there is none (see
### `HashIndex.holds`).
secret routine Dict[TKey, TValue].find_slot(key: TKey) -> U64
    var hash = key.hash(k0: me.k0, k1: me.k1)
    var tag = me.index.tag_of(hash: hash)
    var slot = me.index.home(hash: hash)
    loop
        var found = me.index.tag(slot: slot)
        if found == 0
            return slot
        if found == tag and me.keys.at(position: me.index.entry(slot: slot)) == key
            return slot
        slot = me.index.next(slot: slot)

### Packs the entries and rebuilds the probe table when there is no room for one more entry.
secret routine Dict[TKey, TValue].make_room()
    if me.used < me.keys.room() and not me.index.crowded(count: me.count)
        return
    # Pack the live entries to the front, oldest first.
    var packed: U64 = 0
    var i: U64 = 0
    until i >= me.used
        if me.live.at(position: i)
            if i != packed
                me.keys.carry(source: i, target: packed, count: 1)
                me.vals.carry(source: i, target: packed, count: 1)
                me.live.put(position: packed, value: true)
                me.live.put(position: i, value: false)
            packed = packed + 1
        i = i + 1
    me.used = packed
    var room = me.keys.room()
    if me.count * 2 >= room
        me.keys.grow_to(room: room * 2)
        me.vals.grow_to(room: room * 2)
        me.live.grow_to(room: room * 2)
    me.index.reset(capacity: me.keys.room())
    i = 0
    until i >= me.count
        me.index.place(hash: me.keys.at(position: i).hash(k0: me.k0, k1: me.k1), entry: i)
        i = i + 1
    return

### The entries as text: `"a": 1, "b": 2`.
secret routine Dict[TKey, TValue].entries_text() -> Text
    var result = ""
    var first = true
    each entry in me
        if not first
            result = f"{result}, "
        result = f"{result}{nested_repr(entry.key)}: {nested_repr(entry.value)}"
        first = false
    return result
