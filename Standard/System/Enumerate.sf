module System

### The values of an emittable, each paired with its position: `each (i, x) in xs.enumerate()`.
### :typeparam T: The value type.
### :typeparam TSource: The emittable.
entity EnumerateEmittable[T, TSource]
relates EnumerateEmitter[T, TSource/Emitter] as Emitter
obeys Emittable[Tuple[Integer, T]]
needs TSource obeys Emittable[T]
    ### The emittable (borrowed, not owned).
    secret source: Hijacked[TSource]
    ### The position of the first value.
    secret start_index: Integer

### Walks an `EnumerateEmittable`.
### :typeparam T: The value type.
### :typeparam TSourceEmitter: The emitter of the source.
entity EnumerateEmitter[T, TSourceEmitter]
obeys Emitter[Tuple[Integer, T]]
needs TSourceEmitter obeys Emitter[T]
    ### The emitter over the source (owned).
    secret source: TSourceEmitter
    ### The position of the next value.
    secret index: Integer

### Returns a walk over the pairs.
routine EnumerateEmittable[T, TSource].emitter() -> EnumerateEmitter[T, TSource/Emitter]
    danger
        return EnumerateEmitter[T, TSource/Emitter](
            source: me.source.as_entity().emitter(),
            index: me.start_index,
        )

### Returns the next pair.
### :throws: {AbsentValueError} The source has no more values.
failable routine EnumerateEmitter[T, TSourceEmitter].emit() -> Tuple[Integer, TSourceEmitter/Item]
    var position = me.index
    me.index = me.index + 1
    # The value goes into the pair straight from the source, so the pair is its only holder.
    return (position, me.source.emit())

### Returns the values paired with their positions, from 0.
routine Emittable[T].enumerate() -> EnumerateEmittable[T, Me]
    danger
        return EnumerateEmittable[T, Me](source: me.hijack(), start_index: 0)

### Returns the values paired with their positions, from `start`.
### :param start: The position of the first value.
routine Emittable[T].enumerate(start: Integer) -> EnumerateEmittable[T, Me]
    danger
        return EnumerateEmittable[T, Me](source: me.hijack(), start_index: start)
