module System

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Any crashable: the error a `check` caught, whatever its type. `is Crashables e` on a `Check` binds it. It holds
### the crashable itself, with its type id in front, so `crash_title`, `crash_message`, `represent` and `diagnose`
### reach that crashable's own. The carrier that caught the error owns what the crashable holds, and a `Crashables`
### read out of it is valid while the carrier holds the error.
@rf("Crashables")
record Crashables
    nothing

### The caught error's title: its type's name in sentence case, unless the crashable writes its own.
### :returns: The title.
@rf("Crashables.crash_title")
routine Crashables.crash_title() -> Text

### The caught error's message.
### :returns: The message.
@rf("Crashables.crash_message")
routine Crashables.crash_message() -> Text

### The caught error as text: its message.
### :returns: The message.
@rf("Crashables.represent")
routine Crashables.represent() -> Text

### The caught error for diagnostics: its type, message and member variables.
### :returns: The diagnostic text.
@rf("Crashables.diagnose")
routine Crashables.diagnose() -> Text

### The caught error's type id, the one a type pattern on a carrier compares.
### :returns: The type id.
@rf("Crashables.crash_type_id")
routine Crashables.crash_type_id() -> U64
