module System

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the crashable raised when a part of a date or a time of day is out of its range, such as month 13,
### February 30 or hour 25.
@rf("InvalidMomentError")
crashable InvalidMomentError
    ### Stores the name of the part that is out of range.
    part: Text
    ### Stores the value that was given for it.
    value: S64
    ### Stores the smallest value the part takes.
    lowest: S64
    ### Stores the largest value the part takes.
    highest: S64

### Returns the message naming the part, its value and its range.
### :returns: The resulting `Text` value.
@rf("InvalidMomentError.crash_message")
routine InvalidMomentError.crash_message() -> Text
