module System

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### The operating system's random source (getrandom on Linux, arc4random_buf on macOS, ProcessPrng on Windows): bits
### no one can guess, drawn anew on every call. Hash tables key their hashing with it, and `Random.from_entropy()`
### seeds a generator with it. Its routines are called on the type (`Entropy.next_u64()`).
@rf("Entropy")
record Entropy
    nothing

### 64 random bits from the operating system's random source.
### :returns: The random bits.
@rf("Entropy.next_u64")
common routine Entropy.next_u64() -> U64
