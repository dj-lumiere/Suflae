module System/Numerics

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### A 32-bit signed integer in the range −2,147,483,648 to 2,147,483,647.
###
### `S32` is the standard 32-bit integer type, used for Unicode
### code points, array indices on smaller platforms, and general arithmetic.
@rf("S32")
record S32
obeys SignedIntegral, Comparable, Copyable
    nothing

### Returns the sum and a flag indicating whether the result overflowed.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_sum, overflowed)`.
@rf("S32.add_with_overflow")
routine S32.add_with_overflow(you: S32) -> (S32, Bool)

### Returns the difference and a flag indicating whether the result overflowed.
### :param you: The value to subtract.
### :returns: A tuple of `(wrapped_difference, overflowed)`.
@rf("S32.sub_with_overflow")
routine S32.sub_with_overflow(you: S32) -> (S32, Bool)

### Returns the product and a flag indicating whether the result overflowed.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_product, overflowed)`.
@rf("S32.mul_with_overflow")
routine S32.mul_with_overflow(you: S32) -> (S32, Bool)

### Returns `me + you`, throwing on overflow.
### :param you: The right operand.
### :returns: The sum `me + you`.
### :throws: {IntegerOverflowError} if the result is outside the S32 range.
@rf("S32.add")
failable routine S32.add(you: S32) -> S32

### Returns `me - you`, throwing on overflow.
### :param you: The value to subtract.
### :returns: The difference `me - you`.
### :throws: {IntegerOverflowError} if the result is outside the S32 range.
@rf("S32.sub")
failable routine S32.sub(you: S32) -> S32

### Returns `me * you`, throwing on overflow.
### :param you: The right operand.
### :returns: The product `me * you`.
### :throws: {IntegerOverflowError} if the result is outside the S32 range.
@rf("S32.mul")
failable routine S32.mul(you: S32) -> S32

### Returns `me // you` (euclidean division), throwing on errors.
### Euclidean division: the remainder is always in `[0, |you|)`, consistent with `mod!`.
### The special case `S32_MIN // -1` would overflow and throws.
### :param you: The divisor.
### :returns: The euclidean quotient `me // you`.
### :throws: {DivisionByZeroError} if `you == 0`.
### :throws: {IntegerOverflowError} if `me == S32_MIN` and `you == -1`.
@rf("S32.floordiv")
failable routine S32.floordiv(you: S32) -> S32

### Returns `me % you` (euclidean modulo): the remainder is always in `[0, |you|)`.
### :param you: The divisor.
### :returns: The euclidean remainder — always non-negative.
### :throws: {DivisionByZeroError} if `you == 0`.
@rf("S32.mod")
failable routine S32.mod(you: S32) -> S32

### Returns `-me` (arithmetic negation), with wrapping behavior on `S32_MIN`.
### :returns: The negated value. `-S32_MIN` wraps to `S32_MIN` (−2147483648).
@rf("S32.neg")
failable routine S32.neg() -> S32

### Returns `-me` in two's complement, wrapping `S32_MIN` to itself.
### :returns: The wrapped negation.
@rf("S32.neg_wrap")
routine S32.neg_wrap() -> S32

### Returns `(-me, overflowed)`. Overflow occurs only for `S32_MIN`.
### :returns: A tuple of `(wrapped negation, overflow flag)`.
@rf("S32.neg_with_overflow")
routine S32.neg_with_overflow() -> (S32, Bool)

### Returns `-me`, clamped to `S32_MAX` when `me == S32_MIN`.
### :returns: The saturating negation.
@rf("S32.neg_clamp")
routine S32.neg_clamp() -> S32

### Returns |me| in two's complement, wrapping `|S32_MIN|` back to `S32_MIN`.
### :returns: The wrapped absolute value.
@rf("S32.abs_wrap")
routine S32.abs_wrap() -> S32

### Returns `(|me|, overflowed)`. Overflow occurs only for `S32_MIN`.
### :returns: A tuple of `(wrapped absolute value, overflow flag)`.
@rf("S32.abs_with_overflow")
routine S32.abs_with_overflow() -> (S32, Bool)

### Returns |me|, clamped to `S32_MAX` when `me == S32_MIN`.
### :returns: The saturating absolute value.
@rf("S32.abs_clamp")
routine S32.abs_clamp() -> S32

### Returns |me| as an unsigned value; `|S32_MIN|` is represented exactly.
### :returns: The absolute value as `U32`.
@rf("S32.unsigned_abs")
routine S32.unsigned_abs() -> U32

### Returns euclidean `me // you`, wrapping the `S32_MIN // -1` overflow to `S32_MIN`.
### :param you: The divisor.
### :returns: The wrapped euclidean quotient.
### :throws: {DivisionByZeroError} if `you == 0`.
@rf("S32.floordiv_wrap")
routine S32.floordiv_wrap(you: S32) -> S32

### Returns `(euclidean quotient, overflowed)`; overflow only for `S32_MIN // -1`.
### :param you: The divisor.
### :returns: A tuple of `(quotient, overflow flag)`.
### :throws: {DivisionByZeroError} if `you == 0`.
@rf("S32.floordiv_with_overflow")
routine S32.floordiv_with_overflow(you: S32) -> (S32, Bool)

### Returns euclidean `me % you`, wrapping the `S32_MIN % -1` overflow to `0`.
### :param you: The divisor.
### :returns: The wrapped euclidean remainder.
### :throws: {DivisionByZeroError} if `you == 0`.
@rf("S32.mod_wrap")
routine S32.mod_wrap(you: S32) -> S32

### Returns `(euclidean remainder, overflowed)`; overflow only for `S32_MIN % -1`.
### :param you: The divisor.
### :returns: A tuple of `(remainder, overflow flag)`.
### :throws: {DivisionByZeroError} if `you == 0`.
@rf("S32.mod_with_overflow")
routine S32.mod_with_overflow(you: S32) -> (S32, Bool)

### Returns `(me + you)` with wrapping arithmetic (mod 2³², signed).
### :param you: The right operand.
### :returns: The sum, wrapping on overflow.
@rf("S32.add_wrap")
routine S32.add_wrap(you: S32) -> S32

### Returns `(me - you)` with wrapping arithmetic (mod 2³², signed).
### :param you: The value to subtract.
### :returns: The difference, wrapping on underflow.
@rf("S32.sub_wrap")
routine S32.sub_wrap(you: S32) -> S32

### Returns `(me * you)` with wrapping arithmetic (mod 2³², signed).
### :param you: The right operand.
### :returns: The product, wrapping on overflow.
@rf("S32.mul_wrap")
routine S32.mul_wrap(you: S32) -> S32

### Returns `me + you`, clamped to `S32_MAX` or `S32_MIN` on overflow.
### :param you: The right operand.
### :returns: The sum, or `2147483647` / `−2147483648` if it would overflow.
@rf("S32.add_clamp")
routine S32.add_clamp(you: S32) -> S32

### Returns `me - you`, clamped to `S32_MAX` or `S32_MIN` on overflow.
### :param you: The value to subtract.
### :returns: The difference, or `2147483647` / `−2147483648` if it would overflow.
@rf("S32.sub_clamp")
routine S32.sub_clamp(you: S32) -> S32

### Returns `me * you`, clamped to `S32_MAX` or `S32_MIN` on overflow.
### :param you: The right operand.
### :returns: The product, or `2147483647` / `−2147483648` if it would overflow.
@rf("S32.mul_clamp")
routine S32.mul_clamp(you: S32) -> S32

### Returns `me + you + carry` as `(wrapped_sum, overflowed)`.
### Chains across words to add integers wider than `S32`: feed each word's carry
### bit up the chain. Unlike the unsigned form, the flag reports SIGNED overflow
### (the two internal overflows cancel via XOR), so it is only meaningful on the
### most-significant word of a multi-word signed value.
### :param you: The right operand.
### :param carry: The incoming carry bit from the lower word.
### :returns: A tuple of `(wrapped sum, signed-overflow flag)`.
@rf("S32.carrying_add")
routine S32.carrying_add(you: S32, carry: Bool) -> (S32, Bool)

### Returns `me - you - borrow` as `(wrapped_difference, overflowed)`.
### Chains across words to subtract integers wider than `S32`; the flag reports
### SIGNED overflow, meaningful only on the most-significant word.
### :param you: The value to subtract.
### :param borrow: The incoming borrow bit from the lower word.
### :returns: A tuple of `(wrapped difference, signed-overflow flag)`.
@rf("S32.borrowing_sub")
routine S32.borrowing_sub(you: S32, borrow: Bool) -> (S32, Bool)

### Returns `me ** exp` and a flag indicating whether the result overflowed.
### :param exp: The exponent (must be non-negative).
### :returns: A tuple of `(wrapped_result, overflowed)`.
### :throws: {NumericDomainError} if `exp < 0`.
@rf("S32.pow_with_overflow")
failable routine S32.pow_with_overflow(exp: S32) -> (S32, Bool)

### Returns `me ** exp`, throwing on overflow.
### :param exp: The exponent (must be non-negative).
### :returns: The result of raising `me` to the power `exp`.
### :throws: {IntegerOverflowError} if the result is outside the S32 range.
### :throws: {NumericDomainError} if `exp < 0`.
@rf("S32.pow")
failable routine S32.pow(exp: S32) -> S32

### Returns `me ** exp` with wrapping arithmetic.
### :param exp: The exponent (must be non-negative).
### :returns: The result modulo 2³² (signed wrap).
### :throws: {NumericDomainError} if `exp < 0`.
@rf("S32.pow_wrap")
failable routine S32.pow_wrap(exp: S32) -> S32

### Returns `me ** exp`, clamped to `S32_MAX` or `S32_MIN` on overflow.
### :param exp: The exponent (must be non-negative).
### :returns: The result, or `2147483647` / `−2147483648` if it would overflow.
### :throws: {NumericDomainError} if `exp < 0`.
@rf("S32.pow_clamp")
failable routine S32.pow_clamp(exp: S32) -> S32

### Returns the bitwise AND of this value and `you`.
### :param you: The right operand.
### :returns: `me & you`.
@rf("S32.bitand")
routine S32.bitand(you: S32) -> S32

### Returns the bitwise OR of this value and `you`.
### :param you: The right operand.
### :returns: `me | you`.
@rf("S32.bitor")
routine S32.bitor(you: S32) -> S32

### Returns the bitwise XOR of this value and `you`.
### :param you: The right operand.
### :returns: `me ^ you`.
@rf("S32.bitxor")
routine S32.bitxor(you: S32) -> S32

### Returns the bitwise complement of this value.
### :returns: `~me` — each bit flipped.
@rf("S32.bitnot")
routine S32.bitnot() -> S32

### Returns `true` when both values are equal.
### :param you: The value to compare against.
### :returns: `true` if `me == you`; `false` otherwise.
@rf("S32.eq")
routine S32.eq(you: S32) -> Bool

### Compares this value with `you`, returning the ordering relationship.
### :param you: The value to compare against.
### :returns: `ME_SMALL` if `me < you`, `ME_LARGE` if `me > you`, `SAME` if equal.
@rf("S32.compare")
routine S32.compare(you: S32) -> ComparisonSign

### Returns the absolute value of this integer.
### :returns: `-me` if `me < 0`; `me` if `me >= 0`.
### :throws: {IntegerOverflowError} when `me` is `S32_MIN` (its magnitude is not representable in S32).
@rf("S32.abs")
failable routine S32.abs() -> S32

### Returns the smaller of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me <= you`; otherwise `you`.
@rf("S32.min")
routine S32.min(you: S32) -> S32

### Returns the larger of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me >= you`; otherwise `you`.
@rf("S32.max")
routine S32.max(you: S32) -> S32

### Returns this value clamped to the range `min_val..=max_val`.
### :param min_val: The lower bound (inclusive).
### :param max_val: The upper bound (inclusive).
### :returns: `min_val` if `me < min_val`; `max_val` if `me > max_val`; otherwise `me`.
@rf("S32.clamp")
routine S32.clamp(min_val: S32, max_val: S32) -> S32

### Returns the integer square root ⌊√me⌋. Throws for a negative `me`.
### :returns: The floor of the square root of `me`.
### :throws: {NumericDomainError} if `me < 0`.
@rf("S32.isqrt")
routine S32.isqrt() -> S32

### Returns the integer square root together with its remainder: `(s, r)` with `s = ⌊√me⌋` and
### `r = me - s*s`, so `0 <= r <= 2s` (e.g. `5.sqrtrem()` is `(2, 1)`).
### :returns: The tuple `(root, remainder)`.
### :throws: {NumericDomainError} if `me < 0`.
@rf("S32.sqrtrem")
failable routine S32.sqrtrem() -> (S32, S32)

### Returns ⌊log_base me⌋. Throws if `me <= 0` or `base < 2`.
### :param base: The logarithm base (must be ≥ 2).
### :returns: The floor of the base-`base` logarithm.
### :throws: {NumericDomainError} if `me <= 0` or `base < 2`.
@rf("S32.ilog")
failable routine S32.ilog(base: S32) -> S32

### Returns the absolute difference |me - you| as an unsigned value (no overflow).
### :param you: The other value.
### :returns: The non-negative distance between `me` and `you`.
@rf("S32.abs_diff")
routine S32.abs_diff(you: S32) -> U32

### Returns this value with its bits reversed (bit 31 ↔ bit 0, etc.).
### :returns: The bit-reversed `S32`.
@rf("S32.reverse_bits")
routine S32.reverse_bits() -> S32

### Returns this value with its four bytes swapped (for endianness conversion).
### :returns: An `S32` with its bytes in reverse order.
@rf("S32.swap_bytes")
routine S32.swap_bytes() -> S32

### Returns the raw byte representation of this value in little-endian order.
@rf("S32.to_bytes_le")
routine S32.to_bytes_le() -> Items[Byte, 4]

### Returns the raw byte representation of this value in big-endian order.
@rf("S32.to_bytes_be")
routine S32.to_bytes_be() -> Items[Byte, 4]

### Builds an `S32` from its little-endian raw byte representation.
@rf("S32.from_bytes_le")
common routine S32.from_bytes_le(bytes: Items[Byte, 4]) -> S32

### Builds an `S32` from its big-endian raw byte representation.
@rf("S32.from_bytes_be")
common routine S32.from_bytes_be(bytes: Items[Byte, 4]) -> S32

### Returns `true` if this value is greater than zero.
### :returns: `true` if `me > 0`.
@rf("S32.is_positive")
routine S32.is_positive() -> Bool

### Returns `true` if this value is less than zero.
### :returns: `true` if `me < 0`.
@rf("S32.is_negative")
routine S32.is_negative() -> Bool

### Returns `true` if this value is zero.
### :returns: `true` if `me == 0`.
@rf("S32.is_zero")
routine S32.is_zero() -> Bool

### Returns `true` if this value is divisible by 2.
### :returns: `true` if the least-significant bit is 0.
@rf("S32.is_even")
routine S32.is_even() -> Bool

### Returns `true` if this value is not divisible by 2.
### :returns: `true` if the least-significant bit is 1.
@rf("S32.is_odd")
routine S32.is_odd() -> Bool

### Returns `true` if this value is an exact power of two.
### Negative values always return `false`.
### :returns: `true` if `me` is 1, 2, 4, ..., 1073741824; `false` otherwise (including zero and negatives).
@rf("S32.is_power_of_two")
routine S32.is_power_of_two() -> Bool

### Returns the human-readable text of this value.
### :returns: The value rendered as `Text`.
@rf("S32.represent")
routine S32.represent() -> Text

### Returns a type-tagged debug rendering of this value.
### :returns: A diagnostic `Text` rendering, e.g. `Type(value)`.
@rf("S32.diagnose")
routine S32.diagnose() -> Text

### Returns a SipHash-2-4 keyed hash of this value.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash suitable for denial-of-service-resistant hash tables.
@rf("S32.hash")
routine S32.hash(k0: U64, k1: U64) -> U64

### Sign-extends an `S8` to `S32`.
### :returns: An `S32` with the same signed value as this value.
@rf("S8.to")
routine S8.to[S32]() -> S32

### Sign-extends an `S16` to `S32`.
### :returns: An `S32` with the same signed value as this value.
@rf("S16.to")
routine S16.to[S32]() -> S32

### Identity conversion — returns this value unchanged.
### :returns: this value unchanged.
@rf("S32.to")
routine S32.to[S32]() -> S32

### Converts an `S64` to `S32`, throwing if the value is outside the S32 range.
### :returns: The lower 32 bits of this value interpreted as signed.
### :throws: {IntegerOverflowError} if this value is not in `-2147483648..=2147483647`.
@rf("S64.to")
failable routine S64.to[S32]() -> S32

### Converts an `S128` to `S32`, throwing if the value is outside the S32 range.
### :returns: The lower 32 bits of this value interpreted as signed.
### :throws: {IntegerOverflowError} if this value is not in `-2147483648..=2147483647`.
@rf("S128.to")
failable routine S128.to[S32]() -> S32

### Zero-extends a `U8` to `S32` (always succeeds — `U8` max 255 fits in S32).
### :returns: An `S32` equal in value to this value.
@rf("U8.to")
routine U8.to[S32]() -> S32

### Zero-extends a `U16` to `S32` (always succeeds — `U16` max 65535 fits in S32).
### :returns: An `S32` equal in value to this value.
@rf("U16.to")
routine U16.to[S32]() -> S32

### Reinterprets a `U32` as `S32` using two's complement, throwing if the value exceeds S32_MAX.
### :returns: The same bit pattern interpreted as `S32`.
### :throws: {IntegerOverflowError} if `me > 2147483647`.
@rf("U32.to")
failable routine U32.to[S32]() -> S32

### Converts a `U64` to `S32`, throwing if the value exceeds S32_MAX.
### :returns: The lower 32 bits interpreted as a signed `S32`.
### :throws: {IntegerOverflowError} if `me > 2147483647`.
@rf("U64.to")
failable routine U64.to[S32]() -> S32

### Converts a `U128` to `S32`, throwing if the value exceeds S32_MAX.
### :returns: The lower 32 bits interpreted as a signed `S32`.
### :throws: {IntegerOverflowError} if `me > 2147483647`.
@rf("U128.to")
failable routine U128.to[S32]() -> S32

### Converts an `S256` to `S32`, throwing if outside −2147483648..2147483647.
### :returns: The lower 32 bits reinterpreted as an `S32`.
### :throws: {IntegerOverflowError} if this value is outside −2147483648..2147483647.
@rf("S256.to")
failable routine S256.to[S32]() -> S32

### Converts a `U256` to `S32`, throwing if the value exceeds 2147483647.
### :returns: The lower 32 bits reinterpreted as an `S32`.
### :throws: {IntegerOverflowError} if `me > 2147483647`.
@rf("U256.to")
failable routine U256.to[S32]() -> S32

### Converts an `B16` to `S32` by widening to `B32` first, then truncating toward zero.
### :returns: The integer part of this value as an `S32`.
### :throws: {IntegerOverflowError} if the integer part is outside the S32 range.
@rf("B16.to")
failable routine B16.to[S32]() -> S32

### Converts an `B32` to `S32`, truncating toward zero.
### :returns: The integer part of this value as an `S32`.
### :throws: {IntegerOverflowError} if the value is outside the S32 range.
@rf("B32.to")
failable routine B32.to[S32]() -> S32

### Converts an `B64` to `S32`, truncating toward zero.
### :returns: The integer part of this value as an `S32`.
### :throws: {IntegerOverflowError} if the value is outside the S32 range.
@rf("B64.to")
failable routine B64.to[S32]() -> S32

### Converts an `B128` to `S32` by narrowing to `B64` first, then truncating.
### :returns: The integer part of this value as an `S32`.
### :throws: {IntegerOverflowError} if the integer part is outside the S32 range.
@rf("B128.to")
failable routine B128.to[S32]() -> S32

### Converts a `D32` decimal to `S32` via its packed bit representation.
### :returns: The integer part of this value as an `S32`.
### :throws: {IntegerOverflowError} if the integer part is outside the S32 range.
@rf("D32.to")
failable routine D32.to[S32]() -> S32

### Converts a `D64` decimal to `S32` via its packed bit representation.
### :returns: The integer part of this value as an `S32`.
### :throws: {IntegerOverflowError} if the integer part is outside the S32 range.
@rf("D64.to")
failable routine D64.to[S32]() -> S32

### Converts a `D128` decimal to `S32` via its low/high 64-bit halves.
### :returns: The integer part of this value as an `S32`.
### :throws: {IntegerOverflowError} if the integer part is outside the S32 range.
@rf("D128.to")
failable routine D128.to[S32]() -> S32

### Parses a decimal string into an `S32`, accepting an optional leading `+` or `−` sign.
### :returns: The parsed `S32` value.
### :throws: {InvalidValueError} if this value is empty, sign-only, or contains non-digit characters.
### :throws: {IntegerOverflowError} if the value does not fit in `S32`.
@rf("Text.to")
failable routine Text.to[S32]() -> S32
