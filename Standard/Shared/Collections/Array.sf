module Core

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### A fixed-size, inline array of `COUNT` elements with value semantics.
###
### `Array[T, COUNT]` stores exactly `COUNT` elements packed directly into its own
### footprint: it makes no separate allocation for its slots, and it lives wherever
### what holds it lives (a local, a member variable of an entity, another array). An
### element can still own memory of its own (a `Text`'s characters, an entity's
### object). Because it is a record type, copying an `Array` copies all `COUNT`
### elements, each the way its own type copies, and the size can never change
### after construction.
###
### Use this type when the number of elements is known at build time and you
### want the elements laid out inline, without the indirection of a separate buffer.
###
### **When to use**
### - The element count is a buildtime constant.
### - You want value semantics (copy = full duplication of contents).
### - You need a small fixed-size buffer (e.g., a 4×4 matrix, an RGBA colour, a SIMD lane).
### - Use {List[T]} when the count is only known at runtime or elements are added dynamically.
### - Use {BitArray[COUNT]} for a compact fixed-size sequence of boolean flags.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `getitem!` / `setitem!` | O(1) |
### | `first!` / `last!` | O(1) |
### | `contains` | O(N) |
### | `index_of!` | O(N) |
### | Iteration | O(N) |
###
### :typeparam T: The element type stored in the array.
### :typeparam COUNT: The buildtime element count, supplied as a `U64` literal.
### :see: {List[T]} for a heap-backed growable sequence.
### :see: {BitArray[COUNT]} for a compact fixed-size bit sequence.
@rf("Array")
record Array[T, COUNT]
relates ArrayEmittable[T, COUNT] as Iter
obeys Comparable, Iterable[T], MutableIndexable[T], Sized, Container
needs U64 COUNT
    pass

### Walks the elements of a fixed-size `Array[T, COUNT]` from index 0 to N - 1.
### Because `Array` is a record type, the iterator holds its own copy of the array data.
### :typeparam T: The element type yielded by the iterator.
### :typeparam COUNT: The buildtime element count.
@rf("ArrayEmittable")
entity ArrayEmittable[T, COUNT]
obeys Emittable[T]
needs U64 COUNT
    pass

### Returns the element at `index` as the array holds it, without bounds checking and without a holder of
### its own. Only call this when the index is already proven to be in range.
@rf("Array.get_raw")
routine Array[T, COUNT].get_raw(index: U64) -> T

### Returns true when the buildtime size is zero.
### :returns: `true` if `COUNT == 0`.
@rf("Array.is_empty")
routine Array[T, COUNT].is_empty() -> Bool

### Returns the first element of the array.
### :returns: The element at index `0`.
### :absent: The array has zero elements (`COUNT == 0`).
@rf("Array.first")
routine Array[T, COUNT].first!() -> T

### Returns the last element of the array.
### :returns: The element at index `COUNT - 1`.
### :absent: The array has zero elements (`COUNT == 0`).
@rf("Array.last")
routine Array[T, COUNT].last!() -> T

### Returns true if any element equals `value`.
### Scans from index 0 to N - 1 using the element type's equality operator.
### :param value: The value to search for.
### :returns: `true` if `value` is found; `false` otherwise.
@rf("Array.contains")
routine Array[T, COUNT].contains(value: T) -> Bool
needs T obeys Equatable

### Returns an iterator over the elements in ascending index order. It reads each element where the array holds it,
### so the array must stay where it is while the loop runs (the builder keeps it from being reshaped, RF-S625).
@rf("Array.iter")
routine Array[T, COUNT].iter() -> ArrayEmittable[T, COUNT]

### Returns the next element from the iterator in ascending index order, read in place: for an entity element it is
### the array's own element, which the loop only reads (as `List`'s iterator does).
### :returns: The element at the current index.
### :absent: All `COUNT` elements have been yielded.
@rf("ArrayEmittable.emit")
routine ArrayEmittable[T, COUNT].emit!() -> T

@rf("Array.represent")
routine Array[T, COUNT].represent() -> Text

@rf("Array.diagnose")
routine Array[T, COUNT].diagnose() -> Text

### Returns true when both arrays contain equal elements in the same order.
### :param you: The other array to compare against.
### :returns: `true` if every corresponding pair of elements is equal.
### :note: Requires `T` to obey `Equatable`. Arrays of non-equatable element types
###        (e.g. a `U` that is not equatable) do not get an `eq`
###        operator — `==` on such arrays is a build error.
@rf("Array.eq")
routine Array[T, COUNT].eq(you: Array[T, COUNT]) -> Bool
needs T obeys Equatable

### Lexicographic comparison of two arrays of equal length.
### Compares element by element from index 0 using `T.cmp`; returns at the
### first non-equal pair, or `SAME` when every pair is equal.
### :param you: The other array to compare against.
### :returns: `ME_SMALL`, `SAME`, or `ME_LARGE`.
### :note: Requires `T` to obey `Comparable`.
@rf("Array.cmp")
routine Array[T, COUNT].cmp(you: Array[T, COUNT]) -> ComparisonSign
needs T obeys Comparable
