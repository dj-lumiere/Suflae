module Collections

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Creates an empty circular list with no allocated storage.
### The backing buffer is acquired lazily on first insertion.
@rf("CircularList")
routine CircularList[T]() -> CircularList[T]

### Creates an empty circular list with storage pre-allocated for at least `capacity` elements.
### The requested capacity is rounded up to the next power of two so index wrapping
### can use a bitmask.
### :param capacity: The minimum number of elements to reserve space for.
@rf("CircularList")
routine CircularList[T](capacity: U64) -> CircularList[T]
