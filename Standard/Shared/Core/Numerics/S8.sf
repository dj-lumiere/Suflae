module Core

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### An 8-bit signed integer in the range −128 to 127.
###
### `S8` is the smallest signed integer type, used for compact
### signed data such as audio samples (where the range fits) and C interop.
@rf("S8")
record S8
obeys SignedIntegral, Comparable, Copyable
    pass

### Returns the sum and a flag indicating whether the result overflowed.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_sum, overflowed)`.
@rf("S8.add_with_overflow")
routine S8.add_with_overflow(you: S8) -> (S8, Bool)

### Returns the difference and a flag indicating whether the result overflowed.
### :param you: The value to subtract.
### :returns: A tuple of `(wrapped_difference, overflowed)`.
@rf("S8.sub_with_overflow")
routine S8.sub_with_overflow(you: S8) -> (S8, Bool)

### Returns the product and a flag indicating whether the result overflowed.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_product, overflowed)`.
@rf("S8.mul_with_overflow")
routine S8.mul_with_overflow(you: S8) -> (S8, Bool)

### Returns `me + you`, throwing on overflow.
### :param you: The right operand.
### :returns: The sum `me + you`.
### :throws: {IntegerOverflowError} if the result is outside −128..127.
@rf("S8.add")
failable routine S8.add(you: S8) -> S8

### Returns `me - you`, throwing on overflow.
### :param you: The value to subtract.
### :returns: The difference `me - you`.
### :throws: {IntegerOverflowError} if the result is outside −128..127.
@rf("S8.sub")
failable routine S8.sub(you: S8) -> S8

### Returns `me * you`, throwing on overflow.
### :param you: The right operand.
### :returns: The product `me * you`.
### :throws: {IntegerOverflowError} if the result is outside −128..127.
@rf("S8.mul")
failable routine S8.mul(you: S8) -> S8

### Returns `me // you` (euclidean division), throwing on errors.
### Euclidean division: the remainder is always in `[0, |you|)`, consistent with `mod!`.
### The special case `S8_MIN // -1` would overflow (result would be 128) and throws.
### :param you: The divisor.
### :returns: The euclidean quotient `me // you`.
### :throws: {DivisionByZeroError} if `you == 0`.
### :throws: {IntegerOverflowError} if `me == S8_MIN` and `you == -1`.
@rf("S8.floordiv")
failable routine S8.floordiv(you: S8) -> S8

### Returns `me % you` (euclidean modulo): the remainder is always in `[0, |you|)`.
### :param you: The divisor.
### :returns: The euclidean remainder — always non-negative.
### :throws: {DivisionByZeroError} if `you == 0`.
@rf("S8.mod")
failable routine S8.mod(you: S8) -> S8

### Returns `-me` (arithmetic negation), with wrapping behavior on `S8_MIN`.
### :returns: The negated value. `-S8_MIN` wraps to `S8_MIN` (−128).
@rf("S8.neg")
failable routine S8.neg() -> S8

### Returns `-me` in two's complement, wrapping `S8_MIN` to itself.
### :returns: The wrapped negation.
@rf("S8.neg_wrap")
routine S8.neg_wrap() -> S8

### Returns `(-me, overflowed)`. Overflow occurs only for `S8_MIN`.
### :returns: A tuple of `(wrapped negation, overflow flag)`.
@rf("S8.neg_with_overflow")
routine S8.neg_with_overflow() -> (S8, Bool)

### Returns `-me`, clamped to `S8_MAX` when `me == S8_MIN`.
### :returns: The saturating negation.
@rf("S8.neg_clamp")
routine S8.neg_clamp() -> S8

### Returns |me| in two's complement, wrapping `|S8_MIN|` back to `S8_MIN`.
### :returns: The wrapped absolute value.
@rf("S8.abs_wrap")
routine S8.abs_wrap() -> S8

### Returns `(|me|, overflowed)`. Overflow occurs only for `S8_MIN`.
### :returns: A tuple of `(wrapped absolute value, overflow flag)`.
@rf("S8.abs_with_overflow")
routine S8.abs_with_overflow() -> (S8, Bool)

### Returns |me|, clamped to `S8_MAX` when `me == S8_MIN`.
### :returns: The saturating absolute value.
@rf("S8.abs_clamp")
routine S8.abs_clamp() -> S8

### Returns |me| as an unsigned value; `|S8_MIN|` is represented exactly.
### :returns: The absolute value as `U8`.
@rf("S8.unsigned_abs")
routine S8.unsigned_abs() -> U8

### Returns euclidean `me // you`, wrapping the `S8_MIN // -1` overflow to `S8_MIN`.
### :param you: The divisor.
### :returns: The wrapped euclidean quotient.
### :throws: {DivisionByZeroError} if `you == 0`.
@rf("S8.floordiv_wrap")
routine S8.floordiv_wrap(you: S8) -> S8

### Returns `(euclidean quotient, overflowed)`; overflow only for `S8_MIN // -1`.
### :param you: The divisor.
### :returns: A tuple of `(quotient, overflow flag)`.
### :throws: {DivisionByZeroError} if `you == 0`.
@rf("S8.floordiv_with_overflow")
routine S8.floordiv_with_overflow(you: S8) -> (S8, Bool)

### Returns euclidean `me % you`, wrapping the `S8_MIN % -1` overflow to `0`.
### :param you: The divisor.
### :returns: The wrapped euclidean remainder.
### :throws: {DivisionByZeroError} if `you == 0`.
@rf("S8.mod_wrap")
routine S8.mod_wrap(you: S8) -> S8

### Returns `(euclidean remainder, overflowed)`; overflow only for `S8_MIN % -1`.
### :param you: The divisor.
### :returns: A tuple of `(remainder, overflow flag)`.
### :throws: {DivisionByZeroError} if `you == 0`.
@rf("S8.mod_with_overflow")
routine S8.mod_with_overflow(you: S8) -> (S8, Bool)

### Returns `(me + you)` with wrapping arithmetic (mod 256, signed).
### :param you: The right operand.
### :returns: The sum, wrapping on overflow.
@rf("S8.add_wrap")
routine S8.add_wrap(you: S8) -> S8

### Returns `(me - you)` with wrapping arithmetic (mod 256, signed).
### :param you: The value to subtract.
### :returns: The difference, wrapping on underflow.
@rf("S8.sub_wrap")
routine S8.sub_wrap(you: S8) -> S8

### Returns `(me * you)` with wrapping arithmetic (mod 256, signed).
### :param you: The right operand.
### :returns: The product, wrapping on overflow.
@rf("S8.mul_wrap")
routine S8.mul_wrap(you: S8) -> S8

### Returns `me + you`, clamped to `S8_MAX` or `S8_MIN` on overflow.
### :param you: The right operand.
### :returns: The sum, or `127` / `−128` if it would overflow.
@rf("S8.add_clamp")
routine S8.add_clamp(you: S8) -> S8

### Returns `me - you`, clamped to `S8_MAX` or `S8_MIN` on overflow.
### :param you: The value to subtract.
### :returns: The difference, or `127` / `−128` if it would overflow.
@rf("S8.sub_clamp")
routine S8.sub_clamp(you: S8) -> S8

### Returns `me * you`, clamped to `S8_MAX` or `S8_MIN` on overflow.
### :param you: The right operand.
### :returns: The product, or `127` / `−128` if it would overflow.
@rf("S8.mul_clamp")
routine S8.mul_clamp(you: S8) -> S8

### Returns `me + you + carry` as `(wrapped_sum, overflowed)`.
### Chains across words to add integers wider than `S8`: feed each word's carry
### bit up the chain. Unlike the unsigned form, the flag reports SIGNED overflow
### (the two internal overflows cancel via XOR), so it is only meaningful on the
### most-significant word of a multi-word signed value.
### :param you: The right operand.
### :param carry: The incoming carry bit from the lower word.
### :returns: A tuple of `(wrapped sum, signed-overflow flag)`.
@rf("S8.carrying_add")
routine S8.carrying_add(you: S8, carry: Bool) -> (S8, Bool)

### Returns `me - you - borrow` as `(wrapped_difference, overflowed)`.
### Chains across words to subtract integers wider than `S8`; the flag reports
### SIGNED overflow, meaningful only on the most-significant word.
### :param you: The value to subtract.
### :param borrow: The incoming borrow bit from the lower word.
### :returns: A tuple of `(wrapped difference, signed-overflow flag)`.
@rf("S8.borrowing_sub")
routine S8.borrowing_sub(you: S8, borrow: Bool) -> (S8, Bool)

### Returns `me ** exp` and a flag indicating whether the result overflowed.
### :param exp: The exponent (must be non-negative).
### :returns: A tuple of `(wrapped_result, overflowed)`.
### :throws: {NumericDomainError} if `exp < 0`.
@rf("S8.pow_with_overflow")
failable routine S8.pow_with_overflow(exp: S8) -> (S8, Bool)

### Returns `me ** exp`, throwing on overflow.
### :param exp: The exponent (must be non-negative).
### :returns: The result of raising `me` to the power `exp`.
### :throws: {IntegerOverflowError} if the result is outside −128..127.
### :throws: {NumericDomainError} if `exp < 0`.
@rf("S8.pow")
failable routine S8.pow(exp: S8) -> S8

### Returns `me ** exp` with wrapping arithmetic.
### :param exp: The exponent (must be non-negative).
### :returns: The result modulo 256 (signed wrap).
### :throws: {NumericDomainError} if `exp < 0`.
@rf("S8.pow_wrap")
failable routine S8.pow_wrap(exp: S8) -> S8

### Returns `me ** exp`, clamped to `S8_MAX` or `S8_MIN` on overflow.
### :param exp: The exponent (must be non-negative).
### :returns: The result, or `127` / `−128` if it would overflow.
### :throws: {NumericDomainError} if `exp < 0`.
@rf("S8.pow_clamp")
failable routine S8.pow_clamp(exp: S8) -> S8

### Returns the bitwise AND of this value and `you`.
### :param you: The right operand.
### :returns: `me & you`.
@rf("S8.bitand")
routine S8.bitand(you: S8) -> S8

### Returns the bitwise OR of this value and `you`.
### :param you: The right operand.
### :returns: `me | you`.
@rf("S8.bitor")
routine S8.bitor(you: S8) -> S8

### Returns the bitwise XOR of this value and `you`.
### :param you: The right operand.
### :returns: `me ^ you`.
@rf("S8.bitxor")
routine S8.bitxor(you: S8) -> S8

### Returns the bitwise complement of this value.
### :returns: `~me` — each bit flipped.
@rf("S8.bitnot")
routine S8.bitnot() -> S8

### Returns `true` when both values are equal.
### :param you: The value to compare against.
### :returns: `true` if `me == you`; `false` otherwise.
@rf("S8.eq")
routine S8.eq(you: S8) -> Bool

### Compares this value with `you`, returning the ordering relationship.
### :param you: The value to compare against.
### :returns: `ME_SMALL` if `me < you`, `ME_LARGE` if `me > you`, `SAME` if equal.
@rf("S8.compare")
routine S8.compare(you: S8) -> ComparisonSign

### Returns the absolute value of this integer.
### :returns: `-me` if `me < 0`; `me` if `me >= 0`.
### :throws: {IntegerOverflowError} when `me` is `S8_MIN` (its magnitude is not representable in S8).
@rf("S8.abs")
failable routine S8.abs() -> S8

### Returns the smaller of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me <= you`; otherwise `you`.
@rf("S8.min")
routine S8.min(you: S8) -> S8

### Returns the larger of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me >= you`; otherwise `you`.
@rf("S8.max")
routine S8.max(you: S8) -> S8

### Returns this value clamped to the range `min_val..=max_val`.
### :param min_val: The lower bound (inclusive).
### :param max_val: The upper bound (inclusive).
### :returns: `min_val` if `me < min_val`; `max_val` if `me > max_val`; otherwise `me`.
@rf("S8.clamp")
routine S8.clamp(min_val: S8, max_val: S8) -> S8

### Returns the integer square root ⌊√me⌋. Throws for a negative `me`.
### :returns: The floor of the square root of `me`.
### :throws: {NumericDomainError} if `me < 0`.
@rf("S8.isqrt")
routine S8.isqrt() -> S8

### Returns the integer square root together with its remainder: `(s, r)` with `s = ⌊√me⌋` and
### `r = me - s*s`, so `0 <= r <= 2s` (e.g. `5.sqrtrem()` is `(2, 1)`).
### :returns: The tuple `(root, remainder)`.
### :throws: {NumericDomainError} if `me < 0`.
@rf("S8.sqrtrem")
failable routine S8.sqrtrem() -> (S8, S8)

### Returns ⌊log_base me⌋. Throws if `me <= 0` or `base < 2`.
### :param base: The logarithm base (must be ≥ 2).
### :returns: The floor of the base-`base` logarithm.
### :throws: {NumericDomainError} if `me <= 0` or `base < 2`.
@rf("S8.ilog")
failable routine S8.ilog(base: S8) -> S8

### Returns the absolute difference |me - you| as an unsigned value (no overflow).
### :param you: The other value.
### :returns: The non-negative distance between `me` and `you`.
@rf("S8.abs_diff")
routine S8.abs_diff(you: S8) -> U8

### Returns this value with its bits reversed (bit 7 ↔ bit 0, etc.).
### :returns: The bit-reversed `S8`.
@rf("S8.reverse_bits")
routine S8.reverse_bits() -> S8

### Returns this value with its single byte unchanged (8-bit byte swap is identity).
### Provided for API uniformity with the wider integer types.
### :returns: `me`.
@rf("S8.swap_bytes")
routine S8.swap_bytes() -> S8

### Returns the raw byte representation of this value in little-endian order.
@rf("S8.to_bytes_le")
routine S8.to_bytes_le() -> Array[Byte, 1]

### Returns the raw byte representation of this value in big-endian order.
@rf("S8.to_bytes_be")
routine S8.to_bytes_be() -> Array[Byte, 1]

### Builds an `S8` from its little-endian raw byte representation.
@rf("S8.from_bytes_le")
common routine S8.from_bytes_le(bytes: Array[Byte, 1]) -> S8

### Builds an `S8` from its big-endian raw byte representation.
@rf("S8.from_bytes_be")
common routine S8.from_bytes_be(bytes: Array[Byte, 1]) -> S8

### Returns `true` if this value is greater than zero.
### :returns: `true` if `me > 0`.
@rf("S8.is_positive")
routine S8.is_positive() -> Bool

### Returns `true` if this value is less than zero.
### :returns: `true` if `me < 0`.
@rf("S8.is_negative")
routine S8.is_negative() -> Bool

### Returns `true` if this value is zero.
### :returns: `true` if `me == 0`.
@rf("S8.is_zero")
routine S8.is_zero() -> Bool

### Returns `true` if this value is divisible by 2.
### :returns: `true` if the least-significant bit is 0.
@rf("S8.is_even")
routine S8.is_even() -> Bool

### Returns `true` if this value is not divisible by 2.
### :returns: `true` if the least-significant bit is 1.
@rf("S8.is_odd")
routine S8.is_odd() -> Bool

### Returns true if this value is an exact power of two.
### Negative values always return `false`.
### :returns: `true` if `me > 0 and (me & (me - 1)) == 0`.
@rf("S8.is_power_of_two")
routine S8.is_power_of_two() -> Bool

### Returns the human-readable text of this value.
### :returns: The value rendered as `Text`.
@rf("S8.represent")
routine S8.represent() -> Text

### Returns a type-tagged debug rendering of this value.
### :returns: A diagnostic `Text` rendering, e.g. `Type(value)`.
@rf("S8.diagnose")
routine S8.diagnose() -> Text

### Returns a SipHash-2-4 keyed hash of this value.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash suitable for denial-of-service-resistant hash tables.
@rf("S8.hash")
routine S8.hash(k0: U64, k1: U64) -> U64

### Identity conversion — returns this value unchanged.
### :returns: this value unchanged.
@rf("S8.to")
routine S8.to[S8]() -> S8

### Converts an `S16` to `S8`, throwing if the value is outside −128..127.
### :returns: The lower 8 bits of this value interpreted as signed.
### :throws: {IntegerOverflowError} if this value is not in `-128..=127`.
@rf("S16.to")
failable routine S16.to[S8]() -> S8

### Converts an `S32` to `S8`, throwing if the value is outside −128..127.
### :returns: The lower 8 bits of this value interpreted as signed.
### :throws: {IntegerOverflowError} if this value is not in `-128..=127`.
@rf("S32.to")
failable routine S32.to[S8]() -> S8

### Converts an `S64` to `S8`, throwing if the value is outside −128..127.
### :returns: The lower 8 bits of this value interpreted as signed.
### :throws: {IntegerOverflowError} if this value is not in `-128..=127`.
@rf("S64.to")
failable routine S64.to[S8]() -> S8

### Converts an `S128` to `S8`, throwing if the value is outside −128..127.
### :returns: The lower 8 bits of this value interpreted as signed.
### :throws: {IntegerOverflowError} if this value is not in `-128..=127`.
@rf("S128.to")
failable routine S128.to[S8]() -> S8

### Reinterprets a `U8` as `S8` using two's complement, throwing if the value exceeds 127.
### :returns: The same bit pattern interpreted as `S8`.
### :throws: {IntegerOverflowError} if `me > 127`.
@rf("U8.to")
failable routine U8.to[S8]() -> S8

### Converts a `U16` to `S8`, throwing if the value exceeds 127.
### :returns: The lower 8 bits interpreted as a signed `S8`.
### :throws: {IntegerOverflowError} if `me > 127`.
@rf("U16.to")
failable routine U16.to[S8]() -> S8

### Converts a `U32` to `S8`, throwing if the value exceeds 127.
### :returns: The lower 8 bits interpreted as a signed `S8`.
### :throws: {IntegerOverflowError} if `me > 127`.
@rf("U32.to")
failable routine U32.to[S8]() -> S8

### Converts a `U64` to `S8`, throwing if the value exceeds 127.
### :returns: The lower 8 bits interpreted as a signed `S8`.
### :throws: {IntegerOverflowError} if `me > 127`.
@rf("U64.to")
failable routine U64.to[S8]() -> S8

### Converts a `U128` to `S8`, throwing if the value exceeds 127.
### :returns: The lower 8 bits interpreted as a signed `S8`.
### :throws: {IntegerOverflowError} if `me > 127`.
@rf("U128.to")
failable routine U128.to[S8]() -> S8

### Converts an `S256` to `S8`, throwing if outside −128..127.
### :returns: The lower 8 bits reinterpreted as an `S8`.
### :throws: {IntegerOverflowError} if this value is outside −128..127.
@rf("S256.to")
failable routine S256.to[S8]() -> S8

### Converts a `U256` to `S8`, throwing if the value exceeds 127.
### :returns: The lower 8 bits reinterpreted as an `S8`.
### :throws: {IntegerOverflowError} if `me > 127`.
@rf("U256.to")
failable routine U256.to[S8]() -> S8

### Converts an `B16` to `S8` by first converting to `S32`, then truncating.
### :returns: The integer part of this value as an `S8`.
### :throws: {IntegerOverflowError} if the integer part is outside −128..127.
@rf("B16.to")
failable routine B16.to[S8]() -> S8

### Converts an `B32` to `S8` by first converting to `S32`, then truncating.
### :returns: The integer part of this value as an `S8`.
### :throws: {IntegerOverflowError} if the integer part is outside −128..127.
@rf("B32.to")
failable routine B32.to[S8]() -> S8

### Converts an `B64` to `S8` by first converting to `S32`, then truncating.
### :returns: The integer part of this value as an `S8`.
### :throws: {IntegerOverflowError} if the integer part is outside −128..127.
@rf("B64.to")
failable routine B64.to[S8]() -> S8

### Converts an `B128` to `S8` by first converting to `S32`, then truncating.
### :returns: The integer part of this value as an `S8`.
### :throws: {IntegerOverflowError} if the integer part is outside −128..127.
@rf("B128.to")
failable routine B128.to[S8]() -> S8

### Converts a `D32` to `S8` by first converting to `S32`, then truncating.
### :returns: The integer part of this value as an `S8`.
### :throws: {IntegerOverflowError} if the integer part is outside −128..127.
@rf("D32.to")
failable routine D32.to[S8]() -> S8

### Converts a `D64` to `S8` by first converting to `S32`, then truncating.
### :returns: The integer part of this value as an `S8`.
### :throws: {IntegerOverflowError} if the integer part is outside −128..127.
@rf("D64.to")
failable routine D64.to[S8]() -> S8

### Converts a `D128` to `S8` by first converting to `S32`, then truncating.
### :returns: The integer part of this value as an `S8`.
### :throws: {IntegerOverflowError} if the integer part is outside −128..127.
@rf("D128.to")
failable routine D128.to[S8]() -> S8

### Parses a decimal string into an `S8`, accepting an optional leading `+` or `−` sign.
### :returns: The parsed `S8` value.
### :throws: {InvalidValueError} if this value is empty, sign-only, or contains non-digit characters.
### :throws: {IntegerOverflowError} if the value does not fit in `S8`.
@rf("Text.to")
failable routine Text.to[S8]() -> S8
