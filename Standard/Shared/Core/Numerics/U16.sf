module Core

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### A 16-bit unsigned integer in the range 0 to 65,535.
###
### `U16` is commonly used for Unicode code units (UTF-16), audio samples,
### and other data that fits in 16 bits.
@rf("U16")
record U16
obeys UnsignedIntegral, Comparable, Copyable
    pass

### Converts an `S8` to `U16`, throwing if the value is negative.
### :param from: The `S8` value to convert.
### :returns: A `U16` with the same unsigned value as `from`.
### :throws: {IntegerOverflowError} if `from < 0`.
@rf("U16")
routine U16!(from: S8) -> U16

### Converts an `S16` to `U16`, throwing if the value is negative.
### :param from: The `S16` value to convert.
### :returns: The same bit pattern reinterpreted as an unsigned value.
### :throws: {IntegerOverflowError} if `from < 0`.
@rf("U16")
routine U16!(from: S16) -> U16

### Converts an `S32` to `U16`, throwing if the value is outside 0..65535.
### :param from: The `S32` value to convert.
### :returns: The lower 16 bits of `from`.
### :throws: {IntegerOverflowError} if `from` is not in `0..=65535`.
@rf("U16")
routine U16!(from: S32) -> U16

### Converts an `S64` to `U16`, throwing if the value is outside 0..65535.
### :param from: The `S64` value to convert.
### :returns: The lower 16 bits of `from`.
### :throws: {IntegerOverflowError} if `from` is not in `0..=65535`.
@rf("U16")
routine U16!(from: S64) -> U16

### Converts an `S128` to `U16`, throwing if the value is outside 0..65535.
### :param from: The `S128` value to convert.
### :returns: The lower 16 bits of `from`.
### :throws: {IntegerOverflowError} if `from` is not in `0..=65535`.
@rf("U16")
routine U16!(from: S128) -> U16

### Zero-extends a `U8` to `U16`.
### :param from: The `U8` value to widen.
### :returns: A `U16` equal in value to `from`.
@rf("U16")
routine U16(from: U8) -> U16

### Identity conversion — returns `from` unchanged.
### :param from: The `U16` value to return.
### :returns: `from` unchanged.
@rf("U16")
routine U16(from: U16) -> U16

### Converts a `U32` to `U16`, throwing if the value exceeds 65535.
### :param from: The `U32` value to convert.
### :returns: The lower 16 bits of `from`.
### :throws: {IntegerOverflowError} if `from > 65535`.
@rf("U16")
routine U16!(from: U32) -> U16

### Converts a `U64` to `U16`, throwing if the value exceeds 65535.
### :param from: The `U64` value to convert.
### :returns: The lower 16 bits of `from`.
### :throws: {IntegerOverflowError} if `from > 65535`.
@rf("U16")
routine U16!(from: U64) -> U16

### Converts a `U128` to `U16`, throwing if the value exceeds 65535.
### :param from: The `U128` value to convert.
### :returns: The lower 16 bits of `from`.
### :throws: {IntegerOverflowError} if `from > 65535`.
@rf("U16")
routine U16!(from: U128) -> U16

### Converts an `S256` to `U16`, throwing if the value is negative or exceeds 65535.
### :param from: The `S256` value to convert.
### :returns: The lower 16 bits of `from`.
### :throws: {IntegerOverflowError} if `from` is outside 0..65535.
@rf("U16")
routine U16!(from: S256) -> U16

### Converts a `U256` to `U16`, throwing if the value exceeds 65535.
### :param from: The `U256` value to convert.
### :returns: The lower 16 bits of `from`.
### :throws: {IntegerOverflowError} if `from > 65535`.
@rf("U16")
routine U16!(from: U256) -> U16

### Converts an `B16` to `U16` by first converting to `U32`, then truncating.
### :param from: The `B16` value to convert.
### :returns: The integer part of `from` as a `U16`.
### :throws: {IntegerOverflowError} if the integer part exceeds 65535.
@rf("U16")
routine U16!(from: B16) -> U16

### Converts an `B32` to `U16` by first converting to `U32`, then truncating.
### :param from: The `B32` value to convert.
### :returns: The integer part of `from` as a `U16`.
### :throws: {IntegerOverflowError} if the integer part exceeds 65535.
@rf("U16")
routine U16!(from: B32) -> U16

### Converts an `B64` to `U16` by first converting to `U32`, then truncating.
### :param from: The `B64` value to convert.
### :returns: The integer part of `from` as a `U16`.
### :throws: {IntegerOverflowError} if the integer part exceeds 65535.
@rf("U16")
routine U16!(from: B64) -> U16

### Converts an `B128` to `U16` by first converting to `U32`, then truncating.
### :param from: The `B128` value to convert.
### :returns: The integer part of `from` as a `U16`.
### :throws: {IntegerOverflowError} if the integer part exceeds 65535.
@rf("U16")
routine U16!(from: B128) -> U16

### Converts a `D32` to `U16` by first converting to `U32`, then truncating.
### :param from: The `D32` value to convert.
### :returns: The integer part of `from` as a `U16`.
### :throws: {IntegerOverflowError} if the integer part exceeds 65535.
@rf("U16")
routine U16!(from: D32) -> U16

### Converts a `D64` to `U16` by first converting to `U32`, then truncating.
### :param from: The `D64` value to convert.
### :returns: The integer part of `from` as a `U16`.
### :throws: {IntegerOverflowError} if the integer part exceeds 65535.
@rf("U16")
routine U16!(from: D64) -> U16

### Converts a `D128` to `U16` by first converting to `U32`, then truncating.
### :param from: The `D128` value to convert.
### :returns: The integer part of `from` as a `U16`.
### :throws: {IntegerOverflowError} if the integer part exceeds 65535.
@rf("U16")
routine U16!(from: D128) -> U16

### Returns the sum and a flag indicating whether the result wrapped around.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_sum, overflowed)`.
@rf("U16.add_with_overflow")
routine U16.add_with_overflow(you: U16) -> (U16, Bool)

### Returns the difference and a flag indicating whether the result wrapped around.
### :param you: The value to subtract.
### :returns: A tuple of `(wrapped_difference, overflowed)`.
@rf("U16.sub_with_overflow")
routine U16.sub_with_overflow(you: U16) -> (U16, Bool)

### Returns the product and a flag indicating whether the result wrapped around.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_product, overflowed)`.
@rf("U16.mul_with_overflow")
routine U16.mul_with_overflow(you: U16) -> (U16, Bool)

### Returns `me + you`, throwing on overflow.
### :param you: The right operand.
### :returns: The sum `me + you`.
### :throws: {IntegerOverflowError} if the result exceeds `U16_MAX`.
@rf("U16.add")
routine U16.add!(you: U16) -> U16

### Returns `me - you`, throwing on underflow.
### :param you: The value to subtract.
### :returns: The difference `me - you`.
### :throws: {IntegerOverflowError} if the result is less than `U16_MIN` (0).
@rf("U16.sub")
routine U16.sub!(you: U16) -> U16

### Returns `me * you`, throwing on overflow.
### :param you: The right operand.
### :returns: The product `me * you`.
### :throws: {IntegerOverflowError} if the result exceeds `U16_MAX`.
@rf("U16.mul")
routine U16.mul!(you: U16) -> U16

### Returns `me // you` (integer division), throwing if `you` is zero.
### :param you: The divisor.
### :returns: The quotient `me // you`.
### :throws: {DivisionByZeroError} if `you == 0`.
@rf("U16.floordiv")
routine U16.floordiv!(you: U16) -> U16

### Returns `me % you` (integer remainder).
### :param you: The divisor.
### :returns: The remainder `me % you`. Behavior is undefined if `you == 0`.
@rf("U16.mod")
routine U16.mod!(you: U16) -> U16

### Returns the two's-complement negation `(2¹⁶ - me) mod 2¹⁶`.
### :returns: The wrapped negation.
@rf("U16.neg_wrap")
routine U16.neg_wrap() -> U16

### Returns `(wrapping negation, overflowed)`. Overflow occurs for any non-zero value.
### :returns: A tuple of `(wrapped negation, overflow flag)`.
@rf("U16.neg_with_overflow")
routine U16.neg_with_overflow() -> (U16, Bool)

### Returns `(me + you) mod 65536` without overflow check.
### :param you: The right operand.
### :returns: The sum modulo 65536.
@rf("U16.add_wrap")
routine U16.add_wrap(you: U16) -> U16

### Returns `(me - you) mod 65536` without underflow check.
### :param you: The value to subtract.
### :returns: The difference modulo 65536.
@rf("U16.sub_wrap")
routine U16.sub_wrap(you: U16) -> U16

### Returns `(me * you) mod 65536` without overflow check.
### :param you: The right operand.
### :returns: The product modulo 65536.
@rf("U16.mul_wrap")
routine U16.mul_wrap(you: U16) -> U16

### Returns `me + you`, clamped to `U16_MAX` on overflow.
### :param you: The right operand.
### :returns: The sum, or `65535` if it would exceed `U16_MAX`.
@rf("U16.add_clamp")
routine U16.add_clamp(you: U16) -> U16

### Returns `me - you`, clamped to `U16_MIN` on underflow.
### :param you: The value to subtract.
### :returns: The difference, or `0` if it would go below `U16_MIN`.
@rf("U16.sub_clamp")
routine U16.sub_clamp(you: U16) -> U16

### Returns `me * you`, clamped to `U16_MAX` on overflow.
### :param you: The right operand.
### :returns: The product, or `65535` if it would exceed `U16_MAX`.
@rf("U16.mul_clamp")
routine U16.mul_clamp(you: U16) -> U16

### Returns `me + you + carry` as `(wrapped_sum, carry_out)`.
### Chains across words to add integers wider than `U16`: feed each word's
### `carry_out` in as the next higher word's `carry`.
### :param you: The right operand.
### :param carry: The incoming carry bit from the lower word.
### :returns: A tuple of `(wrapped sum, outgoing carry)`.
@rf("U16.carrying_add")
routine U16.carrying_add(you: U16, carry: Bool) -> (U16, Bool)

### Returns `me - you - borrow` as `(wrapped_difference, borrow_out)`.
### Chains across words to subtract integers wider than `U16`.
### :param you: The value to subtract.
### :param borrow: The incoming borrow bit from the lower word.
### :returns: A tuple of `(wrapped difference, outgoing borrow)`.
@rf("U16.borrowing_sub")
routine U16.borrowing_sub(you: U16, borrow: Bool) -> (U16, Bool)

### Returns the full `me * you` product as `(low, high)` halves.
### The product of two `U16` values needs 32 bits; this splits it into the low
### and high `U16` words without loss.
### :param you: The right operand.
### :returns: A tuple of `(low 16 bits, high 16 bits)`.
@rf("U16.widening_mul")
routine U16.widening_mul(you: U16) -> (U16, U16)

### Returns `me * you + carry` as `(low, high)` halves.
### Never overflows: the largest result is `(2¹⁶-1)² + (2¹⁶-1) < 2³²`. The
### workhorse of schoolbook multiplication — `carry` accumulates the high word
### carried out of the previous column.
### :param you: The right operand.
### :param carry: The value to add to the product.
### :returns: A tuple of `(low 16 bits, high 16 bits)`.
@rf("U16.carrying_mul")
routine U16.carrying_mul(you: U16, carry: U16) -> (U16, U16)

### Returns `me ** exp` and a flag indicating whether the result wrapped around.
### :param exp: The exponent.
### :returns: A tuple of `(wrapped_result, overflowed)`.
@rf("U16.pow_with_overflow")
routine U16.pow_with_overflow(exp: U16) -> (U16, Bool)

### Returns `me ** exp`, throwing on overflow.
### :param exp: The exponent.
### :returns: The result of raising `me` to the power `exp`.
### :throws: {IntegerOverflowError} if the result exceeds `U16_MAX`.
@rf("U16.pow")
routine U16.pow!(exp: U16) -> U16

### Returns `me ** exp` with wrapping arithmetic (mod 65536).
### :param exp: The exponent.
### :returns: The result modulo 65536.
@rf("U16.pow_wrap")
routine U16.pow_wrap(exp: U16) -> U16

### Returns `me ** exp`, clamped to `U16_MAX` on overflow.
### :param exp: The exponent.
### :returns: The result, or `65535` if it would overflow.
@rf("U16.pow_clamp")
routine U16.pow_clamp(exp: U16) -> U16

### Returns the bitwise AND of this value and `you`.
### :param you: The right operand.
### :returns: `me & you`.
@rf("U16.bitand")
routine U16.bitand(you: U16) -> U16

### Returns the bitwise OR of this value and `you`.
### :param you: The right operand.
### :returns: `me | you`.
@rf("U16.bitor")
routine U16.bitor(you: U16) -> U16

### Returns the bitwise XOR of this value and `you`.
### :param you: The right operand.
### :returns: `me ^ you`.
@rf("U16.bitxor")
routine U16.bitxor(you: U16) -> U16

### Returns the bitwise complement of this value.
### :returns: `~me` — each bit flipped.
@rf("U16.bitnot")
routine U16.bitnot() -> U16

### Returns `true` when both values are equal.
### :param you: The value to compare against.
### :returns: `true` if `me == you`; `false` otherwise.
@rf("U16.eq")
routine U16.eq(you: U16) -> Bool

### Compares this value with `you`, returning the ordering relationship.
### :param you: The value to compare against.
### :returns: `ME_SMALL` if `me < you`, `ME_LARGE` if `me > you`, `SAME` if equal.
@rf("U16.cmp")
routine U16.cmp(you: U16) -> ComparisonSign

### Returns the smaller of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me <= you`; otherwise `you`.
@rf("U16.min")
routine U16.min(you: U16) -> U16

### Returns the larger of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me >= you`; otherwise `you`.
@rf("U16.max")
routine U16.max(you: U16) -> U16

### Returns this value clamped to the range `min_val..=max_val`.
### :param min_val: The lower bound (inclusive).
### :param max_val: The upper bound (inclusive).
### :returns: `min_val` if `me < min_val`; `max_val` if `me > max_val`; otherwise `me`.
@rf("U16.clamp")
routine U16.clamp(min_val: U16, max_val: U16) -> U16

### Returns the integer square root ⌊√me⌋ — the largest value whose square is ≤ me.
### :returns: The floor of the square root of `me`.
@rf("U16.isqrt")
routine U16.isqrt() -> U16

### Returns the integer square root together with its remainder: `(s, r)` with `s = ⌊√me⌋` and
### `r = me - s*s`, so `0 <= r <= 2s` (e.g. `5.sqrtrem()` is `(2, 1)`).
### :returns: The tuple `(root, remainder)`.
@rf("U16.sqrtrem")
routine U16.sqrtrem() -> (U16, U16)

### Returns ⌊log_base me⌋. Throws if `me` is zero or `base < 2`.
### :param base: The logarithm base (must be ≥ 2).
### :returns: The floor of the base-`base` logarithm.
### :throws: {NumericDomainError} if `me == 0` or `base < 2`.
@rf("U16.ilog")
routine U16.ilog!(base: U16) -> U16

### Returns the absolute difference |me - you| without overflow.
### :param you: The other value.
### :returns: The non-negative distance between `me` and `you`.
@rf("U16.abs_diff")
routine U16.abs_diff(you: U16) -> U16

### Returns ⌈me / you⌉ (division rounding toward positive infinity).
### :param you: The divisor.
### :returns: The ceiling of `me / you`.
### :throws: {DivisionByZeroError} if `you == 0`.
@rf("U16.div_ceil")
routine U16.div_ceil(you: U16) -> U16

### Returns the smallest power of two that is ≥ me. Both `0` and `1` map to `1`.
### :returns: The next power of two at or above `me`.
### :throws: {IntegerOverflowError} if the next power of two exceeds `U16_MAX`.
@rf("U16.next_power_of_two")
routine U16.next_power_of_two!() -> U16

### Returns the smallest multiple of `you` that is ≥ me.
### :param you: The base to round up to.
### :returns: The next multiple of `you` at or above `me`.
### :throws: {DivisionByZeroError} if `you == 0`.
### :throws: {IntegerOverflowError} if the result exceeds `U16_MAX`.
@rf("U16.next_multiple_of")
routine U16.next_multiple_of(you: U16) -> U16

### Returns ⌊(me + you) / 2⌋ computed without overflow.
### :param you: The other value.
### :returns: The midpoint of `me` and `you`, rounding toward negative infinity.
@rf("U16.midpoint")
routine U16.midpoint(you: U16) -> U16

### Returns this value with its bits reversed (bit 15 ↔ bit 0, etc.).
### :returns: The bit-reversed `U16`.
@rf("U16.reverse_bits")
routine U16.reverse_bits() -> U16

### Returns this value with its two bytes swapped (for endianness conversion).
### :returns: A `U16` with the high and low bytes exchanged.
@rf("U16.swap_bytes")
routine U16.swap_bytes() -> U16

### Returns `true` if this value is an exact power of two.
### :returns: `true` if `me` is 1, 2, 4, ..., 32768; `false` otherwise (including zero).
@rf("U16.is_power_of_two")
routine U16.is_power_of_two() -> Bool

### Returns the raw byte representation of this value in little-endian order.
@rf("U16.to_bytes_le")
routine U16.to_bytes_le() -> Array[Byte, 2]

### Returns the raw byte representation of this value in big-endian order.
@rf("U16.to_bytes_be")
routine U16.to_bytes_be() -> Array[Byte, 2]

### Builds a `U16` from its little-endian raw byte representation.
@rf("U16.from_bytes_le")
common routine U16.from_bytes_le(bytes: Array[Byte, 2]) -> U16

### Builds a `U16` from its big-endian raw byte representation.
@rf("U16.from_bytes_be")
common routine U16.from_bytes_be(bytes: Array[Byte, 2]) -> U16

### Returns `true` if this value is zero.
### :returns: `true` if `me == 0`.
@rf("U16.is_zero")
routine U16.is_zero() -> Bool

### Returns `true` if this value is divisible by 2.
### :returns: `true` if the least-significant bit is 0.
@rf("U16.is_even")
routine U16.is_even() -> Bool

### Returns `true` if this value is not divisible by 2.
### :returns: `true` if the least-significant bit is 1.
@rf("U16.is_odd")
routine U16.is_odd() -> Bool

### Returns the human-readable text of this value.
### :returns: The value rendered as `Text`.
@rf("U16.represent")
routine U16.represent() -> Text

### Returns a type-tagged debug rendering of this value.
### :returns: A diagnostic `Text` rendering, e.g. `Type(value)`.
@rf("U16.diagnose")
routine U16.diagnose() -> Text

### Parses a decimal string into a `U16`.
### :param from_text: The decimal string to parse (no sign, no prefix).
### :returns: The parsed `U16` value.
### :throws: {InvalidValueError} if `from_text` is empty or contains non-digit characters.
### :throws: {IntegerOverflowError} if the value does not fit in `U16`.
@rf("U16")
routine U16!(from_text: Text) -> U16

### Returns a SipHash-2-4 keyed hash of this value.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash suitable for denial-of-service-resistant hash tables.
@rf("U16.hash")
routine U16.hash(k0: U64, k1: U64) -> U64
