module Core

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### A 16-bit "brain" floating-point value (bfloat16): the sign, the 8-bit exponent and the top 7 fraction
### bits of a `B32`, so it has `B32`'s range with about 2-3 significant decimal digits.
###
### `BF16` is how machine-learning weights and tensors are commonly stored. Its arithmetic works on the `B32`
### values and rounds once back (correctly rounded for `+ - * /` and `sqrt`), and its library functions (`exp`,
### `sin`, `pow`, ...) are correctly rounded.
@rf("BF16")
record BF16
obeys Numeric, Comparable, Copyable
    pass

### Returns the raw bfloat16 bit pattern of this value.
### :returns: The underlying `U16` encoding.
@rf("BF16.to_bits")
@readonly
routine BF16.to_bits() -> U16

### Reinterprets a raw bfloat16 bit pattern as a `BF16`.
### :param bits: The encoding: sign bit, 8 exponent bits, 7 fraction bits.
### :returns: The `BF16` value with that bit pattern.
@rf("BF16.from_bits")
common routine BF16.from_bits(bits: U16) -> BF16

### Returns a signaling NaN (interop/testing; never produced by a conversion).
@rf("BF16.signaling_nan")
common routine BF16.signaling_nan() -> BF16

### Returns the raw bytes of this value in little-endian order.
### :returns: The resulting `Array[Byte, 2]` value.
@rf("BF16.to_bytes_le")
routine BF16.to_bytes_le() -> Array[Byte, 2]

### Returns the raw bytes of this value in big-endian order.
### :returns: The resulting `Array[Byte, 2]` value.
@rf("BF16.to_bytes_be")
routine BF16.to_bytes_be() -> Array[Byte, 2]

### Returns `true` when this value encodes a NaN.
@rf("BF16.is_nan")
routine BF16.is_nan() -> Bool

### True when this is a SIGNALING NaN (quiet bit clear).
@rf("BF16.is_signaling")
routine BF16.is_signaling() -> Bool

### Returns `true` when this value encodes positive or negative infinity.
@rf("BF16.is_infinite")
routine BF16.is_infinite() -> Bool

### Returns `true` when this value is neither NaN nor infinity.
@rf("BF16.is_finite")
routine BF16.is_finite() -> Bool

### Returns `true` for positive or negative zero.
@rf("BF16.is_zero")
routine BF16.is_zero() -> Bool

### Returns `true` when the sign bit is set (negative values, -0 and negative NaNs).
@rf("BF16.signbit")
routine BF16.signbit() -> Bool

### Returns whether both values are equal (IEEE: a NaN equals nothing, +0 equals -0).
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
@rf("BF16.eq")
routine BF16.eq(you: BF16) -> Bool

### Compares this value with the other value (a NaN on either side compares as `SAME`).
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
@rf("BF16.cmp")
routine BF16.cmp(you: BF16) -> ComparisonSign

### Returns the shortest decimal text that reads back as this exact value (`BF16(from_text:)` round-trips
### it bit for bit).
### :returns: The resulting `Text` value.
@rf("BF16.represent")
routine BF16.represent() -> Text

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@rf("BF16.diagnose")
routine BF16.diagnose() -> Text

### Narrows a single-precision float to bfloat16: the nearest value, ties to even (a value past the largest
### finite `BF16` becomes infinity, and a NaN stays a NaN, made quiet).
### :returns: The nearest `BF16` value.
@rf("B32.to")
routine B32.to[BF16]() -> BF16

### Narrows a double-precision float to bfloat16 in one rounding, to the nearest value, ties to even (not
### through `B32`, whose own rounding could land on a bfloat16 midpoint). Values below half the smallest
### subnormal `BF16` (2^-134) become a signed zero, values past the largest finite one infinity, and a NaN
### stays a NaN, made quiet.
### :returns: The nearest `BF16` value.
@rf("B64.to")
routine B64.to[BF16]() -> BF16

### Parses decimal text into the nearest `BF16` (one rounding from the exact decimal value, ties to even).
### Accepts the forms `B32(from_text:)` accepts, including `nan` and `inf`.
### :returns: The nearest `BF16` value.
### :throws: {InvalidValueError} on malformed input.
@rf("Text.to")
failable routine Text.to[BF16]() -> BF16

### Returns `me + you` with raw IEEE 754 results (overflow gives ±infinity), rounded once to BF16.
### :param you: The other operand.
### :returns: The result.
@rf("BF16.add_unchecked")
@readonly
routine BF16.add_unchecked(you: BF16) -> BF16

### Returns `me + you`. Checked: crashes when the result isn't finite. Use `add_unchecked` for raw IEEE 754 results.
### :param you: The other operand.
### :returns: The result.
### :throws: {NumericDomainError} when there is no real result.
### :throws: {NumericOverflowError} when the result is out of range.
@rf("BF16.add")
failable routine BF16.add(you: BF16) -> BF16

### Returns `me - you` with raw IEEE 754 results (overflow gives ±infinity), rounded once to BF16.
### :param you: The other operand.
### :returns: The result.
@rf("BF16.sub_unchecked")
@readonly
routine BF16.sub_unchecked(you: BF16) -> BF16

### Returns `me - you`. Checked: crashes when the result isn't finite. Use `sub_unchecked` for raw IEEE 754 results.
### :param you: The other operand.
### :returns: The result.
### :throws: {NumericDomainError} when there is no real result.
### :throws: {NumericOverflowError} when the result is out of range.
@rf("BF16.sub")
failable routine BF16.sub(you: BF16) -> BF16

### Returns `me * you` with raw IEEE 754 results (overflow gives ±infinity), rounded once to BF16.
### :param you: The other operand.
### :returns: The result.
@rf("BF16.mul_unchecked")
@readonly
routine BF16.mul_unchecked(you: BF16) -> BF16

### Returns `me * you`. Checked: crashes when the result isn't finite. Use `mul_unchecked` for raw IEEE 754 results.
### :param you: The other operand.
### :returns: The result.
### :throws: {NumericDomainError} when there is no real result.
### :throws: {NumericOverflowError} when the result is out of range.
@rf("BF16.mul")
failable routine BF16.mul(you: BF16) -> BF16

### Returns `me / you` with raw IEEE 754 results (overflow gives ±infinity), rounded once to BF16.
### :param you: The other operand.
### :returns: The result.
@rf("BF16.truediv_unchecked")
@readonly
routine BF16.truediv_unchecked(you: BF16) -> BF16

### Returns `me / you`. Checked: crashes when the result isn't finite. Use `truediv_unchecked` for raw IEEE 754 results.
### :param you: The other operand.
### :returns: The result.
### :throws: {NumericDomainError} when there is no real result.
### :throws: {NumericOverflowError} when the result is out of range.
@rf("BF16.truediv")
failable routine BF16.truediv(you: BF16) -> BF16

### Returns the square root with raw IEEE 754 results (`sqrt` of a negative value is NaN), rounded once to BF16.
### :returns: The square root.
@rf("BF16.sqrt_unchecked")
routine BF16.sqrt_unchecked() -> BF16

### Returns the square root. Checked: crashes when the result isn't finite. Use `sqrt_unchecked` for raw IEEE 754 results.
### :returns: The result.
### :throws: {NumericDomainError} when there is no real result.
### :throws: {NumericOverflowError} when the result is out of range.
@rf("BF16.sqrt")
failable routine BF16.sqrt() -> BF16

### Returns this value when it is finite. Checked: crashes on ±infinity or NaN.
### :returns: This value.
### :throws: {NumericDomainError} for NaN.
### :throws: {NumericOverflowError} for ±infinity.
@rf("BF16.finite")
failable routine BF16.finite() -> BF16

### Returns the negation: the sign bit flipped (NaN keeps its payload).
### :returns: `-me`.
@rf("BF16.neg")
@readonly
routine BF16.neg() -> BF16

### Returns the absolute value: the sign bit cleared.
### :returns: `|me|`.
@rf("BF16.abs")
routine BF16.abs() -> BF16

### Returns this value's magnitude with the sign of `sign`.
### :param sign: The value whose sign is taken.
### :returns: The value with that sign.
@rf("BF16.copysign")
routine BF16.copysign(sign: BF16) -> BF16

### Rounds down to a whole number.
### :returns: The result.
@rf("BF16.floor")
routine BF16.floor() -> BF16

### Rounds up to a whole number.
### :returns: The result.
@rf("BF16.ceil")
routine BF16.ceil() -> BF16

### Rounds to the nearest whole number, halves away from zero.
### :returns: The result.
@rf("BF16.round")
routine BF16.round() -> BF16

### Rounds to the nearest whole number, ties away from zero.
### :returns: The result.
@rf("BF16.round_ties_away")
routine BF16.round_ties_away() -> BF16

### Rounds to a whole number in the current rounding mode (to nearest, ties to even).
### :returns: The result.
@rf("BF16.rint")
routine BF16.rint() -> BF16

### Rounds toward zero to a whole number.
### :returns: The result.
@rf("BF16.trunc")
routine BF16.trunc() -> BF16

### Rounds toward zero to a whole number.
### :returns: The result.
@rf("BF16.int_truncate")
routine BF16.int_truncate() -> BF16

### Returns the fractional part, `me - me.trunc()`.
### :returns: The result.
@rf("BF16.frac")
routine BF16.frac() -> BF16

### Returns `1 / me`, rounded once to BF16.
### :returns: The result.
@rf("BF16.recip")
routine BF16.recip() -> BF16

### Converts radians to degrees.
### :returns: The result.
@rf("BF16.to_degrees")
routine BF16.to_degrees() -> BF16

### Converts degrees to radians.
### :returns: The result.
@rf("BF16.to_radians")
routine BF16.to_radians() -> BF16

### Returns 1 for a positive value, -1 for a negative one, the value itself for a zero or NaN.
### :returns: The result.
@rf("BF16.signum")
routine BF16.signum() -> BF16

### Returns the exponent of this value as a float.
### :returns: The result.
@rf("BF16.logb")
routine BF16.logb() -> BF16

### Returns the value halfway between `me` and `you`.
### :param you: The other value.
### :returns: The result.
@rf("BF16.midpoint")
routine BF16.midpoint(you: BF16) -> BF16

### Returns the smaller value.
### :param you: The other value.
### :returns: The result.
@rf("BF16.min")
routine BF16.min(you: BF16) -> BF16

### Returns the larger value.
### :param you: The other value.
### :returns: The result.
@rf("BF16.max")
routine BF16.max(you: BF16) -> BF16

### Returns the smaller value, the other one when one is NaN.
### :param you: The other value.
### :returns: The result.
@rf("BF16.min_num")
routine BF16.min_num(you: BF16) -> BF16

### Returns the larger value, the other one when one is NaN.
### :param you: The other value.
### :returns: The result.
@rf("BF16.max_num")
routine BF16.max_num(you: BF16) -> BF16

### Returns the smaller value, NaN when either is NaN, and -0 below +0.
### :param you: The other value.
### :returns: The result.
@rf("BF16.minimum")
routine BF16.minimum(you: BF16) -> BF16

### Returns the larger value, NaN when either is NaN, and +0 above -0.
### :param you: The other value.
### :returns: The result.
@rf("BF16.maximum")
routine BF16.maximum(you: BF16) -> BF16

### Returns the larger value, the other one when one is NaN (C `fmax`).
### :param you: The other value.
### :returns: The result.
@rf("BF16.fmax")
routine BF16.fmax(you: BF16) -> BF16

### Returns the smaller value, the other one when one is NaN (C `fmin`).
### :param you: The other value.
### :returns: The result.
@rf("BF16.fmin")
routine BF16.fmin(you: BF16) -> BF16

### Returns `me - you` when it is positive, otherwise 0.
### :param you: The other value.
### :returns: The result.
@rf("BF16.fdim")
routine BF16.fdim(you: BF16) -> BF16

### Returns the remainder of `me / you` truncated toward zero (C `fmod`).
### :param you: The other value.
### :returns: The result.
@rf("BF16.fmod")
routine BF16.fmod(you: BF16) -> BF16

### Returns the remainder of `me / you` rounded to nearest (C `remainder`).
### :param you: The other value.
### :returns: The result.
@rf("BF16.remainder")
routine BF16.remainder(you: BF16) -> BF16

### Returns `me * 2^n` with raw IEEE 754 results, rounded once to BF16.
### :param n: The power of two.
### :returns: The result.
@rf("BF16.scaleb_unchecked")
routine BF16.scaleb_unchecked(n: S64) -> BF16

### Returns this value limited to `[min_val, max_val]`.
### :param min_val: The lower bound.
### :param max_val: The upper bound.
### :returns: The value, or the nearer bound.
@rf("BF16.clamp")
routine BF16.clamp(min_val: BF16, max_val: BF16) -> BF16

### Returns this value raised to an integer power, correctly rounded.
### :param n: The power.
### :returns: `me^n`.
@rf("BF16.powi")
routine BF16.powi(n: S32) -> BF16

### Returns `me * b + c` with one rounding (fused multiply-add), raw IEEE 754 results.
### :param b: The multiplier.
### :param c: The addend.
### :returns: The fused result.
@rf("BF16.fma_unchecked")
routine BF16.fma_unchecked(b: BF16, c: BF16) -> BF16

### Returns `me * b + c` with one rounding. Checked: crashes when the result isn't finite. Use `fma_unchecked` for raw IEEE 754 results.
### :param b: The multiplier.
### :param c: The addend.
### :returns: The result.
### :throws: {NumericDomainError} when there is no real result.
### :throws: {NumericOverflowError} when the result is out of range.
@rf("BF16.fma")
failable routine BF16.fma(b: BF16, c: BF16) -> BF16

### Returns the whole part and the fractional part of this value, both with its sign.
### :returns: `(whole, fractional)`.
@rf("BF16.modf")
routine BF16.modf() -> (BF16, BF16)

### Splits this value into a fraction in [0.5, 1) and a power of two.
### :returns: `(fraction, exponent)` with `me = fraction * 2^exponent`.
@rf("BF16.frexp")
routine BF16.frexp() -> (BF16, S64)

### Whether this value is above zero.
### :returns: True for a positive value, +infinity included.
@rf("BF16.is_positive")
routine BF16.is_positive() -> Bool

### Whether this value is below zero.
### :returns: True for a negative value, -infinity included.
@rf("BF16.is_negative")
routine BF16.is_negative() -> Bool

### Whether this value is subnormal: nonzero and below the smallest normal BF16 (the same range as `B32`'s).
### :returns: True for a subnormal value.
@rf("BF16.is_subnormal")
routine BF16.is_subnormal() -> Bool

### Whether this value is normal: finite, nonzero, and not subnormal.
### :returns: True for a normal value.
@rf("BF16.is_normal")
routine BF16.is_normal() -> Bool

### The class of this value: NaN, infinite, zero, subnormal or normal.
### :returns: The class.
@rf("BF16.fpclassify")
routine BF16.fpclassify() -> FpClass

### The IEEE 754 total order: -NaN, -infinity, ..., -0, +0, ..., +infinity, +NaN.
### :param you: The other value.
### :returns: True when `me` comes no later than `you` in that order.
@rf("BF16.total_order")
routine BF16.total_order(you: BF16) -> Bool

### The IEEE 754 total order of the magnitudes.
### :param you: The other value.
### :returns: True when `|me|` comes no later than `|you|` in that order.
@rf("BF16.total_order_mag")
routine BF16.total_order_mag(you: BF16) -> Bool

### The smallest BF16 above this value (+infinity stays, NaN stays, -0 and +0 go to the smallest subnormal).
### :returns: The next value up.
@rf("BF16.next_up")
routine BF16.next_up() -> BF16

### The largest BF16 below this value.
### :returns: The next value down.
@rf("BF16.next_down")
routine BF16.next_down() -> BF16

### The next BF16 from this value toward `you`.
### :param you: The direction.
### :returns: The next value, `you` when the two are equal, NaN when either is.
@rf("BF16.nextafter")
routine BF16.nextafter(you: BF16) -> BF16

### A hash of this value: +0 and -0 hash alike, as they compare equal.
### :param k0: The first key word.
### :param k1: The second key word.
### :returns: The hash.
@rf("BF16.hash")
routine BF16.hash(k0: U64, k1: U64) -> U64

### Returns e raised to this value with raw IEEE 754 results (a pole, overflow or a value outside the domain passes
### through as ±infinity or NaN), correctly rounded to BF16.
### :returns: The correctly rounded result.
@rf("BF16.exp_unchecked")
routine BF16.exp_unchecked() -> BF16

### Returns e raised to this value, correctly rounded. Checked: crashes when the result isn't finite. Use `exp_unchecked` for raw IEEE 754 results.
### :returns: The result.
### :throws: {NumericDomainError} when there is no real result.
### :throws: {NumericOverflowError} when the result is out of range.
@rf("BF16.exp")
failable routine BF16.exp() -> BF16

