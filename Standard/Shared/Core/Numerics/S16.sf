module Core

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### A 16-bit signed integer in the range −32,768 to 32,767.
###
### `S16` is used for audio samples (PCM 16-bit), compact numeric data,
### and other values that fit in 16 bits with a sign.
@rf("S16")
record S16
obeys SignedIntegral, Comparable, Copyable
    pass

### Sign-extends an `S8` to `S16`.
### :param from: The `S8` value to widen.
### :returns: An `S16` with the same signed value as `from`.
@rf("S16")
routine S16(from: S8) -> S16

### Identity conversion — returns `from` unchanged.
### :param from: The `S16` value to return.
### :returns: `from` unchanged.
@rf("S16")
routine S16(from: S16) -> S16

### Converts an `S32` to `S16`, throwing if the value is outside −32768..32767.
### :param from: The `S32` value to convert.
### :returns: The lower 16 bits of `from` interpreted as signed.
### :throws: {IntegerOverflowError} if `from` is not in `-32768..=32767`.
@rf("S16")
routine S16!(from: S32) -> S16

### Converts an `S64` to `S16`, throwing if the value is outside −32768..32767.
### :param from: The `S64` value to convert.
### :returns: The lower 16 bits of `from` interpreted as signed.
### :throws: {IntegerOverflowError} if `from` is not in `-32768..=32767`.
@rf("S16")
routine S16!(from: S64) -> S16

### Converts an `S128` to `S16`, throwing if the value is outside −32768..32767.
### :param from: The `S128` value to convert.
### :returns: The lower 16 bits of `from` interpreted as signed.
### :throws: {IntegerOverflowError} if `from` is not in `-32768..=32767`.
@rf("S16")
routine S16!(from: S128) -> S16

### Zero-extends a `U8` to `S16` (always succeeds — `U8` max 255 fits in S16).
### :param from: The `U8` value to widen.
### :returns: An `S16` equal in value to `from`.
@rf("S16")
routine S16(from: U8) -> S16

### Reinterprets a `U16` as `S16` using two's complement, throwing if the value exceeds 32767.
### :param from: The `U16` value to convert.
### :returns: The same bit pattern interpreted as `S16`.
### :throws: {IntegerOverflowError} if `from > 32767`.
@rf("S16")
routine S16!(from: U16) -> S16

### Converts a `U32` to `S16`, throwing if the value exceeds 32767.
### :param from: The `U32` value to convert.
### :returns: The lower 16 bits interpreted as a signed `S16`.
### :throws: {IntegerOverflowError} if `from > 32767`.
@rf("S16")
routine S16!(from: U32) -> S16

### Converts a `U64` to `S16`, throwing if the value exceeds 32767.
### :param from: The `U64` value to convert.
### :returns: The lower 16 bits interpreted as a signed `S16`.
### :throws: {IntegerOverflowError} if `from > 32767`.
@rf("S16")
routine S16!(from: U64) -> S16

### Converts a `U128` to `S16`, throwing if the value exceeds 32767.
### :param from: The `U128` value to convert.
### :returns: The lower 16 bits interpreted as a signed `S16`.
### :throws: {IntegerOverflowError} if `from > 32767`.
@rf("S16")
routine S16!(from: U128) -> S16

### Converts an `S256` to `S16`, throwing if outside −32768..32767.
### :param from: The `S256` value to convert.
### :returns: The lower 16 bits reinterpreted as an `S16`.
### :throws: {IntegerOverflowError} if `from` is outside −32768..32767.
@rf("S16")
routine S16!(from: S256) -> S16

### Converts a `U256` to `S16`, throwing if the value exceeds 32767.
### :param from: The `U256` value to convert.
### :returns: The lower 16 bits reinterpreted as an `S16`.
### :throws: {IntegerOverflowError} if `from > 32767`.
@rf("S16")
routine S16!(from: U256) -> S16

### Converts an `B16` to `S16` by first converting to `S32`, then truncating.
### :param from: The `B16` value to convert.
### :returns: The integer part of `from` as an `S16`.
### :throws: {IntegerOverflowError} if the integer part is outside −32768..32767.
@rf("S16")
routine S16!(from: B16) -> S16

### Converts an `B32` to `S16` by first converting to `S32`, then truncating.
### :param from: The `B32` value to convert.
### :returns: The integer part of `from` as an `S16`.
### :throws: {IntegerOverflowError} if the integer part is outside −32768..32767.
@rf("S16")
routine S16!(from: B32) -> S16

### Converts an `B64` to `S16` by first converting to `S32`, then truncating.
### :param from: The `B64` value to convert.
### :returns: The integer part of `from` as an `S16`.
### :throws: {IntegerOverflowError} if the integer part is outside −32768..32767.
@rf("S16")
routine S16!(from: B64) -> S16

### Converts an `B128` to `S16` by first converting to `S32`, then truncating.
### :param from: The `B128` value to convert.
### :returns: The integer part of `from` as an `S16`.
### :throws: {IntegerOverflowError} if the integer part is outside −32768..32767.
@rf("S16")
routine S16!(from: B128) -> S16

### Converts a `D32` to `S16` by first converting to `S32`, then truncating.
### :param from: The `D32` value to convert.
### :returns: The integer part of `from` as an `S16`.
### :throws: {IntegerOverflowError} if the integer part is outside −32768..32767.
@rf("S16")
routine S16!(from: D32) -> S16

### Converts a `D64` to `S16` by first converting to `S32`, then truncating.
### :param from: The `D64` value to convert.
### :returns: The integer part of `from` as an `S16`.
### :throws: {IntegerOverflowError} if the integer part is outside −32768..32767.
@rf("S16")
routine S16!(from: D64) -> S16

### Converts a `D128` to `S16` by first converting to `S32`, then truncating.
### :param from: The `D128` value to convert.
### :returns: The integer part of `from` as an `S16`.
### :throws: {IntegerOverflowError} if the integer part is outside −32768..32767.
@rf("S16")
routine S16!(from: D128) -> S16

### Returns the sum and a flag indicating whether the result overflowed.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_sum, overflowed)`.
@rf("S16.add_with_overflow")
routine S16.add_with_overflow(you: S16) -> (S16, Bool)

### Returns the difference and a flag indicating whether the result overflowed.
### :param you: The value to subtract.
### :returns: A tuple of `(wrapped_difference, overflowed)`.
@rf("S16.sub_with_overflow")
routine S16.sub_with_overflow(you: S16) -> (S16, Bool)

### Returns the product and a flag indicating whether the result overflowed.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_product, overflowed)`.
@rf("S16.mul_with_overflow")
routine S16.mul_with_overflow(you: S16) -> (S16, Bool)

### Returns `me + you`, throwing on overflow.
### :param you: The right operand.
### :returns: The sum `me + you`.
### :throws: {IntegerOverflowError} if the result is outside −32768..32767.
@rf("S16.add")
routine S16.add!(you: S16) -> S16

### Returns `me - you`, throwing on overflow.
### :param you: The value to subtract.
### :returns: The difference `me - you`.
### :throws: {IntegerOverflowError} if the result is outside −32768..32767.
@rf("S16.sub")
routine S16.sub!(you: S16) -> S16

### Returns `me * you`, throwing on overflow.
### :param you: The right operand.
### :returns: The product `me * you`.
### :throws: {IntegerOverflowError} if the result is outside −32768..32767.
@rf("S16.mul")
routine S16.mul!(you: S16) -> S16

### Returns `me // you` (euclidean division), throwing on errors.
### Euclidean division: the remainder is always in `[0, |you|)`, consistent with `mod!`.
### The special case `S16_MIN // -1` would overflow and throws.
### :param you: The divisor.
### :returns: The euclidean quotient `me // you`.
### :throws: {DivisionByZeroError} if `you == 0`.
### :throws: {IntegerOverflowError} if `me == S16_MIN` and `you == -1`.
@rf("S16.floordiv")
routine S16.floordiv!(you: S16) -> S16

### Returns `me % you` (euclidean modulo): the remainder is always in `[0, |you|)`.
### :param you: The divisor.
### :returns: The euclidean remainder — always non-negative.
### :throws: {DivisionByZeroError} if `you == 0`.
@rf("S16.mod")
routine S16.mod!(you: S16) -> S16

### Returns `-me` (arithmetic negation), throwing on overflow.
### :returns: The negated value.
### :throws: {IntegerOverflowError} when `me` is `S16_MIN` (its negation is not representable).
@rf("S16.neg")
routine S16.neg!() -> S16

### Returns `-me` in two's complement, wrapping `S16_MIN` to itself.
### :returns: The wrapped negation.
@rf("S16.neg_wrap")
routine S16.neg_wrap() -> S16

### Returns `(-me, overflowed)`. Overflow occurs only for `S16_MIN`.
### :returns: A tuple of `(wrapped negation, overflow flag)`.
@rf("S16.neg_with_overflow")
routine S16.neg_with_overflow() -> (S16, Bool)

### Returns `-me`, clamped to `S16_MAX` when `me == S16_MIN`.
### :returns: The saturating negation.
@rf("S16.neg_clamp")
routine S16.neg_clamp() -> S16

### Returns |me| in two's complement, wrapping `|S16_MIN|` back to `S16_MIN`.
### :returns: The wrapped absolute value.
@rf("S16.abs_wrap")
routine S16.abs_wrap() -> S16

### Returns `(|me|, overflowed)`. Overflow occurs only for `S16_MIN`.
### :returns: A tuple of `(wrapped absolute value, overflow flag)`.
@rf("S16.abs_with_overflow")
routine S16.abs_with_overflow() -> (S16, Bool)

### Returns |me|, clamped to `S16_MAX` when `me == S16_MIN`.
### :returns: The saturating absolute value.
@rf("S16.abs_clamp")
routine S16.abs_clamp() -> S16

### Returns |me| as an unsigned value; `|S16_MIN|` is represented exactly.
### :returns: The absolute value as `U16`.
@rf("S16.unsigned_abs")
routine S16.unsigned_abs() -> U16

### Returns euclidean `me // you`, wrapping the `S16_MIN // -1` overflow to `S16_MIN`.
### :param you: The divisor.
### :returns: The wrapped euclidean quotient.
### :throws: {DivisionByZeroError} if `you == 0`.
@rf("S16.floordiv_wrap")
routine S16.floordiv_wrap(you: S16) -> S16

### Returns `(euclidean quotient, overflowed)`; overflow only for `S16_MIN // -1`.
### :param you: The divisor.
### :returns: A tuple of `(quotient, overflow flag)`.
### :throws: {DivisionByZeroError} if `you == 0`.
@rf("S16.floordiv_with_overflow")
routine S16.floordiv_with_overflow(you: S16) -> (S16, Bool)

### Returns euclidean `me % you`, wrapping the `S16_MIN % -1` overflow to `0`.
### :param you: The divisor.
### :returns: The wrapped euclidean remainder.
### :throws: {DivisionByZeroError} if `you == 0`.
@rf("S16.mod_wrap")
routine S16.mod_wrap(you: S16) -> S16

### Returns `(euclidean remainder, overflowed)`; overflow only for `S16_MIN % -1`.
### :param you: The divisor.
### :returns: A tuple of `(remainder, overflow flag)`.
### :throws: {DivisionByZeroError} if `you == 0`.
@rf("S16.mod_with_overflow")
routine S16.mod_with_overflow(you: S16) -> (S16, Bool)

### Returns `(me + you)` with wrapping arithmetic (mod 65536, signed).
### :param you: The right operand.
### :returns: The sum, wrapping on overflow.
@rf("S16.add_wrap")
routine S16.add_wrap(you: S16) -> S16

### Returns `(me - you)` with wrapping arithmetic (mod 65536, signed).
### :param you: The value to subtract.
### :returns: The difference, wrapping on underflow.
@rf("S16.sub_wrap")
routine S16.sub_wrap(you: S16) -> S16

### Returns `(me * you)` with wrapping arithmetic (mod 65536, signed).
### :param you: The right operand.
### :returns: The product, wrapping on overflow.
@rf("S16.mul_wrap")
routine S16.mul_wrap(you: S16) -> S16

### Returns `me + you`, clamped to `S16_MAX` or `S16_MIN` on overflow.
### :param you: The right operand.
### :returns: The sum, or `32767` / `−32768` if it would overflow.
@rf("S16.add_clamp")
routine S16.add_clamp(you: S16) -> S16

### Returns `me - you`, clamped to `S16_MAX` or `S16_MIN` on overflow.
### :param you: The value to subtract.
### :returns: The difference, or `32767` / `−32768` if it would overflow.
@rf("S16.sub_clamp")
routine S16.sub_clamp(you: S16) -> S16

### Returns `me * you`, clamped to `S16_MAX` or `S16_MIN` on overflow.
### :param you: The right operand.
### :returns: The product, or `32767` / `−32768` if it would overflow.
@rf("S16.mul_clamp")
routine S16.mul_clamp(you: S16) -> S16

### Returns `me + you + carry` as `(wrapped_sum, overflowed)`.
### Chains across words to add integers wider than `S16`: feed each word's carry
### bit up the chain. Unlike the unsigned form, the flag reports SIGNED overflow
### (the two internal overflows cancel via XOR), so it is only meaningful on the
### most-significant word of a multi-word signed value.
### :param you: The right operand.
### :param carry: The incoming carry bit from the lower word.
### :returns: A tuple of `(wrapped sum, signed-overflow flag)`.
@rf("S16.carrying_add")
routine S16.carrying_add(you: S16, carry: Bool) -> (S16, Bool)

### Returns `me - you - borrow` as `(wrapped_difference, overflowed)`.
### Chains across words to subtract integers wider than `S16`; the flag reports
### SIGNED overflow, meaningful only on the most-significant word.
### :param you: The value to subtract.
### :param borrow: The incoming borrow bit from the lower word.
### :returns: A tuple of `(wrapped difference, signed-overflow flag)`.
@rf("S16.borrowing_sub")
routine S16.borrowing_sub(you: S16, borrow: Bool) -> (S16, Bool)

### Returns `me ** exp` and a flag indicating whether the result overflowed.
### :param exp: The exponent (must be non-negative).
### :returns: A tuple of `(wrapped_result, overflowed)`.
### :throws: {NumericDomainError} if `exp < 0`.
@rf("S16.pow_with_overflow")
routine S16.pow_with_overflow!(exp: S16) -> (S16, Bool)

### Returns `me ** exp`, throwing on overflow.
### :param exp: The exponent (must be non-negative).
### :returns: The result of raising `me` to the power `exp`.
### :throws: {IntegerOverflowError} if the result is outside −32768..32767.
### :throws: {NumericDomainError} if `exp < 0`.
@rf("S16.pow")
routine S16.pow!(exp: S16) -> S16

### Returns `me ** exp` with wrapping arithmetic.
### :param exp: The exponent (must be non-negative).
### :returns: The result modulo 65536 (signed wrap).
### :throws: {NumericDomainError} if `exp < 0`.
@rf("S16.pow_wrap")
routine S16.pow_wrap!(exp: S16) -> S16

### Returns `me ** exp`, clamped to `S16_MAX` or `S16_MIN` on overflow.
### :param exp: The exponent (must be non-negative).
### :returns: The result, or `32767` / `−32768` if it would overflow.
### :throws: {NumericDomainError} if `exp < 0`.
@rf("S16.pow_clamp")
routine S16.pow_clamp!(exp: S16) -> S16

### Returns the bitwise AND of this value and `you`.
### :param you: The right operand.
### :returns: `me & you`.
@rf("S16.bitand")
routine S16.bitand(you: S16) -> S16

### Returns the bitwise OR of this value and `you`.
### :param you: The right operand.
### :returns: `me | you`.
@rf("S16.bitor")
routine S16.bitor(you: S16) -> S16

### Returns the bitwise XOR of this value and `you`.
### :param you: The right operand.
### :returns: `me ^ you`.
@rf("S16.bitxor")
routine S16.bitxor(you: S16) -> S16

### Returns the bitwise complement of this value.
### :returns: `~me` — each bit flipped.
@rf("S16.bitnot")
routine S16.bitnot() -> S16

### Returns `true` when both values are equal.
### :param you: The value to compare against.
### :returns: `true` if `me == you`; `false` otherwise.
@rf("S16.eq")
routine S16.eq(you: S16) -> Bool

### Compares this value with `you`, returning the ordering relationship.
### :param you: The value to compare against.
### :returns: `ME_SMALL` if `me < you`, `ME_LARGE` if `me > you`, `SAME` if equal.
@rf("S16.cmp")
routine S16.cmp(you: S16) -> ComparisonSign

### Returns the absolute value of this integer.
### :returns: `-me` if `me < 0`; `me` if `me >= 0`.
### :throws: {IntegerOverflowError} when `me` is `S16_MIN` (its magnitude is not representable in S16).
@rf("S16.abs")
routine S16.abs!() -> S16

### Returns the smaller of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me <= you`; otherwise `you`.
@rf("S16.min")
routine S16.min(you: S16) -> S16

### Returns the larger of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me >= you`; otherwise `you`.
@rf("S16.max")
routine S16.max(you: S16) -> S16

### Returns this value clamped to the range `min_val..=max_val`.
### :param min_val: The lower bound (inclusive).
### :param max_val: The upper bound (inclusive).
### :returns: `min_val` if `me < min_val`; `max_val` if `me > max_val`; otherwise `me`.
@rf("S16.clamp")
routine S16.clamp(min_val: S16, max_val: S16) -> S16

### Returns the integer square root ⌊√me⌋. Throws for a negative `me`.
### :returns: The floor of the square root of `me`.
### :throws: {NumericDomainError} if `me < 0`.
@rf("S16.isqrt")
routine S16.isqrt() -> S16

### Returns the integer square root together with its remainder: `(s, r)` with `s = ⌊√me⌋` and
### `r = me - s*s`, so `0 <= r <= 2s` (e.g. `5.sqrtrem()` is `(2, 1)`).
### :returns: The tuple `(root, remainder)`.
### :throws: {NumericDomainError} if `me < 0`.
@rf("S16.sqrtrem")
routine S16.sqrtrem!() -> (S16, S16)

### Returns ⌊log_base me⌋. Throws if `me <= 0` or `base < 2`.
### :param base: The logarithm base (must be ≥ 2).
### :returns: The floor of the base-`base` logarithm.
### :throws: {NumericDomainError} if `me <= 0` or `base < 2`.
@rf("S16.ilog")
routine S16.ilog!(base: S16) -> S16

### Returns the absolute difference |me - you| as an unsigned value (no overflow).
### :param you: The other value.
### :returns: The non-negative distance between `me` and `you`.
@rf("S16.abs_diff")
routine S16.abs_diff(you: S16) -> U16

### Returns this value with its bits reversed (bit 15 ↔ bit 0, etc.).
### :returns: The bit-reversed `S16`.
@rf("S16.reverse_bits")
routine S16.reverse_bits() -> S16

### Returns this value with its two bytes swapped (for endianness conversion).
### :returns: An `S16` with the high and low bytes exchanged.
@rf("S16.swap_bytes")
routine S16.swap_bytes() -> S16

### Returns the raw byte representation of this value in little-endian order.
@rf("S16.to_bytes_le")
routine S16.to_bytes_le() -> Array[Byte, 2]

### Returns the raw byte representation of this value in big-endian order.
@rf("S16.to_bytes_be")
routine S16.to_bytes_be() -> Array[Byte, 2]

### Builds an `S16` from its little-endian raw byte representation.
@rf("S16.from_bytes_le")
common routine S16.from_bytes_le(bytes: Array[Byte, 2]) -> S16

### Builds an `S16` from its big-endian raw byte representation.
@rf("S16.from_bytes_be")
common routine S16.from_bytes_be(bytes: Array[Byte, 2]) -> S16

### Returns `true` if this value is greater than zero.
### :returns: `true` if `me > 0`.
@rf("S16.is_positive")
routine S16.is_positive() -> Bool

### Returns `true` if this value is less than zero.
### :returns: `true` if `me < 0`.
@rf("S16.is_negative")
routine S16.is_negative() -> Bool

### Returns `true` if this value is zero.
### :returns: `true` if `me == 0`.
@rf("S16.is_zero")
routine S16.is_zero() -> Bool

### Returns `true` if this value is divisible by 2.
### :returns: `true` if the least-significant bit is 0.
@rf("S16.is_even")
routine S16.is_even() -> Bool

### Returns `true` if this value is not divisible by 2.
### :returns: `true` if the least-significant bit is 1.
@rf("S16.is_odd")
routine S16.is_odd() -> Bool

### Returns true if this value is an exact power of two.
### Negative values always return `false`.
### :returns: `true` if `me > 0 and (me & (me - 1)) == 0`.
@rf("S16.is_power_of_two")
routine S16.is_power_of_two() -> Bool

### Returns the human-readable text of this value.
### :returns: The value rendered as `Text`.
@rf("S16.represent")
routine S16.represent() -> Text

### Returns a type-tagged debug rendering of this value.
### :returns: A diagnostic `Text` rendering, e.g. `Type(value)`.
@rf("S16.diagnose")
routine S16.diagnose() -> Text

### Parses a decimal string into an `S16`, accepting an optional leading `+` or `−` sign.
### :param from_text: The decimal string to parse.
### :returns: The parsed `S16` value.
### :throws: {InvalidValueError} if `from_text` is empty, sign-only, or contains non-digit characters.
### :throws: {IntegerOverflowError} if the value does not fit in `S16`.
@rf("S16")
routine S16!(from_text: Text) -> S16

### Returns a SipHash-2-4 keyed hash of this value.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash suitable for denial-of-service-resistant hash tables.
@rf("S16.hash")
routine S16.hash(k0: U64, k1: U64) -> U64
