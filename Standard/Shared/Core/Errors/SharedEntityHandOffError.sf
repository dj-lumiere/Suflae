module Core

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the crashable raised when a creator hands back an entity something else still reaches: a creator
### makes a new entity, so the one it returns must be its own alone.
@rf("SharedEntityHandOffError")
crashable SharedEntityHandOffError
    ### Names the entity type the creator makes.
    creating: Text

### Returns the default message for a creator that handed back an entity other code still reaches.
### :returns: The resulting `Text` value.
@rf("SharedEntityHandOffError.crash_message")
routine SharedEntityHandOffError.crash_message() -> Text
