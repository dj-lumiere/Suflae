module Core

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the crashable raised when textual or external input cannot be
### interpreted as the requested target type or format.
@rf("InvalidValueError")
crashable InvalidValueError
    ### Stores the original input value that failed conversion.
    input: Text
    ### Stores the textual name of the target type or format.
    target: Text

### Returns the default message for invalid external input.
### :returns: The resulting `Text` value.
@rf("InvalidValueError.crash_message")
routine InvalidValueError.crash_message() -> Text
