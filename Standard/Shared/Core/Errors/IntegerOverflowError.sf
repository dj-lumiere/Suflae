module Core

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the crashable raised when an integer value cannot be represented
### in the requested destination type.
@rf("IntegerOverflowError")
crashable IntegerOverflowError
    pass

### Returns the default message for integer conversion overflow.
### :returns: The resulting `Text` value.
@rf("IntegerOverflowError.crash_message")
routine IntegerOverflowError.crash_message() -> Text
