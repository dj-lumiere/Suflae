module Core

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the protocol for in-place bit shifting.
### `InPlaceShiftable` is for mutable bit-pattern values whose shift operators
### update the current value directly.
@rf("InPlaceShiftable")
protocol InPlaceShiftable
    ### Applies arithmetic left shift in place.
    ### :param amount: The shift amount.
    ### :note: Arithmetic shift semantics follow the conforming type's signed
    ### behavior.
    routine Me.iashl(amount: Integral)
    ### Applies arithmetic right shift in place.
    ### :param amount: The shift amount.
    ### :note: Arithmetic right shift preserves sign semantics where applicable.
    routine Me.iashr(amount: Integral)
    ### Applies logical right shift in place.
    ### :param amount: The shift amount.
    ### :note: Logical right shift fills vacated high bits with zero.
    routine Me.ilshr(amount: Integral)
