module Core

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the protocol for key membership queries: a map answers whether it holds an entry for a key
### (`d have k`, `d.has_key(k)`).
### :typeparam TKey: The key type.
@rf("KeyContainer")
protocol KeyContainer[TKey]
    ### Returns whether this map holds an entry for `key`.
    ### :param key: The key to look for.
    ### :returns: `true` if there is an entry for `key`.
    routine Me.has_key(key: TKey) -> Bool

    ### Returns whether this map holds no entry for `key` (`d lack k`).
    ### :param key: The key to look for.
    ### :returns: `true` if there is no entry for `key`.
    routine Me.lacks_key(key: TKey) -> Bool
