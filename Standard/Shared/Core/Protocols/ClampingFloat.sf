module Core

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the saturating arithmetic surface for floating-style numeric types.
### `ClampingFloat` extends the clamping arithmetic family with division, making
### it the aggregate protocol for fixed-width float types that expose clamped
### operator variants.
@rf("ClampingFloat")
protocol ClampingFloat
obeys ClampingArithmetic, ClampingDivisible
