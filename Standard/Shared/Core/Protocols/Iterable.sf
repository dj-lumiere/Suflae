module Core

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the `Iterable` protocol.
### An iterable value can produce a fresh iterator for use in `for` loops and
### other traversal utilities.
### :typeparam T: The element type yielded during iteration.
@rf("Iterable")
protocol Iterable[T]
relates Iter obeys Emittable[T]
    ### Creates an iterator over this value.
    ### Each call should return an iterator positioned at the start of the sequence.
    ### :returns: The resulting `Emittable[T]` value.
    routine Me.iter() -> Me/Iter
