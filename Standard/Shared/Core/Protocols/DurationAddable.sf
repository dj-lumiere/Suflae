module Core

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the protocol for shifting a value forward by a duration.
### `DurationAddable` is used by temporal types such as moments or schedules
### that can move ahead in time by a concrete `Duration`.
@rf("DurationAddable")
protocol DurationAddable
    ### Returns this value shifted forward by `you`.
    ### :param you: The duration to add.
    ### :returns: The resulting `Me` value.
    routine Me.add(you: Duration) -> Me
