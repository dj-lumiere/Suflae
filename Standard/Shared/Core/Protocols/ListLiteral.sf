module Core

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Opt-in for types constructible from a **list literal** `[a, b, c]`. A conforming type provides a
### `common from_literal(elements...: T)` static routine; the builder lowers `[…]` to
### `Type.from_literal(...)`, packing the elements into a fixed `Array[T, K]`. Analogous to Swift's
### `ExpressibleByArrayLiteral`.
### :typeparam T: The element type accepted by the literal.
@rf("ListLiteral")
protocol ListLiteral[T]
    ### Builds an instance holding exactly `elements`, in order.
    ### :param elements: The literal elements, in order.
    ### :returns: The constructed value.
    common routine Me.from_literal(elements...: T) -> Me
