module Core

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the protocol for membership queries.
### Containers answer whether a candidate value is present according to the
### semantics of the conforming type.
### :typeparam T: The element type tested for membership.
@rf("Container")
protocol Container[T]
    ### Returns whether this value contains `value`.
    ### The exact matching semantics, including equality rules and search scope,
    ### are defined by the conforming type.
    ### :param value: The value to test for membership.
    ### :returns: `true` if the given value is present in this container.
    routine Me.contains(value: T) -> Bool
