module Core

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### The zero-sized void / unit type. `None` signals "there is no meaningful value here" while staying
### type-safe. It is BOTH a value type (the void return / empty payload) AND the canonical variant
### empty branch — one name for "nothing".
@rf("None")
record None
obeys Copyable
    pass

### Returns the display form of `None`.
### :returns: The resulting `Text` value.
@rf("None.represent")
routine None.represent() -> Text

### Returns the diagnostic form of `None`.
### For this type, the display and diagnostic forms are identical.
### :returns: The resulting `Text` value.
@rf("None.diagnose")
routine None.diagnose() -> Text
