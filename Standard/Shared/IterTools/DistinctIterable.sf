module IterTools

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents a lazy adapter that suppresses duplicate values from a source iterable.
### Two values are considered equal when they produce the same hash and compare as equal.
### :typeparam T: The element type of the source sequence.
### :typeparam TSource: The concrete source iterable type (borrowed; enables build-time dispatch).
@rf("DistinctIterable")
entity DistinctIterable[T, TSource]
relates DistinctEmittable[T, TSource/Iter] as Iter
obeys Iterable[T]
needs TSource obeys Iterable[T]
    pass

### Iterates over a source sequence while suppressing values already produced.
### :typeparam T: The element type of the source sequence.
### :typeparam TSourceIter: The concrete source iterator type (owned).
@rf("DistinctEmittable")
entity DistinctEmittable[T, TSourceIter]
obeys Emittable[T]
needs TSourceIter obeys Emittable[T]
    pass

### Represents a lazy adapter that suppresses elements whose key has already been seen.
### Two elements are considered duplicates when their computed keys produce the same hash
### and compare as equal.
### :typeparam T: The source element type.
### :typeparam TKey: The key type used for equality comparison.
### :typeparam TSource: The concrete source iterable type (borrowed).
@rf("DistinctByIterable")
entity DistinctByIterable[T, TKey, TSource]
relates DistinctByEmittable[T, TKey, TSource/Iter] as Iter
obeys Iterable[T]
needs TSource obeys Iterable[T]
    pass

### Iterates over a source sequence while suppressing elements whose key has already been produced.
### :typeparam T: The source element type.
### :typeparam TKey: The key type used for equality comparison.
### :typeparam TSourceIter: The concrete source iterator type (owned).
@rf("DistinctByEmittable")
entity DistinctByEmittable[T, TKey, TSourceIter]
obeys Emittable[T]
needs TSourceIter obeys Emittable[T]
    pass

### Returns the stateful iterator that tracks already-seen values across calls.
### :returns: The resulting `DistinctEmittable[T, TSource/Iter]` value.
@rf("DistinctIterable.iter")
routine DistinctIterable[T, TSource].iter() -> DistinctEmittable[T, TSource/Iter]
needs T obeys Hashable, Comparable

### Returns the next value not yet yielded by this iterator.
### Source values that have already been seen are discarded until a new one is found.
### :returns: The resulting `T` value.
@rf("DistinctEmittable.emit")
routine DistinctEmittable[T, TSourceIter].emit!() -> TSourceIter/Item
needs T obeys Hashable, Comparable

### Returns a lazy adapter that suppresses duplicate values.
### :returns: The resulting `DistinctIterable[T, Me]` value.
@rf("Iterable.distinct")
routine Iterable[T].distinct() -> DistinctIterable[T, Me]
needs T obeys Hashable, Comparable

### Returns the stateful iterator that tracks already-seen keys across calls.
### :returns: The resulting `DistinctByEmittable[T, TKey, TSource/Iter]` value.
@rf("DistinctByIterable.iter")
routine DistinctByIterable[T, TKey, TSource].iter() -> DistinctByEmittable[T, TKey, TSource/Iter]
needs TKey obeys Hashable, Comparable

### Returns the next element whose key has not yet been yielded.
### Elements are consumed and discarded until one with a fresh key is found.
### :returns: The resulting `T` value.
@rf("DistinctByEmittable.emit")
routine DistinctByEmittable[T, TKey, TSourceIter].emit!() -> TSourceIter/Item
needs TKey obeys Hashable, Comparable

### Returns a lazy adapter that suppresses elements whose computed key has already appeared.
### :param key: The routine that extracts the comparison key from each element.
### :returns: The resulting `DistinctByIterable[T, TKey, Me]` value.
@rf("Iterable.distinct_by")
routine Iterable[T].distinct_by[TKey](key: Routine[(T,), TKey]) -> DistinctByIterable[T, TKey, Me]
needs TKey obeys Hashable, Comparable
