module IterTools

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents a lazy adapter that pairs elements from two sources into tuples.
### Iteration stops as soon as either source is exhausted.
### :typeparam TFirst: The element type of the first source sequence.
### :typeparam TSecond: The element type of the second source sequence.
### :typeparam TFirstSource: The concrete first source iterable type (referenced, not owned).
### :typeparam TSecondSource: The concrete second source iterable type (referenced, not owned).
@rf("ZipIterable")
entity ZipIterable[TFirst, TSecond, TFirstSource, TSecondSource]
relates ZipEmittable[TFirst, TSecond, TFirstSource/Iter, TSecondSource/Iter] as Iter
obeys Iterable[Tuple[TFirst, TSecond]]
needs TFirstSource obeys Iterable[TFirst]
needs TSecondSource obeys Iterable[TSecond]
    pass

### Iterates over two source sequences simultaneously, pairing one element from each.
### Iteration ends when either source is exhausted.
### :typeparam TFirst: The element type of the first source.
### :typeparam TSecond: The element type of the second source.
### :typeparam TFirstIter: The concrete first source iterator type (referenced, not owned).
### :typeparam TSecondIter: The concrete second source iterator type (referenced, not owned).
@rf("ZipEmittable")
entity ZipEmittable[TFirst, TSecond, TFirstIter, TSecondIter]
obeys Emittable[Tuple[TFirst, TSecond]]
needs TFirstIter obeys Emittable[TFirst]
needs TSecondIter obeys Emittable[TSecond]
    pass

### Represents a lazy adapter that pairs elements from three sources into triples.
### Iteration stops as soon as any source is exhausted.
### :typeparam TFirst: The element type of the first source sequence.
### :typeparam TSecond: The element type of the second source sequence.
### :typeparam TThird: The element type of the third source sequence.
### :typeparam TFirstSource: The concrete first source iterable type (referenced, not owned).
### :typeparam TSecondSource: The concrete second source iterable type (referenced, not owned).
### :typeparam TThirdSource: The concrete third source iterable type (referenced, not owned).
@rf("Zip3Iterable")
entity Zip3Iterable[TFirst, TSecond, TThird, TFirstSource, TSecondSource, TThirdSource]
relates Zip3Emittable[TFirst, TSecond, TThird, TFirstSource/Iter, TSecondSource/Iter, TThirdSource/Iter] as Iter
obeys Iterable[Tuple[TFirst, TSecond, TThird]]
needs TFirstSource obeys Iterable[TFirst]
needs TSecondSource obeys Iterable[TSecond]
needs TThirdSource obeys Iterable[TThird]
    pass

### Iterates over three source sequences simultaneously, pairing one element from each.
### Iteration ends when any source is exhausted.
### :typeparam TFirst: The element type of the first source.
### :typeparam TSecond: The element type of the second source.
### :typeparam TThird: The element type of the third source.
### :typeparam TFirstIter: The concrete first source iterator type (referenced, not owned).
### :typeparam TSecondIter: The concrete second source iterator type (referenced, not owned).
### :typeparam TThirdIter: The concrete third source iterator type (referenced, not owned).
@rf("Zip3Emittable")
entity Zip3Emittable[TFirst, TSecond, TThird, TFirstIter, TSecondIter, TThirdIter]
obeys Emittable[Tuple[TFirst, TSecond, TThird]]
needs TFirstIter obeys Emittable[TFirst]
needs TSecondIter obeys Emittable[TSecond]
needs TThirdIter obeys Emittable[TThird]
    pass

### Represents a lazy adapter that pairs elements from four sources into quadruples.
### Iteration stops as soon as any source is exhausted.
### :typeparam TFirst: The element type of the first source sequence.
### :typeparam TSecond: The element type of the second source sequence.
### :typeparam TThird: The element type of the third source sequence.
### :typeparam TFourth: The element type of the fourth source sequence.
### :typeparam TFirstSource: The concrete first source iterable type (referenced, not owned).
### :typeparam TSecondSource: The concrete second source iterable type (referenced, not owned).
### :typeparam TThirdSource: The concrete third source iterable type (referenced, not owned).
### :typeparam TFourthSource: The concrete fourth source iterable type (referenced, not owned).
@rf("Zip4Iterable")
entity Zip4Iterable[TFirst, TSecond, TThird, TFourth, TFirstSource, TSecondSource, TThirdSource, TFourthSource]
relates Zip4Emittable[TFirst, TSecond, TThird, TFourth, TFirstSource/Iter, TSecondSource/Iter, TThirdSource/Iter, TFourthSource/Iter] as Iter
obeys Iterable[Tuple[TFirst, TSecond, TThird, TFourth]]
needs TFirstSource obeys Iterable[TFirst]
needs TSecondSource obeys Iterable[TSecond]
needs TThirdSource obeys Iterable[TThird]
needs TFourthSource obeys Iterable[TFourth]
    pass

### Iterates over four source sequences simultaneously, pairing one element from each.
### Iteration ends when any source is exhausted.
### :typeparam TFirst: The element type of the first source.
### :typeparam TSecond: The element type of the second source.
### :typeparam TThird: The element type of the third source.
### :typeparam TFourth: The element type of the fourth source.
### :typeparam TFirstIter: The concrete first source iterator type (referenced, not owned).
### :typeparam TSecondIter: The concrete second source iterator type (referenced, not owned).
### :typeparam TThirdIter: The concrete third source iterator type (referenced, not owned).
### :typeparam TFourthIter: The concrete fourth source iterator type (referenced, not owned).
@rf("Zip4Emittable")
entity Zip4Emittable[TFirst, TSecond, TThird, TFourth, TFirstIter, TSecondIter, TThirdIter, TFourthIter]
obeys Emittable[Tuple[TFirst, TSecond, TThird, TFourth]]
needs TFirstIter obeys Emittable[TFirst]
needs TSecondIter obeys Emittable[TSecond]
needs TThirdIter obeys Emittable[TThird]
needs TFourthIter obeys Emittable[TFourth]
    pass

### Returns the stateful iterator that produces paired tuples lazily.
### :returns: The resulting `ZipEmittable[TFirst, TSecond, TFirstSource/Iter, TSecondSource/Iter]` value.
@rf("ZipIterable.iter")
routine ZipIterable[TFirst, TSecond, TFirstSource, TSecondSource].iter() -> ZipEmittable[TFirst, TSecond, TFirstSource/Iter, TSecondSource/Iter]

### Returns the next paired tuple from both source iterators.
### Propagates absence as soon as either source is exhausted.
### :returns: The resulting `Tuple[TFirst, TSecond]` value.
@rf("ZipEmittable.emit")
routine ZipEmittable[TFirst, TSecond, TFirstIter, TSecondIter].emit!() -> Tuple[TFirst, TSecond]

### Returns the stateful iterator that produces paired triples lazily.
### :returns: The resulting `Zip3Emittable[TFirst, TSecond, TThird, TFirstSource/Iter, TSecondSource/Iter, TThirdSource/Iter]` value.
@rf("Zip3Iterable.iter")
routine Zip3Iterable[TFirst, TSecond, TThird, TFirstSource, TSecondSource, TThirdSource].iter() -> Zip3Emittable[TFirst, TSecond, TThird, TFirstSource/Iter, TSecondSource/Iter, TThirdSource/Iter]

### Returns the next paired triple from all three source iterators.
### Propagates absence as soon as any source is exhausted.
### :returns: The resulting `Tuple[TFirst, TSecond, TThird]` value.
@rf("Zip3Emittable.emit")
routine Zip3Emittable[TFirst, TSecond, TThird, TFirstIter, TSecondIter, TThirdIter].emit!() -> Tuple[TFirst, TSecond, TThird]

### Returns the stateful iterator that produces paired quadruples lazily.
### :returns: The resulting `Zip4Emittable[...]` value.
@rf("Zip4Iterable.iter")
routine Zip4Iterable[TFirst, TSecond, TThird, TFourth, TFirstSource, TSecondSource, TThirdSource, TFourthSource].iter() -> Zip4Emittable[TFirst, TSecond, TThird, TFourth, TFirstSource/Iter, TSecondSource/Iter, TThirdSource/Iter, TFourthSource/Iter]

### Returns the next paired quadruple from all four source iterators.
### Propagates absence as soon as any source is exhausted.
### :returns: The resulting `Tuple[TFirst, TSecond, TThird, TFourth]` value.
@rf("Zip4Emittable.emit")
routine Zip4Emittable[TFirst, TSecond, TThird, TFourth, TFirstIter, TSecondIter, TThirdIter, TFourthIter].emit!() -> Tuple[TFirst, TSecond, TThird, TFourth]
