module IterTools

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Returns the first value produced by this iterable.
### This is a convenience terminal operation over the first iterator element.
### :returns: The resulting `T` value.
@rf("Iterable.first")
routine Iterable[T].first!() -> T

### Returns the last value produced by this iterable.
### The iterable is consumed fully in order to find the final element.
### :returns: The resulting `T` value.
@rf("Iterable.last")
routine Iterable[T].last!() -> T

### Returns `true` when any produced value satisfies `predicate`.
### Iteration stops as soon as a matching value is found.
### :param predicate: The predicate to test against each item.
### :returns: The resulting `Bool` value.
@rf("Iterable.any")
routine Iterable[T].any(predicate: Routine[(T,), Bool]) -> Bool

### Returns `true` when every produced value satisfies `predicate`.
### Iteration stops as soon as a failing value is found.
### :param predicate: The predicate to test against each item.
### :returns: The resulting `Bool` value.
@rf("Iterable.all")
routine Iterable[T].all(predicate: Routine[(T,), Bool]) -> Bool

### Folds this iterable into a single result value.
### The combiner receives the current accumulator and the next item in iteration
### order.
### :param start: The initial accumulator value.
### :param combiner: The routine used to produce the next accumulator value.
### :returns: The resulting `TState` value.
@rf("Iterable.accumulate")
routine Iterable[T].accumulate[TState](
    start: TState,
    combiner: Routine[(TState, T), TState],
) -> TState

### Returns the sum of all values in this iterable.
### The first element is used as the initial accumulator; subsequent elements are added to it.
### :returns: The resulting `T` value.
@rf("Iterable.sum")
routine Iterable[T].sum!() -> T
needs T obeys Addable

### Returns the smallest value in this iterable.
### :returns: The resulting `T` value.
@rf("Iterable.min")
routine Iterable[T].min!() -> T
needs T obeys Comparable

### Returns the largest value in this iterable.
### :returns: The resulting `T` value.
@rf("Iterable.max")
routine Iterable[T].max!() -> T
needs T obeys Comparable

### Returns the element for which `selector` returns the smallest key.
### :param selector: The routine that extracts a comparable key from each element.
### :returns: The resulting `T` value.
@rf("Iterable.min_by")
routine Iterable[T].min_by![TKey](selector: Routine[(T,), TKey]) -> T
needs TKey obeys Comparable

### Returns the element for which `selector` returns the largest key.
### :param selector: The routine that extracts a comparable key from each element.
### :returns: The resulting `T` value.
@rf("Iterable.max_by")
routine Iterable[T].max_by![TKey](selector: Routine[(T,), TKey]) -> T
needs TKey obeys Comparable

### Returns the first value produced by this iterable, or `default` when the iterable is empty.
### :param default: The value to return when the iterable yields nothing.
### :returns: The resulting `T` value.
@rf("Iterable.first_or_default")
routine Iterable[T].first_or_default(default: T) -> T

### Returns the last value produced by this iterable, or `default` when the iterable is empty.
### :param default: The value to return when the iterable yields nothing.
### :returns: The resulting `T` value.
@rf("Iterable.last_or_default")
routine Iterable[T].last_or_default(default: T) -> T

### Joins the produced `Text` values into a single `Text`, inserting `separator`
### between successive parts. The separator is not added before the first or
### after the last element.
### :param separator: The text inserted between successive parts.
### :returns: The resulting `Text` value.
@rf("Iterable.join")
routine Iterable[Text].join(separator: Text) -> Text
