module IterTools

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents a lazy adapter that discards the first `count` elements from a sequence.
### :typeparam T: The element type produced by the source sequence.
### :typeparam TSource: The concrete source iterable type (borrowed; enables build-time dispatch).
@rf("SkipIterable")
entity SkipIterable[T, TSource]
relates SkipEmittable[T, TSource/Iter] as Iter
obeys Iterable[T]
needs TSource obeys Iterable[T]
    pass

### Iterates over a source sequence after discarding an initial prefix.
### :typeparam T: The element type produced by the source sequence.
### :typeparam TSourceIter: The concrete source iterator type (owned).
@rf("SkipEmittable")
entity SkipEmittable[T, TSourceIter]
obeys Emittable[T]
needs TSourceIter obeys Emittable[T]
    pass

### Returns the stateful iterator that discards the configured prefix lazily.
### The returned emitter defers the actual skipping until iteration begins.
### :returns: The resulting `SkipEmittable[T, TSource/Iter]` value.
@rf("SkipIterable.iter")
routine SkipIterable[T, TSource].iter() -> SkipEmittable[T, TSource/Iter]

### Returns the next value after any remaining skipped prefix has been consumed.
### Values are discarded only until `remaining` reaches zero.
### :returns: The resulting `T` value.
@rf("SkipEmittable.emit")
routine SkipEmittable[T, TSourceIter].emit!() -> TSourceIter/Item
