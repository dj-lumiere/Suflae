module IO/Environment

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### The operating system's environment of this program: its arguments, its environment variables, and its working,
### home and temporary directories. Its routines are called on the type (`OsEnvironment.arguments()`), and they only
### read.
@rf("OsEnvironment")
record OsEnvironment
    pass

### The arguments the program was started with, its own name left out.
### :returns: The arguments, in order.
@rf("OsEnvironment.arguments")
common routine OsEnvironment.arguments() -> List[Text]

### The value of the environment variable `name`, asked of the operating system now (on Windows the name's case
### doesn't matter).
### :param name: The variable's name.
### :returns: Its value.
### :throws: {AbsentValueError} when it isn't set (`try OsEnvironment.variable(name:)` gives a `Maybe`).
@rf("OsEnvironment.variable")
failable common routine OsEnvironment.variable(name: Text) -> Text

### Every environment variable with its value, as the operating system has them now: a copy, which changes nothing
### when it changes.
### :returns: The variables by name.
@rf("OsEnvironment.to")
common routine OsEnvironment.to[Dict[Text, Text]]() -> Dict[Text, Text]

### The program's working directory, which relative paths start from.
### :returns: The resulting `Directory`.
### :throws: {IOError} when the working directory cannot be read.
@rf("OsEnvironment.working_directory")
failable common routine OsEnvironment.working_directory() -> Directory

### The current user's home directory.
### :returns: The resulting `Directory`.
### :throws: {NotFoundError} when the home directory cannot be told.
@rf("OsEnvironment.home_directory")
failable common routine OsEnvironment.home_directory() -> Directory

### The platform's temporary directory. Honors the usual environment variables, never fails.
### :returns: The resulting `Directory`.
@rf("OsEnvironment.temp_directory")
common routine OsEnvironment.temp_directory() -> Directory
