module Math3D

# Each declaration below creates nothing: `@rf` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### A 4x4 matrix of `B32`, stored as four column vectors (column-major).
@rf("Matrix4R4C")
record Matrix4R4C
obeys Addable, Subtractable, Multiplicable, Negatable, Equatable
    ### Column 0.
    c0: Vector[B32, 4]
    ### Column 1.
    c1: Vector[B32, 4]
    ### Column 2.
    c2: Vector[B32, 4]
    ### Column 3.
    c3: Vector[B32, 4]

### Builds a `Vector[B32, 4]` from its four lanes (no bounds-checked setitem — uses
### the raw `insert_element` intrinsic, like the SIMD splat constructor).
### :param x: Lane 0.
### :param y: Lane 1.
### :param z: Lane 2.
### :param w: Lane 3.
### :returns: The packed 4-lane vector `<x, y, z, w>`.
@rf("vec4")
routine vec4(x: B32, y: B32, z: B32, w: B32) -> Vector[B32, 4]

### The 4x4 identity matrix.
### :returns: A matrix with ones on the diagonal, zeros elsewhere.
@rf("Matrix4R4C.identity")
common routine Matrix4R4C.identity() -> Matrix4R4C

### The 4x4 zero matrix (every element zero).
### :returns: A matrix of all zeros.
@rf("Matrix4R4C.zero")
common routine Matrix4R4C.zero() -> Matrix4R4C

### An affine translation matrix.
### :param tx: X translation.
### :param ty: Y translation.
### :param tz: Z translation.
### :returns: The translation matrix (identity with `(tx, ty, tz)` in column 3).
@rf("Matrix4R4C.translation")
common routine Matrix4R4C.translation(tx: B32, ty: B32, tz: B32) -> Matrix4R4C

### A non-uniform scaling matrix.
### :param sx: X scale.
### :param sy: Y scale.
### :param sz: Z scale.
### :returns: The scaling matrix.
@rf("Matrix4R4C.scaling")
common routine Matrix4R4C.scaling(sx: B32, sy: B32, sz: B32) -> Matrix4R4C

### A right-handed rotation about the X axis.
### :param angle: The rotation angle in radians.
### :returns: The rotation matrix.
@rf("Matrix4R4C.rotation_x")
common routine Matrix4R4C.rotation_x(angle: B32) -> Matrix4R4C

### A right-handed rotation about the Y axis.
### :param angle: The rotation angle in radians.
### :returns: The rotation matrix.
@rf("Matrix4R4C.rotation_y")
common routine Matrix4R4C.rotation_y(angle: B32) -> Matrix4R4C

### A right-handed rotation about the Z axis.
### :param angle: The rotation angle in radians.
### :returns: The rotation matrix.
@rf("Matrix4R4C.rotation_z")
common routine Matrix4R4C.rotation_z(angle: B32) -> Matrix4R4C

### A rotation matrix from a (unit) quaternion.
### :param q: The rotation quaternion (assumed normalized).
### :returns: The equivalent rotation matrix.
@rf("Matrix4R4C.from_quaternion")
common routine Matrix4R4C.from_quaternion(q: Q128) -> Matrix4R4C

### Returns column `index` (0 to 3) as a `Vector[B32, 4]`.
### :param index: The column index.
### :returns: The column vector.
@rf("Matrix4R4C.column")
routine Matrix4R4C.column(index: U64) -> Vector[B32, 4]

### Returns the element at `(row, col)` (both 0 to 3).
### :param row: The row index.
### :param col: The column index.
### :returns: The scalar element.
@rf("Matrix4R4C.get")
routine Matrix4R4C.get(row: U64, col: U64) -> B32

### Returns row `index` (0 to 3) as a `Vector[B32, 4]` — the `me[index]` read operator. Chained subscripts
### read naturally as `m[row][col]`: `m[row]` yields the row vector (gathered across the stored columns),
### and the second subscript picks the column element via `Vector`'s own `getitem`.
### :param index: The row index (0 to 3).
### :returns: The row vector `<m(row,0), m(row,1), m(row,2), m(row,3)>`.
### :throws: {IndexOutOfBoundsError} if `index >= 4`.
@rf("Matrix4R4C.getitem")
routine Matrix4R4C.getitem!(index: U64) -> Vector[B32, 4]

### Element-wise matrix sum.
### :param you: The matrix to add.
### :returns: `me + you`.
@rf("Matrix4R4C.add")
routine Matrix4R4C.add(you: Matrix4R4C) -> Matrix4R4C

### Element-wise matrix difference.
### :param you: The matrix to subtract.
### :returns: `me - you`.
@rf("Matrix4R4C.sub")
routine Matrix4R4C.sub(you: Matrix4R4C) -> Matrix4R4C

### Element-wise negation.
### :returns: `-me`.
@rf("Matrix4R4C.neg")
routine Matrix4R4C.neg() -> Matrix4R4C

### Scales every element by a scalar.
### :param factor: The scalar multiplier.
### :returns: `factor · me`.
@rf("Matrix4R4C.scale")
routine Matrix4R4C.scale(factor: B32) -> Matrix4R4C

### Transforms a homogeneous vector: `me · v` (matrix times column vector).
### :param v: The vector to transform.
### :returns: `me · v`, computed as `c0·v.x + c1·v.y + c2·v.z + c3·v.w`.
@rf("Matrix4R4C.transform")
routine Matrix4R4C.transform(v: Vector[B32, 4]) -> Vector[B32, 4]

### Matrix product `me · you`. Each result column is `me · you.column`.
### :param you: The right-hand matrix.
### :returns: `me · you`.
@rf("Matrix4R4C.mul")
routine Matrix4R4C.mul(you: Matrix4R4C) -> Matrix4R4C

### The transpose (rows and columns swapped).
### :returns: `meᵀ`.
@rf("Matrix4R4C.transpose")
routine Matrix4R4C.transpose() -> Matrix4R4C

### The determinant of this matrix.
### :returns: `det(me)`.
@rf("Matrix4R4C.determinant")
routine Matrix4R4C.determinant() -> B32

### The inverse of this matrix. A singular matrix (determinant 0) yields the zero
### matrix.
### :returns: `me⁻¹`, or the zero matrix if `me` is singular.
@rf("Matrix4R4C.inverse")
routine Matrix4R4C.inverse() -> Matrix4R4C

### Returns `true` when all sixteen elements compare equal.
### :param you: The matrix to compare against.
### :returns: `true` if every column matches.
@rf("Matrix4R4C.eq")
routine Matrix4R4C.eq(you: Matrix4R4C) -> Bool

### Formats the matrix row by row as `[[…], [-…], …]`.
### :returns: The resulting `Text` value.
@rf("Matrix4R4C.represent")
routine Matrix4R4C.represent() -> Text

### Returns a diagnostic string wrapping the value with its type name.
### :returns: The resulting `Text` value.
@rf("Matrix4R4C.diagnose")
routine Matrix4R4C.diagnose() -> Text
