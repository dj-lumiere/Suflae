module IterTools

# Suflae's surface of the emittable terminals and adapters that count: counts are `Int`, and the
# collections they build are Suflae's own. A Suflae program calls these in place of the RazorForge routines of
# the same names.

### Collects the values into a list, in order.
routine Emittable[T].to[List[T]]() -> List[T]
    var result = List[T]()
    each item in me
        result.add_last(value: item)
    return result

### Collects the values into a set. A repeated value is kept once.
routine Emittable[T].to[Set[T]]() -> Set[T]
needs T obeys Hashable, Equatable
    var result = Set[T]()
    each item in me
        result.add(value: item)
    return result

### Collects `(key, value)` pairs into a dict, in order: a later pair whose key is there already replaces its value.
routine Emittable[Tuple[TKey, TValue]].to[Dict[TKey, TValue]]() -> Dict[TKey, TValue]
needs TKey obeys Hashable, Equatable
    var result = Dict[TKey, TValue]()
    each item in me
        var pair: Tuple[TKey, TValue] = item
        result[pair.item0] = pair.item1
    return result

### Collects the values into an `Array[T, N]`, in order. The bracket names the size: `xs.to[Array[Int, 3]]()`.
### :throws: {ElementCountMismatchError} There are fewer or more than `N` values.
failable routine Emittable[T].to[Array[T, N]]() -> Array[T, N]
needs U64 N
needs RecordType T
    var result = Array[T, N]()
    var filled: U64 = 0
    each item in me
        if filled >= N
            throw ElementCountMismatchError(expected: N, found: N + 1)
        result.put(position: filled, value: item)
        filled = filled + 1
    if filled < N
        throw ElementCountMismatchError(expected: N, found: filled)
    return result

### Returns how many values there are.
routine Emittable[T].get_count() -> Int
    return me.get_count().to[Int]()

### Returns how many values satisfy `predicate`.
### :param predicate: The test applied to each value.
routine Emittable[T].get_count(predicate: failable Callable[(T,), Bool]) -> Int
    return me.get_count(predicate: predicate).to[Int]()

### Returns the values after the first `count`.
### :param count: How many values to leave out.
routine Emittable[T].skip(count: Int) -> SkipEmittable[T, Me]
    return me.skip(count: position_of(value: count))

### Returns the first `count` values.
### :param count: How many values to keep.
routine Emittable[T].take(count: Int) -> TakeEmittable[T, Me]
    return me.take(count: position_of(value: count))
