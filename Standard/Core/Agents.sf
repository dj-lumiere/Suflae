module Core

import Numerics

# Suflae's own Agent: work an `agent` call has bound to its arguments, shared like any Suflae entity. It drives the work through the shared Core agent held inside, so every holder of the Agent sees
# the same work: run once, consumed once. Structured concurrency over Suflae's own list of Agents (`race`, `gather`,
# `cancel_all`) works on that list directly.

### Work an `agent` call has bound to its arguments. Nothing runs until a verb runs it: `start_now` starts it in
### the background, `retrieve` waits for its value (starting it first if nothing has).
### :typeparam T: The value the routine returns.
entity Agent[T]
    ### The shared Core agent that drives the work.
    secret work: RF::Core.Agent[T]

# ============================================================================
# Builder plumbing
# ============================================================================

### Builds the Agent of an `agent` call: the work that will run `entry(recipe)`, not started.
routine agent_recipe[T](entry: CPtr, recipe: Address) -> Agent[T]
    danger
        return Agent[T](work: agent_recipe[T](entry: entry, recipe: recipe))

# ============================================================================
# Running one Agent
# ============================================================================

### Waits for the work's value, starting it first if nothing has. Inside another agent it parks, so other agents
### keep running.
### :throws: {TaskSpawnError} if the work could not be started.
### :throws: {TaskTimeoutError} if a deadline was set with `waitfor` and passed first.
### :returns: The value the routine returned.
routine Agent[T].retrieve!() -> T
    return me.work.retrieve()

### Starts the work now and returns at once. Collect its value later with `retrieve` or `gather`.
### :throws: {AgentStartError} if the work was started already.
### :throws: {TaskSpawnError} if the work could not be started.
routine Agent[T].start_now!()
    me.work.start_now()
    return

### The same work with a deadline: its `retrieve` waits at most `deadline` and crashes with
### {TaskTimeoutError} past it (`agent.waitfor(5s).retrieve()`).
### :param deadline: The longest `retrieve` waits.
### :returns: An Agent over the same work, carrying the deadline.
routine Agent[T].waitfor(deadline: Duration) -> Agent[T]
    return Agent[T](work: me.work.waitfor(deadline: deadline))

### Whether the work has finished, or was never started and cannot start.
routine Agent[T].is_done() -> Bool
    return me.work.is_done()

### Whether the work was started and has not finished yet.
routine Agent[T].is_running() -> Bool
    return me.work.is_running()

### Starts the work if it has not started yet.
### :returns: `false` if it could not start.
secret routine Agent[T].launch() -> Bool
    danger
        return me.work.launch()

### Asks the work to stop. Work nothing started yet never runs. Running work sees the request at its next wait
### (`waitfor`, `retrieve`) or through `cancellation_requested()`, and stops there. Retrieving a cancelled Agent waits
### for it to stop, then throws {CancelRequested}.
routine Agent[T].cancel()
    me.work.cancel()
    return

### Waits for cancelled work to stop and frees what ran it, dropping what it came to.
secret routine Agent[T].wind_down()
    danger
        me.work.wind_down()
    return

### Enters the work in a race.
secret routine Agent[T].join_race(race: CPtr)
    danger
        if me.work.is_coro()
            C::rf_race_add_coro(race: race, coro: me.work.coro_handle())
        else
            C::rf_race_add_task(race: race, task: me.work.task_handle())
    return

### The value the finished work produced, or its failure thrown here. A cancelled Agent throws
### {CancelRequested}.
secret routine Agent[T].result!() -> T
    return me.work.settle()

### Frees the work once nothing will read it again.
secret routine Agent[T].reap()
    danger
        me.work.reap()
    return

# ============================================================================
# Running a list of Agents
# ============================================================================

### Races the Agents, driving them concurrently until the first one finishes, and returns that winner's
### value, or throws its failure. Every Agent of the list is freed afterwards, the losers too.
### :throws: {TaskSpawnError} if the list is empty (there is nothing to race) or an Agent cannot be started.
### :returns: The value produced by the first Agent to finish.
routine List[Agent[T]].race!() -> T
    if me.is_empty()
        throw TaskSpawnError()
    danger
        var race = C::rf_race_begin()
        each job in me
            if not job.launch()
                throw TaskSpawnError()
            job.join_race(race: race)
        var winner = Integer(from: C::rf_race_wait(race: race))
        C::rf_race_end(race: race)
        var value = me[winner].result()
        each job in me
            job.reap()
        return value

### Drives the Agents concurrently and waits for all of them, returning their results in the list's order.
### The total wait is the slowest Agent, not the sum. If an Agent throws, the throw comes out here.
### :throws: {TaskSpawnError} if an Agent cannot be started.
### :returns: The values produced by every Agent, in the order they appear in the list.
routine List[Agent[T]].gather!() -> List[T]
    # Start every Agent first so they run together, then collect each.
    each job in me
        if not job.launch()
            throw TaskSpawnError()
    var results = List[T]()
    each job in me
        results.add_last(value: job.retrieve())
    return results

### Cancels every Agent and waits for each to stop, dropping what it came to. Work nothing started yet never
### runs. Running work sees the request at its next wait or through `cancellation_requested()`.
routine List[Agent[T]].cancel_all()
    each job in me
        job.cancel()
    each job in me
        job.wind_down()
    return
