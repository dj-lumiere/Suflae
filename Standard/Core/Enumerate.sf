module Core

import Numerics

### The values of an iterable, each paired with its position: `each (i, x) in xs.enumerate()`.
### :typeparam T: The value type.
### :typeparam S: The iterable.
entity EnumerateIterable[T, S]
relates EnumerateEmittable[T, S/Iter] as Iter
obeys Iterable[Tuple[Integer, T]]
needs S obeys Iterable[T]
    ### The iterable (borrowed, not owned).
    secret source: Hijacked[S]
    ### The position of the first value.
    secret start_index: Integer

### Walks an `EnumerateIterable`.
### :typeparam T: The value type.
### :typeparam SE: The iterator of the source.
entity EnumerateEmittable[T, SE]
obeys Emittable[Tuple[Integer, T]]
needs SE obeys Emittable[T]
    ### The iterator over the source (owned).
    secret source: SE
    ### The position of the next value.
    secret index: Integer

### Returns a walk over the pairs.
@readonly
routine EnumerateIterable[T, S].iter() -> EnumerateEmittable[T, S/Iter]
    danger
        return EnumerateEmittable[T, S/Iter](
            source: me.source.as_entity().iter(),
            index: me.start_index,
        )

### Returns the next pair.
### :absent: The source has no more values.
routine EnumerateEmittable[T, SE].emit!() -> Tuple[Integer, T]
    var position = me.index
    me.index = me.index + Integer(from: 1u64)
    # The value goes into the pair straight from the source, so the pair is its only holder.
    return (position, me.source.emit())

### Returns the values paired with their positions, from 0.
@readonly
routine Iterable[T].enumerate() -> EnumerateIterable[T, Me]
    danger
        return EnumerateIterable[T, Me](source: me.hijack(), start_index: Integer(from: 0u64))

### Returns the values paired with their positions, from `start`.
### :param start: The position of the first value.
@readonly
routine Iterable[T].enumerate(start: Integer) -> EnumerateIterable[T, Me]
    danger
        return EnumerateIterable[T, Me](source: me.hijack(), start_index: start)
