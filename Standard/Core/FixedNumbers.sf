### Renders this value in base `radix` (2 to 36), digits past 9 as lowercase letters, with a leading `-`
### when negative (`255.to_text(radix: 16)` is `ff`).
### :param radix: The numeric base.
### :returns: The rendered `Text`.
@readonly
routine S32.to_text(radix: Integer) -> Text
    return me.to_text(radix: S32(from: S64(from: radix)))

### Returns the number of bits set to one (popcount).
### :returns: The count of set bits in the 64-bit representation.
routine S64.count_ones() -> Integer
    return Integer(from: me.count_ones())

### Returns the number of bits set to zero.
### :returns: `64` minus the popcount.
routine S64.count_zeros() -> Integer
    return Integer(from: me.count_zeros())

### Returns the number of consecutive zero bits before the highest set bit.
### :returns: The leading zero count; `64` if the value is zero.
routine S64.leading_zeros() -> Integer
    return Integer(from: me.leading_zeros())

### Returns the number of consecutive zero bits starting from the least significant bit.
### :returns: The trailing zero count; `64` if the value is zero.
routine S64.trailing_zeros() -> Integer
    return Integer(from: me.trailing_zeros())

### Returns the number of consecutive one bits before the highest clear bit.
### :returns: The leading one count.
routine S64.leading_ones() -> Integer
    return Integer(from: me.leading_ones())

### Returns the number of consecutive one bits starting from the least significant bit.
### :returns: The trailing one count.
routine S64.trailing_ones() -> Integer
    return Integer(from: me.trailing_ones())

### Returns the sign of this value as −1, 0, or 1.
### :returns: `1` if positive, `−1` if negative, `0` if zero.
routine S64.signum() -> Integer
    return Integer(from: me.signum())

### Returns ⌊log₂ me⌋. Throws if `me <= 0`.
### :returns: The floor of the base-2 logarithm.
### :throws: {NumericDomainError} if `me <= 0`.
routine S64.ilog2!() -> Integer
    return Integer(from: me.ilog2())

### Returns ⌊log₁₀ me⌋. Throws if `me <= 0`.
### :returns: The floor of the base-10 logarithm.
### :throws: {NumericDomainError} if `me <= 0`.
routine S64.ilog10!() -> Integer
    return Integer(from: me.ilog10())

### Left-shifts this value by `bits` positions, filling vacated bits with zero. Shifting by
### 64 or more gives 0.
### :param bits: The number of bit positions to shift left.
### :returns: `me << bits`.
routine S64.ashl(bits: Integer) -> S64
    return me.ashl(bits: U32(from: U64(from: bits)))

### Right-shifts this value by `bits` positions, copying the sign bit into vacated positions
### (arithmetic shift right). Shifting by 64 or more gives -1 for a negative value, else 0.
### :param bits: The number of bit positions to shift right.
### :returns: `me >> bits`.
routine S64.ashr(bits: Integer) -> S64
    return me.ashr(bits: U32(from: U64(from: bits)))

### Right-shifts this value by `bits` positions, filling vacated bits with zero regardless of
### sign (logical shift right). Shifting by 64 or more gives 0.
### :param bits: The number of bit positions to shift right.
### :returns: `me >>> bits`.
routine S64.lshr(bits: Integer) -> S64
    return me.lshr(bits: U32(from: U64(from: bits)))

### Returns this value rotated left by `bits` positions.
routine S64.rotate_left(bits: Integer) -> S64
    return me.rotate_left(bits: U32(from: U64(from: bits)))

### Returns this value rotated right by `bits` positions.
routine S64.rotate_right(bits: Integer) -> S64
    return me.rotate_right(bits: U32(from: U64(from: bits)))

### Renders this value in base `radix` (2 to 36), digits past 9 as lowercase letters, with a leading `-`
### when negative (`255.to_text(radix: 16)` is `ff`).
### :param radix: The numeric base.
### :returns: The rendered `Text`.
@readonly
routine S64.to_text(radix: Integer) -> Text
    return me.to_text(radix: S32(from: S64(from: radix)))

