### Returns the count of set bits (popcount) in this value's 8-bit representation.
### :returns: The number of `1` bits; between 0 and 8.
routine U8.count_ones() -> Integer
    return Integer(from: me.count_ones())

### Returns the count of clear bits in this value's 8-bit representation.
### :returns: `8` minus the popcount; between 0 and 8.
routine U8.count_zeros() -> Integer
    return Integer(from: me.count_zeros())

### Returns the number of leading zero bits, starting from the most-significant bit.
### :returns: The leading zero count; `8` if the value is zero.
routine U8.leading_zeros() -> Integer
    return Integer(from: me.leading_zeros())

### Returns the number of trailing zero bits, starting from the least-significant bit.
### :returns: The trailing zero count; `8` if the value is zero.
routine U8.trailing_zeros() -> Integer
    return Integer(from: me.trailing_zeros())

### Returns the number of leading one bits, starting from the most-significant bit.
### :returns: The leading one count; `8` if the value is `255`.
routine U8.leading_ones() -> Integer
    return Integer(from: me.leading_ones())

### Returns the number of trailing one bits, starting from the least-significant bit.
### :returns: The trailing one count; `8` if the value is `255`.
routine U8.trailing_ones() -> Integer
    return Integer(from: me.trailing_ones())

### Returns ⌊log₂ me⌋. Throws if `me` is zero (the logarithm of zero is undefined).
### :returns: The floor of the base-2 logarithm.
### :throws: {NumericDomainError} if `me == 0`.
routine U8.ilog2!() -> Integer
    return Integer(from: me.ilog2())

### Returns ⌊log₁₀ me⌋. Throws if `me` is zero.
### :returns: The floor of the base-10 logarithm.
### :throws: {NumericDomainError} if `me == 0`.
routine U8.ilog10!() -> Integer
    return Integer(from: me.ilog10())

### Left-shifts this value by `bits` positions, filling vacated bits with zero. Shifting by
### 8 or more gives 0.
### :param bits: The number of bit positions to shift left.
### :returns: `me << bits`.
routine U8.ashl(bits: Integer) -> U8
    return me.ashl(bits: U32(from: U64(from: bits)))

### Right-shifts this value by `bits` positions, filling vacated bits with zero (the same as
### `>>>` for an unsigned type). Shifting by 8 or more gives 0.
### :param bits: The number of bit positions to shift right.
### :returns: `me >> bits`.
routine U8.ashr(bits: Integer) -> U8
    return me.ashr(bits: U32(from: U64(from: bits)))

### Right-shifts this value by `bits` positions, filling vacated bits with zero (the same as
### `>>` for an unsigned type). Shifting by 8 or more gives 0.
### :param bits: The number of bit positions to shift right.
### :returns: `me >>> bits`.
routine U8.lshr(bits: Integer) -> U8
    return me.lshr(bits: U32(from: U64(from: bits)))

### Returns this value rotated left by `bits` positions.
routine U8.rotate_left(bits: Integer) -> U8
    return me.rotate_left(bits: U32(from: U64(from: bits)))

### Returns this value rotated right by `bits` positions.
routine U8.rotate_right(bits: Integer) -> U8
    return me.rotate_right(bits: U32(from: U64(from: bits)))

### Renders this value in base `radix` (2 to 36), digits past 9 as lowercase letters, with a leading `-`
### when negative (`255.to_text(radix: 16)` is `ff`).
### :param radix: The numeric base.
### :returns: The rendered `Text`.
@readonly
routine U8.to_text(radix: Integer) -> Text
    return me.to_text(radix: S32(from: S64(from: radix)))

