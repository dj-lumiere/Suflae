module Collections

import BuilderQuery

### A growable ring of elements, counted and indexed with `Integer`, with O(1) adding and removing at both ends.
###
### `RotatableList[T]` keeps its elements in a `Memory[T]` used as a ring: the elements sit one after another from a
### first place, wrapping past the end of the memory to its start. Reading or writing by position is O(1). Adding or
### removing at the front or the back is O(1) amortized: the ring moves into a memory twice the size when it runs out
### of room. Inserting or removing in the middle is O(n), since the elements after it move.
###
### A rotatable list is a queue (`add_last` / `remove_first`) and a deque. It also rotates (`rotate_left`,
### `rotate_right`) and keeps a fixed-size latest-N history (`add_last_keeping`, `keep_last`) without moving into a
### new memory. A `List[T]` keeps its elements from the first place on instead, so adding at its front moves them all.
###
### Positions count from 0. A negative position crashes with `NegativeIndexError`, one at or past the end
### with `IndexOutOfBoundsError`.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `add_last` / `add_first` | O(1) amortized |
### | `remove_last` / `remove_first` | O(1) |
### | `add_at` / `remove_at` | O(n) |
### | `xs[i]` / `xs[i] = v` | O(1) |
### | `rotate_left` / `rotate_right` | O(1) when full, else O(n) |
### | `have` | O(n) |
### | `sort` | O(n log n) |
### | Iteration | O(n) |
###
### :typeparam T: The element type stored in the rotatable list.
entity RotatableList[T]
relates MemoryEmitter[T] as Emitter
obeys Emittable[T], Container, Equatable, Copyable, ListLiteral[T]
    ### The places the elements live in.
    secret items: Memory[T]
    ### The place the first element sits in.
    secret head: U64
    ### How many elements there are.
    secret count: U64

# ============================================================================
# Creators
# ============================================================================

### Creates an empty list.
routine RotatableList[T]() -> RotatableList[T]
    return RotatableList[T](items: Memory[T](capacity: 0), head: 0, count: 0)

### Creates an empty list with room for at least `capacity` elements.
### :param capacity: The number of elements to make room for.
routine RotatableList[T](capacity: Integer) -> RotatableList[T]
    return RotatableList[T](items: Memory[T](capacity: capacity), head: 0, count: 0)

### Creates a list of `count` copies of `fill_value`.
### :param count: The number of elements.
### :param fill_value: The value every element starts as.
routine RotatableList[T](count: Integer, fill_value: T) -> RotatableList[T]
    return RotatableList[T](items: Memory[T](count: count, fill: fill_value), head: 0, count: count.to[U64]())

### Builds a list from its serialized element list.
### :throws: {SerialShapeError} when the value is not a list or an element does not fit `T`.
failable common routine RotatableList[T].from_serial(value: SerialValue) -> RotatableList[T]
    var result = RotatableList[T]()
    when value
        is RF::System.List[SerialValue] as items =>
            each item in items
                result.add_last(value: serial_decode[T](value: item))
        else =>
            throw SerialShapeError(detail: "expected a list")
    return result

### Builds the list a `[a, b, c]` literal writes.
### :param elements: The elements, in order.
common routine RotatableList[T].from_literal(elements...: T) -> RotatableList[T]
    var result = RotatableList[T](capacity: elements.count().to[Integer]())
    var i: U64 = 0
    # Each element moves into the list: `add_last` makes the list's holder, and the caller releases the
    # literal's own afterwards.
    until i >= elements.count()
        result.add_last(value: elements.get_raw(index: i))
        i = i +% 1
    return result

# ============================================================================
# Size
# ============================================================================

### Returns the number of elements.
routine RotatableList[T].count() -> Integer
    return me.count.to[Integer]()

### Returns the number of elements the list holds without growing.
routine RotatableList[T].capacity() -> Integer
    return me.items.room().to[Integer]()

### Returns whether the list has no elements.
routine RotatableList[T].is_empty() -> Bool
    return me.count == 0

# ============================================================================
# Adding and removing
# ============================================================================

### Adds `value` at the back. The list moves into a bigger memory when it is full.
### :param value: The value to add.
routine RotatableList[T].add_last(value: T)
    me.make_room(extra: 1)
    me.items.put(position: me.place(index: me.count), value: value)
    me.count = me.count + 1
    return

### Adds `value` at the front. The list moves into a bigger memory when it is full.
### :param value: The value to add.
routine RotatableList[T].add_first(value: T)
    me.make_room(extra: 1)
    me.head = if me.head == 0 then me.items.room() - 1 else me.head - 1
    me.items.put(position: me.head, value: value)
    me.count = me.count + 1
    return

### Adds every element of `you` at the back, in order.
### :param you: The elements to add.
routine RotatableList[T].add_range(you: Emittable[T])
    each value in you
        me.add_last(value: value)
    return

### Adds `count` elements of `source`, starting at `from`, at the back of this list.
### :param source: The list to copy from.
### :param from: The first position of `source` to copy.
### :param count: How many elements to copy.
failable routine RotatableList[T].add_range(source: RotatableList[T], from: Integer, count: Integer)
    var first = position_of(value: from)
    var n = position_of(value: count)
    if first + n > source.count
        throw IndexOutOfBoundsError(index: first + n, count: source.count)
    me.make_room(extra: n)
    var i: U64 = 0
    until i >= n
        me.add_last(value: source.items.at(position: source.place(index: first + i)))
        i = i + 1
    return

### Inserts `value` at `index`, moving the elements from there one place back.
### :param index: Where the new element goes, from 0 to `count()`.
### :param value: The value to insert.
failable routine RotatableList[T].add_at(index: Integer, value: T)
    var at = position_of(value: index)
    if at > me.count
        throw IndexOutOfBoundsError(index: at, count: me.count)
    me.make_room(extra: 1)
    me.straighten()
    me.items.carry(source: at, target: at + 1, count: me.count - at)
    me.items.put(position: at, value: value)
    me.count = me.count + 1
    return

### Removes and returns the last element.
### :throws: {AbsentValueError} The list is empty.
failable routine RotatableList[T].remove_last() -> T
    if me.count == 0
        throw AbsentValueError()
    var value = me.items.take_at(position: me.place(index: me.count - 1))
    me.forget(count: 1)
    return value

### Removes and returns the first element.
### :throws: {AbsentValueError} The list is empty.
failable routine RotatableList[T].remove_first() -> T
    if me.count == 0
        throw AbsentValueError()
    var value = me.items.take_at(position: me.head)
    me.advance_head()
    return value

### Removes and returns the element at `index`, moving the elements after it one place forward.
### :param index: The position to remove.
failable routine RotatableList[T].remove_at(index: Integer) -> T
    var at = me.checked_position(index: index)
    me.straighten()
    var value = me.items.take_at(position: at)
    me.items.carry(source: at + 1, target: at, count: me.count - at - 1)
    me.forget(count: 1)
    return value

### Keeps the first `new_count` elements and removes the rest.
### :param new_count: How many elements to keep.
failable routine RotatableList[T].truncate(new_count: Integer)
    var kept = position_of(value: new_count)
    if kept > me.count
        throw IndexOutOfBoundsError(index: kept, count: me.count)
    me.cut(kept: kept)
    return

### Removes every element and keeps the memory.
routine RotatableList[T].clear()
    me.cut(kept: 0)
    return

### Discards the oldest elements so at most the latest `n` remain, keeping the memory: the fixed-space step of a
### rolling "keep the latest N" history. When `n` is at least the count, nothing changes.
### :param n: The maximum number of most-recent elements to keep.
failable routine RotatableList[T].keep_last(n: Integer)
    me.drop_oldest(kept: position_of(value: n))
    return

### Discards the newest elements so at most the first `n` remain, keeping the memory. When `n` is at least the
### count, nothing changes.
### :param n: The maximum number of oldest elements to keep.
routine RotatableList[T].keep_first(n: Integer)
    if n < me.count.to[Integer]()
        me.truncate(new_count: n)
    return

### Adds `value` at the back so that at most `keeping` elements remain, dropping the oldest first: one push into a
### fixed-size latest-N history, which never needs more room than `keeping`. With `keeping` of zero nothing is kept.
### :param value: The value to add.
### :param keeping: The maximum number of most-recent elements to keep afterward.
failable routine RotatableList[T].add_last_keeping(value: T, keeping: Integer)
    var kept = position_of(value: keeping)
    if kept == 0
        me.cut(kept: 0)
        return
    me.drop_oldest(kept: kept - 1)
    me.add_last(value: value)
    return

### Adds `value` at the front so that at most `keeping` elements remain, dropping elements from the back first.
### With `keeping` of zero nothing is kept.
### :param value: The value to add.
### :param keeping: The maximum number of elements to keep afterward.
failable routine RotatableList[T].add_first_keeping(value: T, keeping: Integer)
    var kept = position_of(value: keeping)
    if kept == 0
        me.cut(kept: 0)
        return
    if kept - 1 < me.count
        me.cut(kept: kept - 1)
    me.add_first(value: value)
    return

### Makes room for at least `new_capacity` elements without growing again.
### :param new_capacity: The number of elements to make room for.
routine RotatableList[T].reserve(new_capacity: Integer)
    if new_capacity > me.items.room().to[Integer]()
        me.straighten()
        me.items.grow_to(room: new_capacity.to[U64]())
    return

# ============================================================================
# Reading and writing by position
# ============================================================================

### Returns the first element.
### :throws: {AbsentValueError} The list is empty.
failable routine RotatableList[T].first() -> T
    if me.count == 0
        throw AbsentValueError()
    return me.items.at(position: me.head)

### Returns the last element.
### :throws: {AbsentValueError} The list is empty.
failable routine RotatableList[T].last() -> T
    if me.count == 0
        throw AbsentValueError()
    return me.items.at(position: me.place(index: me.count - 1))

### Returns the first element, or `default_value` if the list is empty.
### :param default_value: The value to return when there is no element.
routine RotatableList[T].first_or_default(default_value: T) -> T
    if me.count == 0
        return default_value
    return me.first()

### Returns the last element, or `default_value` if the list is empty.
### :param default_value: The value to return when there is no element.
routine RotatableList[T].last_or_default(default_value: T) -> T
    if me.count == 0
        return default_value
    return me.last()

### Returns the element at `index` (`xs[i]`).
### :param index: The position to read.
failable routine RotatableList[T].getitem(index: Integer) -> T
    return me.items.at(position: me.place(index: me.checked_position(index: index)))

### Replaces the element at `index` (`xs[i] = v`).
### :param index: The position to write.
### :param value: The new element.
failable routine RotatableList[T].setitem(index: Integer, value: T)
    me.items.put(position: me.place(index: me.checked_position(index: index)), value: value)
    return

### Returns a new list of the elements at the positions in `range` (`xs[a til b]`). Positions outside the
### list are skipped, and a range that counts down (`by -1`) gives the elements in reverse.
### :param range: The positions to copy.
routine RotatableList[T].getitem(range: Range[Integer]) -> RotatableList[T]
    var result = RotatableList[T]()
    var count = me.count.to[Integer]()
    each i in range
        if not i.is_negative() and i < count
            result.add_last(value: me.items.at(position: me.place(index: i.to[U64]())))
    return result

# ============================================================================
# Rotation
# ============================================================================

### Moves the first `n` elements to the back, keeping their order.
### :param n: How many positions to rotate by.
failable routine RotatableList[T].rotate_left(n: Integer)
    me.turn(count: position_of(value: n))
    return

### Moves the last `n` elements to the front, keeping their order.
### :param n: How many positions to rotate by.
failable routine RotatableList[T].rotate_right(n: Integer)
    var shift = position_of(value: n)
    if me.count == 0
        return
    me.turn(count: me.count - shift % me.count)
    return

# ============================================================================
# Iteration, comparison and display
# ============================================================================

### Returns a walk over the elements, front to back.
routine RotatableList[T].emitter() -> MemoryEmitter[T]
    return me.items.walk_at(first: me.head, count: me.count)

### Returns whether both lists hold equal elements in the same order.
### :param you: The other list.
routine RotatableList[T].eq(you: RotatableList[T]) -> Bool
needs T obeys Equatable
    if me.count != you.count
        return false
    var i: U64 = 0
    until i >= me.count
        if me.items.at(position: me.place(index: i)) != you.items.at(position: you.place(index: i))
            return false
        i = i + 1
    return true

### Returns whether some element equals `value` (`xs have v`).
### :param value: The value to look for.
routine RotatableList[T].has(value: T) -> Bool
needs T obeys Equatable
    each element in me
        if element == value
            return true
    return false

### Returns whether `value` is not in this value: the opposite of `has`.
### :param value: The value to look for.
### :returns: `true` when `value` is absent.
routine RotatableList[T].lacks(value: T) -> Bool
needs T obeys Equatable
    return not me.has(value)

### Returns the list as text: `[1, 2, 3]`.
@override
routine RotatableList[T].represent() -> Text
    return me.elements_text()

### Returns the list's diagnostic text: its type, count and elements.
@override
routine RotatableList[T].diagnose() -> Text
    return f"{me.full_type_name()}(count: {me.count}, {me.elements_text()})"

### Returns a new list holding copies of the elements.
routine RotatableList[T].duplicate() -> RotatableList[T]
    var result = RotatableList[T](capacity: me.count.to[Integer]())
    each element in me
        result.add_last(value: element)
    return result

### Returns the list as a `SerialValue.List` of its serialized elements.
@override
routine RotatableList[T].serialize() -> SerialValue
    var result = RF::System.List[SerialValue]()
    each element in me
        result.add_last(value: element.serialize())
    return SerialValue(result.duplicate())

# ============================================================================
# Ordering
# ============================================================================

### Sorts the elements in ascending order. The sort is stable: equal elements keep their order.
routine RotatableList[T].sort()
needs T obeys Comparable
    me.straighten()
    me.items.view(first: 0, room: me.count).sort()
    return

### Sorts the elements so that `compare(a, b)` holds for every `a` before `b` it decides. Stable.
### :param compare: Returns whether its first argument goes before its second.
routine RotatableList[T].sort_by(compare: Callable[(T, T), Bool])
    me.straighten()
    me.items.view(first: 0, room: me.count).sort_by(compare: compare)
    return

### Returns a new list of the elements in ascending order.
routine RotatableList[T].sorted() -> RotatableList[T]
needs T obeys Comparable
    var result = me.duplicate()
    result.sort()
    return result

### Returns a new list of the elements, ordered by `compare`.
### :param compare: Returns whether its first argument goes before its second.
routine RotatableList[T].sorted_by(compare: Callable[(T, T), Bool]) -> RotatableList[T]
    var result = me.duplicate()
    result.sort_by(compare: compare)
    return result

### Swaps the elements at `first` and `second` in place.
### :param first: One position.
### :param second: The other position.
failable routine RotatableList[T].swap(first: Integer, second: Integer)
    me.items.swap_at(first: me.place(index: me.checked_position(index: first)), second: me.place(index: me.checked_position(index: second)))
    return

### Reverses the order of the elements.
routine RotatableList[T].reverse_in_place()
    me.straighten()
    me.items.view(first: 0, room: me.count).reverse()
    return

# ============================================================================
# Inside the list
# ============================================================================

### The memory place of the element at `index`, counted from the first one.
@inline
secret routine RotatableList[T].place(index: U64) -> U64
    var place = me.head + index
    var room = me.items.room()
    return if place >= room then place - room else place
### The position `index` names, crashing unless it is the position of an element.
secret failable routine RotatableList[T].checked_position(index: Integer) -> U64
    var at = position_of(value: index)
    if at >= me.count
        throw IndexOutOfBoundsError(index: at, count: me.count)
    return at

### Tears down the elements from position `kept` on, keeping the first `kept` (at most the count).
secret routine RotatableList[T].cut(kept: U64)
    var i = kept
    until i >= me.count
        me.items.erase_at(position: me.place(index: i))
        i = i + 1
    me.forget(count: me.count - kept)
    return

### Tears down the oldest elements until at most `kept` remain.
secret routine RotatableList[T].drop_oldest(kept: U64)
    until me.count <= kept
        me.items.erase_at(position: me.head)
        me.advance_head()
    return

### Moves the first `count` elements to the back, keeping their order.
secret routine RotatableList[T].turn(count: U64)
    if me.count == 0
        return
    var shift = count % me.count
    if me.count == me.items.room()
        me.head = me.place(index: shift)
        return
    var i: U64 = 0
    until i >= shift
        me.items.carry(source: me.head, target: me.place(index: me.count), count: 1)
        me.head = me.place(index: 1)
        i = i + 1
    return

### Forgets the last `count` elements (already handed out or torn down).
secret routine RotatableList[T].forget(count: U64)
    me.count = me.count - count
    if me.count == 0
        me.head = 0
    return

### Moves the front past the first element (already handed out or torn down).
secret routine RotatableList[T].advance_head()
    me.head = me.place(index: 1)
    me.forget(count: 1)
    return

### Lays the elements out from the memory's first place, so positions are places. The order does not change.
secret routine RotatableList[T].straighten()
    if me.head == 0
        return
    me.items.turn(count: me.head)
    me.head = 0
    return

### Moves into a bigger memory when fewer than `extra` places are free: twice the room, at least four, or as much
### as needed.
secret routine RotatableList[T].make_room(extra: U64)
    var needed = me.count + extra
    var room = me.items.room()
    if needed <= room
        return
    var grown: U64 = if room < 4 then 4 else room * 2
    if grown < needed
        grown = needed
    me.straighten()
    me.items.grow_to(room: grown)
    return

### The elements as text: `[1, 2, 3]`.
secret routine RotatableList[T].elements_text() -> Text
    var result = "["
    var first = true
    each element in me
        if not first
            result = f"{result}, "
        result = f"{result}{nested_repr(element)}"
        first = false
    return f"{result}]"

### Collects the values into a rotatable list, in order.
routine Emittable[T].to[RotatableList[T]]() -> RotatableList[T]
    var result = RotatableList[T]()
    each item in me
        result.add_last(value: item)
    return result
