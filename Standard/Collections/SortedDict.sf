module Collections

import Numerics
import BuilderQuery

### A sorted dictionary that maintains keys in ascending order, backed by a B-tree.
###
### `SortedDict[TKey, TValue]` maps comparable keys to values and always keeps those keys sorted.
### Unlike {Dict[TKey, TValue]}, which keeps insertion order, `SortedDict` lets you iterate in
### key order, efficiently find the minimum or maximum entry, and retrieve entries by sorted rank.
### Each key is unique — adding an existing key replaces its value.
###
### **When to use**
### - You need to iterate over entries in key order.
### - You need `min!` / `max!` or want the smallest/largest key at any time.
### - You need rank-based access: the N-th smallest entry.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `add` | O(log n) |
### | `remove` | O(log n) |
### | `contains` / `[]` / `get_or` | O(log n) |
### | `get_by_rank!` | O(log n) |
### | `min!` / `max!` | O(log n) |
### | `keys()` / `values()` / Iteration | O(n log n) |
###
### :typeparam TKey: The key type. Must obey {Comparable}.
### :typeparam TValue: The value type.
### :see: {Dict[TKey, TValue]} for a hashed dictionary with O(1) average lookup.
### :see: {SortedList[T]} for a sorted sequence that allows duplicates.
entity SortedDict[TKey, TValue]
relates SortedDictEmittable[TKey, TValue] as Iter, TKey as Key, TValue as Value
obeys Iterable[DictEntry[TKey, TValue]], KeyFindable, DictLiteral[TKey, TValue]
needs TKey obeys Comparable
    ### The tree holding the entries.
    secret tree: SortedTree[TKey, TValue]

### Walks the entries of a {SortedDict[TKey, TValue]} in ascending key order.
### :typeparam TKey: The key type.
### :typeparam TValue: The value type.
entity SortedDictEmittable[TKey, TValue]
obeys Emittable[DictEntry[TKey, TValue]]
needs TKey obeys Comparable
    ### The tree being walked, shared with the dictionary.
    secret tree: SortedTree[TKey, TValue]
    ### The rank of the next entry.
    secret index: U64

# ============================================================================
# Creators
# ============================================================================

### Creates an empty sorted dictionary.
routine SortedDict[TKey, TValue]() -> SortedDict[TKey, TValue]
    return SortedDict[TKey, TValue](tree: SortedTree[TKey, TValue]())

### Creates a sorted dict containing the given key-value `pairs` (stored in sorted key order). Variadic
### constructor behind the `{k: v, …}` dict-literal syntax (the `DictLiteral` opt-in).
### :param pairs: The key-value pairs as `DictEntry[TKey, TValue]` values; a later duplicate key overwrites.
### :returns: A sorted dict of the given pairs.
common routine SortedDict[TKey, TValue].from_literal(pairs...: DictEntry[TKey, TValue]) -> SortedDict[TKey, TValue]
needs TKey obeys Comparable
    var result = SortedDict[TKey, TValue]()
    var i = 0u64
    # Each pair is read in place: `add` makes the dictionary's holders, and the caller releases the
    # literal's own afterwards.
    while i < pairs.count()
        discard result.add(key: pairs.get_raw(index: i).key, value: pairs.get_raw(index: i).value)
        i = i +% 1u64
    return result

# ============================================================================
# Core
# ============================================================================

### Returns the number of key-value pairs in this dictionary.
routine SortedDict[TKey, TValue].count() -> Integer
    return Integer(from: me.tree.count())

### Returns true if this dictionary contains no entries.
routine SortedDict[TKey, TValue].is_empty() -> Bool
    return me.tree.count() == 0u64

### Removes all entries.
routine SortedDict[TKey, TValue].clear()
    me.tree.clear()
    return

### Returns true if `key` has an entry (`d have k`).
### :param key: The key to look up.
routine SortedDict[TKey, TValue].contains(key: TKey) -> Bool
    return me.tree.has(key: key)

### Returns the value of `key` (`d[k]`).
### :param key: The key to look up.
### :absent: The key has no entry.
routine SortedDict[TKey, TValue].getitem!(key: TKey) -> TValue
    if not me.tree.has(key: key)
        absent
    return me.tree.value_of(key: key)

### Replaces the value of an existing `key` (`d[k] = v`).
### :param key: The key.
### :param value: The new value.
### :absent: The key has no entry.
routine SortedDict[TKey, TValue].setitem!(key: TKey, value: TValue)
    if not me.tree.has(key: key)
        absent
    me.tree.replace(key: key, value: value)
    return

### Returns the value for `key`, or `default` if the key is not present.
### :param key: The key to look up.
### :param default: The value returned when `key` has no entry.
routine SortedDict[TKey, TValue].get_or(key: TKey, default: TValue) -> TValue
    if me.tree.has(key: key)
        return me.tree.value_of(key: key)
    return default

### Adds an entry for `key`, or replaces the value of the one it has.
### :param key: The key.
### :param value: The value for `key`.
### :returns: `true` if a new key was added; `false` if an existing key's value was replaced.
routine SortedDict[TKey, TValue].add(key: TKey, value: TValue) -> Bool
    if me.tree.has(key: key)
        me.tree.replace(key: key, value: value)
        return false
    me.tree.insert(key: key, value: value)
    return true

### Removes the entry for `key`.
### :param key: The key to remove.
### :returns: `true` if the key had an entry.
routine SortedDict[TKey, TValue].remove(key: TKey) -> Bool
    return me.tree.remove(key: key)

# ============================================================================
# Rank-based access
# ============================================================================

### Returns the entry at the given zero-based sorted rank.
### Rank 0 is the entry with the smallest key; rank `count()-1` is the largest.
### :param i: The zero-based sorted rank to read.
### :returns: The {DictEntry[TKey, TValue]} at that sorted position.
### :throws: {IndexOutOfBoundsError} if `i >= count()`.
routine SortedDict[TKey, TValue].get_by_rank!(i: Integer) -> DictEntry[TKey, TValue]
    var position = position_of(value: i)
    var count = me.tree.count()
    if position >= count
        throw IndexOutOfBoundsError(index: position, count: count)
    return me.entry_at(rank: position)

# ============================================================================
# Min/Max
# ============================================================================

### Returns the entry with the smallest key.
### :absent: The dictionary is empty.
routine SortedDict[TKey, TValue].min!() -> DictEntry[TKey, TValue]
    if me.is_empty()
        absent
    return me.entry_at(rank: 0u64)

### Returns the entry with the largest key.
### :absent: The dictionary is empty.
routine SortedDict[TKey, TValue].max!() -> DictEntry[TKey, TValue]
    if me.is_empty()
        absent
    return me.entry_at(rank: me.tree.count() - 1u64)

### Returns the entry with the smallest key. Alias for {SortedDict[TKey, TValue].min()}.
### :absent: The dictionary is empty.
routine SortedDict[TKey, TValue].first!() -> DictEntry[TKey, TValue]
    return me.min()

### Returns the entry with the largest key. Alias for {SortedDict[TKey, TValue].max()}.
### :absent: The dictionary is empty.
routine SortedDict[TKey, TValue].last!() -> DictEntry[TKey, TValue]
    return me.max()

# ============================================================================
# Keys / Values
# ============================================================================

### Returns all keys in ascending order.
routine SortedDict[TKey, TValue].keys() -> List[TKey]
    var count = me.tree.count()
    var result = List[TKey](capacity: Integer(from: count))
    var i = 0u64
    while i < count
        result.add_last(value: me.tree.key_at(rank: i))
        i = i + 1u64
    return result

### Returns all values in key-ascending order.
routine SortedDict[TKey, TValue].values() -> List[TValue]
    var count = me.tree.count()
    var result = List[TValue](capacity: Integer(from: count))
    var i = 0u64
    while i < count
        result.add_last(value: me.tree.value_at(rank: i))
        i = i + 1u64
    return result

# ============================================================================
# Iteration
# ============================================================================

### Returns a walk over the entries in ascending key order.
routine SortedDict[TKey, TValue].iter() -> SortedDictEmittable[TKey, TValue]
    return SortedDictEmittable[TKey, TValue](tree: me.tree, index: 0u64)

### Returns the next entry.
### :absent: The walk is over.
routine SortedDictEmittable[TKey, TValue].emit!() -> DictEntry[TKey, TValue]
    if me.index >= me.tree.count()
        absent
    var rank = me.index
    me.index = me.index + 1u64
    return DictEntry[TKey, TValue](key: me.tree.key_at(rank: rank), value: me.tree.value_at(rank: rank))

### Creates a {List[DictEntry[TKey, TValue]]} from all entries of `from` in ascending key order.
### :param from: The sorted dictionary to convert.
### :returns: A new list of all entries in key-ascending order.
routine List[DictEntry[TKey, TValue]](from: SortedDict[TKey, TValue]) -> List[DictEntry[TKey, TValue]]
    var result = List[DictEntry[TKey, TValue]](capacity: from.count())
    each entry in from
        result.add_last(value: entry)
    return result

# ============================================================================
# Display
# ============================================================================

@override
routine SortedDict[TKey, TValue].represent() -> Text
    return f"{me.type_name()}({{{me.entries_text()}}})"

@override
routine SortedDict[TKey, TValue].diagnose() -> Text
    return f"{me.full_type_name()}(count: {me.count()}, {{{me.entries_text()}}})"

### Serializes this dictionary to a `SerialValue.Dict`; keys render via `represent`, values serialize.
### :returns: The `SerialValue.Dict` mapping each key's text to its value's serialized form.
@override
routine SortedDict[TKey, TValue].serialize() -> SerialValue
    var result = Dict[Text, SerialValue]()
    each entry in me
        discard result.add(key: entry.key.represent(), value: entry.value.serialize())
    return SerialValue(result.duplicate())

# ============================================================================
# Inside the dictionary
# ============================================================================

### The entry at `rank`, which must be below the count.
secret routine SortedDict[TKey, TValue].entry_at(rank: U64) -> DictEntry[TKey, TValue]
    return DictEntry[TKey, TValue](key: me.tree.key_at(rank: rank), value: me.tree.value_at(rank: rank))

### The entries as text: `"a": 1, "b": 2`.
secret routine SortedDict[TKey, TValue].entries_text() -> Text
    var result = ""
    var first = true
    each entry in me
        if not first
            result = f"{result}, "
        result = f"{result}{nested_repr(entry.key)}: {nested_repr(entry.value)}"
        first = false
    return result
