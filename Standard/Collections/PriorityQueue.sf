module Collections

import BuilderQuery
### A min-heap priority pool that always removes the entry with the smallest priority first.
###
### `PriorityQueue[TPriority, TElement]` keeps priorities and elements in two `Memory` rows laid out as one heap. The
### heap property guarantees that the minimum-priority entry is always at the front. When two entries have equal
### priority, no order guarantee is made between them.
###
### A queue is not walked directly: pick the order. `unordered()` copies the `(priority, element)` pairs in storage
### order, `ordered()` copies them smallest priority first and leaves the queue as it is, and `drain()` empties the
### queue into them smallest priority first.
###
### **When to use**
### - You need to process items by priority (e.g., Dijkstra's algorithm, task scheduling).
### - You need O(log n) insertion and O(log n) minimum removal.
### - Use {SortedList[T]} instead when you need sorted traversal without removing elements.
### - Use {List[T]} instead when order does not depend on priority — arrival order, both ends, or rotation.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `add` | O(log n) |
### | `remove!` | O(log n) |
### | `peek!` / `peek_priority!` / `peek_entry!` | O(1) |
### | `add_all` | O(k log n) |
### | `unordered` | O(n) |
### | `ordered` / `drain` | O(n log n) |
### | `contains` | O(n) |
###
### :typeparam TPriority: The comparable type used for heap ordering. Smaller values rank higher.
### :typeparam TElement: The value type stored alongside each priority.
### :see: {SortedList[T]} for sorted traversal without removing elements.
### :see: {List[T]} for both-ended, rotatable sequencing without priority.
entity PriorityQueue[TPriority, TElement]
obeys DictLiteral[TPriority, TElement]
needs TPriority obeys Comparable
    ### The priorities, in heap order.
    secret priorities: Memory[TPriority]
    ### The elements, at the same places as their priorities.
    secret elements: Memory[TElement]
    ### How many entries there are: the first `count` places of both buffers.
    secret count: U64

# ============================================================================
# Creators
# ============================================================================

### Creates a priority pool containing the given `pairs`, each a `{priority: element}` mapping. Variadic
### constructor behind the `{p: e, …}` dict-literal syntax (the `DictLiteral` opt-in): the key of every
### `DictEntry` is the priority, the value is the element.
### :param pairs: The priority-element pairs as `DictEntry[TPriority, TElement]` values.
### :returns: A priority pool of the given pairs.
common routine PriorityQueue[TPriority, TElement].from_literal(pairs...: DictEntry[TPriority, TElement]) -> PriorityQueue[TPriority, TElement]
needs TPriority obeys Comparable
    var result = PriorityQueue[TPriority, TElement](capacity: pairs.count().to[Integer]())
    var i: U64 = 0
    until i >= pairs.count()
        result.add(element: pairs.get_raw(index: i).value, priority: pairs.get_raw(index: i).key)
        i = i +% 1
    return result

### Creates an empty priority pool.
routine PriorityQueue[TPriority, TElement]() -> PriorityQueue[TPriority, TElement]
    return PriorityQueue[TPriority, TElement](capacity: 0)

### Creates an empty priority pool with room for `capacity` entries.
### :param capacity: The number of entries to make room for.
routine PriorityQueue[TPriority, TElement](capacity: Integer) -> PriorityQueue[TPriority, TElement]
    return PriorityQueue[TPriority, TElement](
        priorities: Memory[TPriority](capacity: capacity),
        elements: Memory[TElement](capacity: capacity),
        count: 0,
    )

# ============================================================================
# Size
# ============================================================================

### Returns the number of entries currently stored in the pool.
routine PriorityQueue[TPriority, TElement].count() -> Integer
    return me.count.to[Integer]()

### Returns true if the pool holds no entries.
routine PriorityQueue[TPriority, TElement].is_empty() -> Bool
    return me.count == 0

### Removes every entry and keeps the room.
routine PriorityQueue[TPriority, TElement].clear()
    var i: U64 = 0
    until i >= me.count
        me.priorities.erase_at(position: i)
        me.elements.erase_at(position: i)
        i = i + 1
    me.count = 0
    return

### Makes room for at least `new_capacity` entries without growing again.
### :param new_capacity: The minimum entry count to guarantee.
routine PriorityQueue[TPriority, TElement].reserve(new_capacity: Integer)
    if new_capacity > me.priorities.capacity()
        me.make_room(room: new_capacity.to[U64]())
    return

# ============================================================================
# Adding and removing
# ============================================================================

### Inserts `element` with the given `priority`.
### Smaller priority values rank higher — the entry with the smallest priority is removed first.
### :param element: The value to add.
### :param priority: The priority that determines removal order.
routine PriorityQueue[TPriority, TElement].add(element: TElement, priority: TPriority)
    var room = me.priorities.room()
    if me.count >= room
        var grown: U64 = if room < 4 then 4 else room * 2
        me.make_room(room: grown)
    me.priorities.put(position: me.count, value: priority)
    me.elements.put(position: me.count, value: element)
    me.count = me.count + 1
    me.sift_up(index: me.count - 1)
    return

### Removes and returns the element with the smallest priority.
### The last heap entry is moved to the root and sifted down to restore heap order.
### :returns: The element associated with the minimum priority.
### :throws: {AbsentValueError} The pool is empty.
failable routine PriorityQueue[TPriority, TElement].remove() -> TElement
    if me.count == 0
        throw AbsentValueError()
    var result = me.elements.take_at(position: 0)
    me.priorities.erase_at(position: 0)
    var last = me.count - 1
    if last > 0
        me.priorities.carry(source: last, target: 0, count: 1)
        me.elements.carry(source: last, target: 0, count: 1)
    me.count = last
    if me.count > 1
        me.sift_down(index: 0)
    return result

### Returns the element at the front of the pool without removing it.
### :returns: The element with the smallest priority.
### :throws: {AbsentValueError} The pool is empty.
failable routine PriorityQueue[TPriority, TElement].peek() -> TElement
    if me.count == 0
        throw AbsentValueError()
    return me.elements.at(position: 0)

### Returns the smallest priority currently in the pool without removing its entry.
### :returns: The minimum priority value.
### :throws: {AbsentValueError} The pool is empty.
failable routine PriorityQueue[TPriority, TElement].peek_priority() -> TPriority
    if me.count == 0
        throw AbsentValueError()
    return me.priorities.at(position: 0)

### Returns the front `(priority, element)` pair without removing it.
### :returns: The pair with the smallest priority.
### :throws: {AbsentValueError} The pool is empty.
failable routine PriorityQueue[TPriority, TElement].peek_entry() -> (TPriority, TElement)
    if me.count == 0
        throw AbsentValueError()
    return (me.priorities.at(position: 0), me.elements.at(position: 0))

# ============================================================================
# Bulk Operations
# ============================================================================

### Inserts elements from `elements` paired with priorities from `priorities`.
### Only pairs up to the length of the shorter list are inserted; any extra values are ignored.
### :param elements: The elements to add.
### :param priorities: The priorities to assign at matching positions.
routine PriorityQueue[TPriority, TElement].add_all(elements: List[TElement], priorities: List[TPriority])
    var i = 0
    var limit = if elements.count() < priorities.count() then elements.count() else priorities.count()
    until i >= limit
        me.add(element: elements[i], priority: priorities[i])
        i = i + 1
    return

### Empties the queue into its `(priority, element)` pairs, smallest priority first: the order repeated `remove()`
### calls give (`each (priority, element) in pq.drain()`).
### :returns: The pairs, in removal order.
routine PriorityQueue[TPriority, TElement].drain() -> List[(TPriority, TElement)]
    var result = List[Tuple[TPriority, TElement]](capacity: me.count.to[Integer]())
    until me.count == 0
        var priority = me.priorities.at(position: 0)
        var element = me.remove()
        result.add_last(value: (priority, element))
    return result

### Copies the `(priority, element)` pairs smallest priority first, leaving the queue as it is
### (`each (priority, element) in pq.ordered()`).
### :returns: The pairs, in removal order.
routine PriorityQueue[TPriority, TElement].ordered() -> List[(TPriority, TElement)]
    var copy = PriorityQueue[TPriority, TElement](capacity: me.count.to[Integer]())
    var i: U64 = 0
    until i >= me.count
        copy.add(element: me.elements.at(position: i), priority: me.priorities.at(position: i))
        i = i + 1
    return copy.drain()

### Copies the `(priority, element)` pairs in storage order, which is NOT priority order: the cheap walk for when the
### order does not matter (`each (priority, element) in pq.unordered()`).
### :returns: The pairs, in heap storage order.
routine PriorityQueue[TPriority, TElement].unordered() -> List[(TPriority, TElement)]
    var result = List[Tuple[TPriority, TElement]](capacity: me.count.to[Integer]())
    var i: U64 = 0
    until i >= me.count
        result.add_last(value: (me.priorities.at(position: i), me.elements.at(position: i)))
        i = i + 1
    return result

# ============================================================================
# Utility Operations
# ============================================================================

### Returns true if any stored entry carries `element`, scanning in heap order.
### :param element: The element value to search for.
routine PriorityQueue[TPriority, TElement].has(element: TElement) -> Bool
needs TElement obeys Equatable
    var i: U64 = 0
    until i >= me.count
        if me.elements.at(position: i) == element
            return true
        i = i + 1
    return false

### Returns whether `element` is not in this value: the opposite of `has`.
### :param element: The value to look for.
### :returns: `true` when `element` is absent.
routine PriorityQueue[TPriority, TElement].lacks(element: TElement) -> Bool
needs TElement obeys Equatable
    return not me.has(element)

### Returns the queue as text: its `priority: element` pairs in square brackets, in the order they come out, the
### next one first, as `[1: "a", 2: "b", 4: "d"]`. The queue does not change. An empty queue shows `[]`.
@override
routine PriorityQueue[TPriority, TElement].represent() -> Text
    return me.entries_text()

### Returns the queue's diagnostic text: its type, count and pairs.
@override
routine PriorityQueue[TPriority, TElement].diagnose() -> Text
    return f"{me.full_type_name()}(count: {me.count}, {me.entries_text()})"

# ============================================================================
# Inside the heap
# ============================================================================

### Moves the entry at `index` toward the root while its priority is smaller than its parent's.
secret routine PriorityQueue[TPriority, TElement].sift_up(index: U64)
    var at = index
    until at == 0
        var parent = (at - 1) // 2
        if me.priorities.at(position: at) >= me.priorities.at(position: parent)
            return
        me.swap_entries(a: at, b: parent)
        at = parent
    return

### Moves the entry at `index` toward the leaves while a child has a smaller priority.
secret routine PriorityQueue[TPriority, TElement].sift_down(index: U64)
    var at = index
    loop
        var child = 2 * at + 1
        if child >= me.count
            return
        var right = child + 1
        if right < me.count and me.priorities.at(position: right) < me.priorities.at(position: child)
            child = right
        if me.priorities.at(position: child) >= me.priorities.at(position: at)
            return
        me.swap_entries(a: at, b: child)
        at = child

### Swaps the entries at `a` and `b`.
secret routine PriorityQueue[TPriority, TElement].swap_entries(a: U64, b: U64)
    me.priorities.swap_at(first: a, second: b)
    me.elements.swap_at(first: a, second: b)
    return

### Moves both buffers into rows of `room` places.
secret routine PriorityQueue[TPriority, TElement].make_room(room: U64)
    me.priorities.grow_to(room: room)
    me.elements.grow_to(room: room)
    return

### The entries as text in the order `shown_order` gives: `[1: "a", 3: "b"]`.
secret routine PriorityQueue[TPriority, TElement].entries_text() -> Text
    var result = "["
    var first = true
    each i in me.shown_order()
        if not first
            result = f"{result}, "
        result = f"{result}{nested_repr(me.priorities.at(position: i))}: {nested_repr(me.elements.at(position: i))}"
        first = false
    return f"{result}]"

### The storage positions in the order `represent` and `diagnose` show them, the order the entries come out:
### smallest priority first, equal priorities in storage order. It sorts a copy of the positions, so the heap does
### not change. This routine alone decides that order.
secret routine PriorityQueue[TPriority, TElement].shown_order() -> List[U64]
    var order = List[U64]()
    var i: U64 = 0
    until i >= me.count
        # The first shown position whose priority is greater than this one's, found by halving.
        var low = 0
        var high = order.count()
        until low >= high
            var mid = low + (high - low) // 2
            if me.priorities.at(position: order[mid]) > me.priorities.at(position: i)
                high = mid
            else
                low = mid + 1
        order.add_at(index: low, value: i)
        i = i + 1
    return order
