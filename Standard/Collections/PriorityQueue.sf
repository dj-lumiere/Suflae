module Collections

import Numerics
import BuilderQuery
### Pairs an element with the priority that determines its position in a {PriorityQueue}.
### Used for iteration, bulk inspection, and conversion to list form.
### :typeparam TPriority: The type used to order entries in the heap.
### :typeparam TElement: The value carried by each entry.
record PQEntry[TPriority, TElement]
needs TPriority obeys Comparable
    priority: TPriority
    element: TElement

### A min-heap priority pool that always removes the entry with the smallest priority first.
###
### `PriorityQueue[TPriority, TElement]` keeps priorities and elements in two `Buffer`s laid out as one heap. The
### heap property guarantees that the minimum-priority entry is always at the front. When two entries have equal
### priority, no order guarantee is made between them.
###
### Iteration visits entries in heap order, which is NOT globally sorted by priority.
### Use `drain()` to consume all entries in removal order.
###
### **When to use**
### - You need to process items by priority (e.g., Dijkstra's algorithm, task scheduling).
### - You need O(log n) insertion and O(log n) minimum removal.
### - Use {SortedList[T]} instead when you need sorted traversal without removing elements.
### - Use {List[T]} instead when order does not depend on priority — arrival order, both ends, or rotation.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `add` | O(log n) |
### | `remove!` | O(log n) |
### | `peek!` / `peek_priority!` / `peek_entry!` | O(1) |
### | `add_all` | O(k log n) |
### | `drain` | O(n log n) |
### | `contains` | O(n) |
### | Iteration | O(n), heap order |
###
### :typeparam TPriority: The comparable type used for heap ordering. Smaller values rank higher.
### :typeparam TElement: The value type stored alongside each priority.
### :see: {SortedList[T]} for sorted traversal without removing elements.
### :see: {List[T]} for both-ended, rotatable sequencing without priority.
entity PriorityQueue[TPriority, TElement]
relates PriorityQueueEmittable[TPriority, TElement] as Iter
obeys Iterable[PQEntry[TPriority, TElement]], DictLiteral[TPriority, TElement]
needs TPriority obeys Comparable
    ### The priorities, in heap order.
    secret priorities: Buffer[TPriority]
    ### The elements, at the same places as their priorities.
    secret elements: Buffer[TElement]
    ### How many entries there are: the first `count` places of both buffers.
    secret count: Integer

### Walks the heap's entries in storage order, which is heap order — NOT priority-sorted order.
### :typeparam TPriority: The priority type carried by yielded entries.
### :typeparam TElement: The element type carried by yielded entries.
entity PriorityQueueEmittable[TPriority, TElement]
obeys Emittable[PQEntry[TPriority, TElement]]
    ### The walk over the priorities.
    secret priorities: BufferEmittable[TPriority]
    ### The walk over the elements.
    secret elements: BufferEmittable[TElement]
    ### How many entries the walk reads.
    secret count: Integer
    ### How many entries have been read.
    secret index: Integer

# ============================================================================
# Creators
# ============================================================================

### Creates a priority pool containing the given `pairs`, each a `{priority: element}` mapping. Variadic
### constructor behind the `{p: e, …}` dict-literal syntax (the `DictLiteral` opt-in): the key of every
### `DictEntry` is the priority, the value is the element.
### :param pairs: The priority-element pairs as `DictEntry[TPriority, TElement]` values.
### :returns: A priority pool of the given pairs.
common routine PriorityQueue[TPriority, TElement].from_literal(pairs...: DictEntry[TPriority, TElement]) -> PriorityQueue[TPriority, TElement]
needs TPriority obeys Comparable
    var result = PriorityQueue[TPriority, TElement](capacity: Integer(from: pairs.count()))
    var i = 0u64
    while i < pairs.count()
        result.add(element: pairs.get_raw(index: i).value, priority: pairs.get_raw(index: i).key)
        i = i +% 1u64
    return result

### Creates an empty priority pool.
routine PriorityQueue[TPriority, TElement]() -> PriorityQueue[TPriority, TElement]
    return PriorityQueue[TPriority, TElement](capacity: 0)

### Creates an empty priority pool with room for `capacity` entries.
### :param capacity: The number of entries to make room for.
routine PriorityQueue[TPriority, TElement](capacity: Integer) -> PriorityQueue[TPriority, TElement]
    return PriorityQueue[TPriority, TElement](
        priorities: Buffer[TPriority](capacity: capacity),
        elements: Buffer[TElement](capacity: capacity),
        count: 0,
    )

# ============================================================================
# Size
# ============================================================================

### Returns the number of entries currently stored in the pool.
routine PriorityQueue[TPriority, TElement].count() -> Integer
    return me.count

### Returns true if the pool holds no entries.
routine PriorityQueue[TPriority, TElement].is_empty() -> Bool
    return me.count == 0

### Removes every entry and keeps the room.
routine PriorityQueue[TPriority, TElement].clear()
    var i = 0
    while i < me.count
        me.priorities.erase(index: i)
        me.elements.erase(index: i)
        i = i + 1
    me.count = 0
    return

### Makes room for at least `new_capacity` entries without growing again.
### :param new_capacity: The minimum entry count to guarantee.
routine PriorityQueue[TPriority, TElement].reserve(new_capacity: Integer)
    if new_capacity > me.priorities.capacity()
        me.priorities.grow(capacity: new_capacity)
        me.elements.grow(capacity: new_capacity)
    return

# ============================================================================
# Adding and removing
# ============================================================================

### Inserts `element` with the given `priority`.
### Smaller priority values rank higher — the entry with the smallest priority is removed first.
### :param element: The value to add.
### :param priority: The priority that determines removal order.
routine PriorityQueue[TPriority, TElement].add(element: TElement, priority: TPriority)
    var room = me.priorities.capacity()
    if me.count >= room
        me.reserve(new_capacity: if room < 4 then 4 else room * 2)
    me.priorities[me.count] = priority
    me.elements[me.count] = element
    me.count = me.count + 1
    me.sift_up(index: me.count - 1)
    return

### Removes and returns the element with the smallest priority.
### The last heap entry is moved to the root and sifted down to restore heap order.
### :returns: The element associated with the minimum priority.
### :absent: The pool is empty.
routine PriorityQueue[TPriority, TElement].remove!() -> TElement
    if me.count == 0
        absent
    var result = me.elements.take(index: 0)
    me.priorities.erase(index: 0)
    var last = me.count - 1
    if last > 0
        me.priorities.move(from: last, into: 0, count: 1)
        me.elements.move(from: last, into: 0, count: 1)
    me.count = last
    if me.count > 1
        me.sift_down(index: 0)
    return result

### Returns the element at the front of the pool without removing it.
### :returns: The element with the smallest priority.
### :absent: The pool is empty.
routine PriorityQueue[TPriority, TElement].peek!() -> TElement
    if me.count == 0
        absent
    return me.elements[0]

### Returns the smallest priority currently in the pool without removing its entry.
### :returns: The minimum priority value.
### :absent: The pool is empty.
routine PriorityQueue[TPriority, TElement].peek_priority!() -> TPriority
    if me.count == 0
        absent
    return me.priorities[0]

### Returns the front entry as a `PQEntry` without removing it.
### :returns: The priority–element pair with the smallest priority.
### :absent: The pool is empty.
routine PriorityQueue[TPriority, TElement].peek_entry!() -> PQEntry[TPriority, TElement]
    if me.count == 0
        absent
    return PQEntry[TPriority, TElement](priority: me.priorities[0], element: me.elements[0])

# ============================================================================
# Bulk Operations
# ============================================================================

### Inserts elements from `elements` paired with priorities from `priorities`.
### Only pairs up to the length of the shorter list are inserted; any extra values are ignored.
### :param elements: The elements to add.
### :param priorities: The priorities to assign at matching positions.
routine PriorityQueue[TPriority, TElement].add_all(elements: Accessing[List[TElement]], priorities: Accessing[List[TPriority]])
    var i = 0
    var limit = if elements.count() < priorities.count() then elements.count() else priorities.count()
    while i < limit
        me.add(element: elements[i], priority: priorities[i])
        i = i + 1
    return

### Removes all entries and returns their elements in removal order (smallest priority first).
### :returns: A `List[TElement]` whose order matches repeated `remove()` calls.
routine PriorityQueue[TPriority, TElement].drain() -> List[TElement]
    var result = List[TElement](capacity: me.count)
    while me.count > 0
        result.add_last(value: me.remove())
    return result

# ============================================================================
# Utility Operations
# ============================================================================

### Returns true if any stored entry carries `element`, scanning in heap order.
### :param element: The element value to search for.
routine PriorityQueue[TPriority, TElement].contains(element: TElement) -> Bool
needs TElement obeys Equatable
    var i = 0
    while i < me.count
        if me.elements[i] == element
            return true
        i = i + 1
    return false

### Creates a `List[PQEntry]` from the pool's entries in heap order, not sorted by priority.
### Use `drain()` on a copy if you need priority order without consuming the pool.
### :param source: The pool to copy entries from.
### :returns: A `List[PQEntry[TPriority, TElement]]` in heap order.
routine List[PQEntry[TPriority, TElement]](source: PriorityQueue[TPriority, TElement]) -> List[PQEntry[TPriority, TElement]]
    var result = List[PQEntry[TPriority, TElement]](capacity: source.count())
    each entry in source
        result.add_last(value: entry)
    return result

### Returns a walk over the entries in heap order.
routine PriorityQueue[TPriority, TElement].iter() -> PriorityQueueEmittable[TPriority, TElement]
    return PriorityQueueEmittable[TPriority, TElement](
        priorities: me.priorities.walk(first: 0, count: me.count),
        elements: me.elements.walk(first: 0, count: me.count),
        count: me.count,
        index: 0,
    )

### Returns the next heap entry in storage order.
### :returns: The next priority–element pair from the heap.
### :absent: All entries captured at iterator creation have been yielded.
routine PriorityQueueEmittable[TPriority, TElement].emit!() -> PQEntry[TPriority, TElement]
    if me.index >= me.count
        absent
    me.index = me.index + 1
    return PQEntry[TPriority, TElement](priority: me.priorities.emit(), element: me.elements.emit())

@override
routine PriorityQueue[TPriority, TElement].represent() -> Text
    return f"{me.type_name()}({me.entries_text()})"

@override
routine PriorityQueue[TPriority, TElement].diagnose() -> Text
    return f"{me.full_type_name()}(count: {me.count}, {me.entries_text()})"

# ============================================================================
# Inside the heap
# ============================================================================

### Moves the entry at `index` toward the root while its priority is smaller than its parent's.
secret routine PriorityQueue[TPriority, TElement].sift_up(index: Integer)
    var at = index
    while at > 0
        var parent = (at - 1) // 2
        if me.priorities[at] >= me.priorities[parent]
            return
        me.swap_entries(a: at, b: parent)
        at = parent
    return

### Moves the entry at `index` toward the leaves while a child has a smaller priority.
secret routine PriorityQueue[TPriority, TElement].sift_down(index: Integer)
    var at = index
    loop
        var child = 2 * at + 1
        if child >= me.count
            return
        var right = child + 1
        if right < me.count and me.priorities[right] < me.priorities[child]
            child = right
        if me.priorities[child] >= me.priorities[at]
            return
        me.swap_entries(a: at, b: child)
        at = child

### Swaps the entries at `a` and `b`.
secret routine PriorityQueue[TPriority, TElement].swap_entries(a: Integer, b: Integer)
    me.priorities.swap(first: a, second: b)
    me.elements.swap(first: a, second: b)
    return

### The entries as text, in heap order: `[1: "a", 3: "b"]`.
secret routine PriorityQueue[TPriority, TElement].entries_text() -> Text
    var result = "["
    var first = true
    each entry in me
        if not first
            result = f"{result}, "
        result = f"{result}{nested_repr(entry.priority)}: {nested_repr(entry.element)}"
        first = false
    return f"{result}]"
