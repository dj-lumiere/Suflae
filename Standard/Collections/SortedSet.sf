module Collections

import BuilderQuery

### A sorted, duplicate-free collection backed by a B-tree.
###
### `SortedSet[T]` automatically maintains its elements in ascending order.
### Inserting a value that already exists is a no-op. Insertion, deletion,
### membership testing, and rank-based access all run in O(log n) time.
### Iteration visits elements in ascending sorted order.
###
### **When to use**
### - You need a sorted set with no duplicates.
### - You need O(log n) insertion, removal, and membership testing.
### - You need O(log n) access by sorted rank.
### - You need efficient range queries over a sorted value space.
### - Use {SortedList[T]} instead when duplicate values must be preserved.
### - Use {Set[T]} instead when iteration order does not matter and throughput is critical.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `add` | O(log n) |
### | `remove` | O(log n) |
### | `contains` | O(log n) |
### | `min!` / `max!` | O(log n) |
### | `get_by_rank!` | O(log n) |
### | `range` | O(k log n), k = results |
### | Iteration | O(n log n) |
###
### :typeparam T: The stored element type. Must obey {Comparable}.
### :see: {SortedList[T]} for a sorted list that allows duplicates.
### :see: {Set[T]} for an unsorted, hash-table-backed set with O(1) operations.
### :see: {SortedDict[K, V]} for a sorted mapping from keys to values.
entity SortedSet[T]
relates SortedSetEmittable[T] as Iter
obeys Iterable[T], Container, SetLiteral[T]
needs T obeys Comparable
    ### The tree holding the elements as keys.
    secret tree: SortedTree[T, Bool]

### Walks the elements of a `SortedSet[T]` in ascending sorted order.
### :typeparam T: The element type yielded by the iterator.
entity SortedSetEmittable[T]
obeys Emittable[T]
needs T obeys Comparable
    ### The tree being walked, shared with the set.
    secret tree: SortedTree[T, Bool]
    ### The rank of the next element.
    secret index: U64

# ============================================================================
# Creators
# ============================================================================

### Creates an empty sorted set.
routine SortedSet[T]() -> SortedSet[T]
    return SortedSet[T](tree: SortedTree[T, Bool]())

### Creates a sorted set containing the given `elements` (duplicates collapsed). Variadic constructor behind the
### `{a, b, c}` set-literal syntax (the `SetLiteral` opt-in).
### :param elements: The elements to insert; duplicates are ignored.
### :returns: A sorted set of the distinct given elements.
common routine SortedSet[T].from_literal(elements...: T) -> SortedSet[T]
needs T obeys Comparable
    var result = SortedSet[T]()
    var i: U64 = 0
    while i < elements.count()
        result.add(value: elements.get_raw(index: i))
        i = i +% 1
    return result

# ============================================================================
# Core
# ============================================================================

### Returns the number of elements.
routine SortedSet[T].count() -> Integer
    return me.tree.count().to[Integer]()

### Returns true if this set contains no elements.
routine SortedSet[T].is_empty() -> Bool
    return me.tree.count() == 0

### Removes all elements.
routine SortedSet[T].clear()
    me.tree.clear()
    return

### Returns true if `value` is in this set.
### :param value: The value to search for.
routine SortedSet[T].has(value: T) -> Bool
    return me.tree.has_key(key: value)

### Returns whether `value` is not in this value: the opposite of `has`.
### :param value: The value to look for.
### :returns: `true` when `value` is absent.
routine SortedSet[T].lacks(value: T) -> Bool
    return not me.has(value)

### Adds `value` unless it is already in the set.
### :param value: The value to add.
### :returns: `true` when the value was new.
@discardable
routine SortedSet[T].add(value: T) -> Bool
    if me.tree.has_key(key: value)
        return false
    me.tree.insert(key: value, value: true)
    return true

### Removes `value` from the set if it is present.
### :param value: The value to remove.
### :returns: `true` if the value was found and removed; `false` if it was not present.
@discardable
routine SortedSet[T].remove(value: T) -> Bool
    return me.tree.remove(key: value)

# ============================================================================
# Rank-based access
# ============================================================================

### Returns the element at zero-based sorted rank `rank`.
### :param rank: Zero-based position in sorted order.
### :returns: The element at that rank.
### :throws: {IndexOutOfBoundsError} if `rank >= count()`.
failable routine SortedSet[T].get_by_rank(rank: Integer) -> T
    var position = position_of(value: rank)
    var count = me.tree.count()
    if position >= count
        throw IndexOutOfBoundsError(index: position, count: count)
    return me.tree.key_at(rank: position)

### Returns all elements in the closed interval `[min_val, max_val]`, in ascending order.
### :param min_val: Inclusive lower bound.
### :param max_val: Inclusive upper bound.
### :returns: A {List[T]} of all matching elements in sorted order.
routine SortedSet[T].range(min_val: T, max_val: T) -> List[T]
    var result = List[T]()
    var rank = me.tree.rank(key: min_val, after: false)
    var end = me.tree.rank(key: max_val, after: true)
    while rank < end
        result.add_last(value: me.tree.key_at(rank: rank))
        rank = rank + 1
    return result

# ============================================================================
# Min/Max
# ============================================================================

### Returns the smallest element in the set.
### :throws: {AbsentValueError} The set is empty.
failable routine SortedSet[T].min() -> T
    if me.is_empty()
        throw AbsentValueError()
    return me.tree.key_at(rank: 0)

### Returns the largest element in the set.
### :throws: {AbsentValueError} The set is empty.
failable routine SortedSet[T].max() -> T
    if me.is_empty()
        throw AbsentValueError()
    return me.tree.key_at(rank: me.tree.count() - 1)

### Returns the smallest element. Alias for {SortedSet[T].min()}.
### :throws: {AbsentValueError} The set is empty.
failable routine SortedSet[T].first() -> T
    return me.min()

### Returns the largest element. Alias for {SortedSet[T].max()}.
### :throws: {AbsentValueError} The set is empty.
failable routine SortedSet[T].last() -> T
    return me.max()

# ============================================================================
# Iteration
# ============================================================================

### Returns a walk over the elements in ascending order.
routine SortedSet[T].iter() -> SortedSetEmittable[T]
    return SortedSetEmittable[T](tree: me.tree, index: 0)

### Returns the next element.
### :throws: {AbsentValueError} The walk is over.
failable routine SortedSetEmittable[T].emit() -> T
    if me.index >= me.tree.count()
        throw AbsentValueError()
    var result = me.tree.key_at(rank: me.index)
    me.index = me.index + 1
    return result

### Creates a {List[T]} from all elements of `from` in ascending sorted order.
### :returns: A new {List[T]} containing all elements in ascending order.
routine SortedSet[T].to[List[T]]() -> List[T]
    var result = List[T](capacity: me.count())
    each value in me
        result.add_last(value: value)
    return result

# ============================================================================
# Display / Equality
# ============================================================================

@override
routine SortedSet[T].represent() -> Text
    return f"{me.type_name()}({{{me.items_text()}}})"

### Returns a diagnostic form that includes the runtime type name and element count.
@override
routine SortedSet[T].diagnose() -> Text
    return f"{me.full_type_name()}(count: {me.count()}, {{{me.items_text()}}})"

### Returns true if both sets contain exactly the same values.
### :param you: The other set to compare against.
routine SortedSet[T].eq(you: SortedSet[T]) -> Bool
    var count = me.tree.count()
    if count != you.tree.count()
        return false
    var i: U64 = 0
    while i < count
        if me.tree.key_at(rank: i) != you.tree.key_at(rank: i)
            return false
        i = i + 1
    return true

### Serializes this collection to a `SerialValue.List`, serializing each element.
### :returns: The `SerialValue.List` of each element's serialized form.
@override
routine SortedSet[T].serialize() -> SerialValue
    var result = RF::System.List[SerialValue]()
    each value in me
        result.add_last(value: value.serialize())
    return SerialValue(result.duplicate())

### Builds the set from its serialized element list.
### :throws: {SerialShapeError} when the value is not a list or an element does not fit `T`.
failable common routine SortedSet[T].from_serial(value: SerialValue) -> SortedSet[T]
    var result = SortedSet[T]()
    when value
        is RF::System.List[SerialValue] as items =>
            each item in items
                result.add(value: serial_decode[T](value: item))
        else =>
            throw SerialShapeError(detail: "expected a list")
    return result

### The elements as text: `1, 2, 3`.
secret routine SortedSet[T].items_text() -> Text
    var result = ""
    var first = true
    each value in me
        if not first
            result = f"{result}, "
        result = f"{result}{nested_repr(value)}"
        first = false
    return result
