module Core

import BuilderQuery
import Numerics

### The longest run sorted by insertion before the merge passes begin.
secret preset SORT_MIN_RUN: U64 = 32u64

### A growable, contiguous sequence of elements with amortized O(1) append, counted and indexed with
### `Integer`.
###
### `List[T]` stores elements in a single resizable heap buffer. Reading or writing by position is O(1).
### Appending to the back is O(1) amortized because the buffer grows geometrically when it runs out of room.
### Inserting or removing near the front is O(n), since the elements after it move.
###
### Positions count from 0. A negative position crashes with `NegativeIndexError`, one at or past the end
### with `IndexOutOfBoundsError`.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `add_last` | O(1) amortized |
### | `remove_last` | O(1) |
### | `add_first` / `add_at` | O(n) |
### | `remove_first` / `remove_at` | O(n) |
### | `xs[i]` / `xs[i] = v` | O(1) |
### | `have` | O(n) |
### | `sort` | O(n log n) |
### | Iteration | O(n) |
###
### :typeparam T: The element type stored in the list.
entity List[T]
relates ListEmittable[T] as Iter
obeys Iterable[T], Container, Equatable, Copyable onlyif T obeys Assignable, ListLiteral[T]
    ### The backing buffer.
    secret data: Hijacked[T]
    ### The number of elements in the buffer.
    secret count: U64
    ### The number of elements the buffer holds without growing.
    secret capacity: U64

### Walks the elements of a `List[T]` from front to back.
### :typeparam T: The element type produced.
entity ListEmittable[T]
obeys Emittable[T]
    ### The list's buffer.
    secret data: Hijacked[T]
    ### The number of elements when the walk began.
    secret count: U64
    ### The next position to read.
    secret index: U64

# ============================================================================
# Creators
# ============================================================================

### Creates an empty list.
routine List[T]() -> List[T]
    return List[T](data: hijacked_none[T](), count: 0_u64, capacity: 0_u64)

### Creates an empty list with room for at least `capacity` elements.
### :param capacity: The number of elements to make room for.
routine List[T](capacity: Integer) -> List[T]
    var result = List[T]()
    result.reserve_raw(new_capacity: U64(from: capacity))
    return result

### Creates a list of `count` copies of `fill_value`.
### :param count: The number of elements.
### :param fill_value: The value every element starts as.
routine List[T](count: Integer, fill_value: T) -> List[T]
needs T obeys Assignable
    var result = List[T]()
    var n = U64(from: count)
    result.reserve_raw(new_capacity: n)
    var i: U64 = 0
    while i < n
        result.add_last(value: fill_value)
        i = i +% 1
    return result

### Makes a Suflae list of the elements of a list from RazorForge code (a RazorForge library routine's result).
### :param from: The RazorForge list.
routine List[T](from: RF::Core.List[T]) -> List[T]
needs T obeys Assignable
    var result = List[T]()
    result.reserve_raw(new_capacity: from.count())
    each element in from
        result.add_last(value: element.assign())
    return result

### Returns a RazorForge list of copies of the elements, for a RazorForge library routine that takes one.
@readonly
routine List[T].to_razorforge() -> RF::Core.List[T]
needs T obeys Assignable
    var result = RF::Core.List[T](capacity: me.count)
    var i: U64 = 0
    while i < me.count
        result.add_last(value: me.get_raw(index: i).assign())
        i = i +% 1
    return result

### Builds a list from its serialized element list.
### :throws: {SerialShapeError} when the value is not a list or an element does not fit `T`.
routine List[T]!(from: SerialValue) -> List[T]
    var result = List[T]()
    when from
        is RF::Core.List[SerialValue] items =>
            each item in items
                result.add_last(value: serial_decode[T](value: item))
        else =>
            throw SerialShapeError(detail: "expected a list")
    return result

### Builds the list a `[a, b, c]` literal writes.
### :param elements: The elements, in order.
common routine List[T].from_literal(elements...: T) -> List[T]
    var result = List[T]()
    var i: U64 = 0
    # Each element moves into the list: `add_last` makes the list's holder, and the caller releases the
    # literal's own afterwards.
    while i < elements.count()
        result.add_last(value: elements.get_raw(index: i))
        i = i +% 1
    return result

# ============================================================================
# Size
# ============================================================================

### Returns the number of elements.
@readonly
routine List[T].count() -> Integer
    return Integer(from: me.count)

### Returns the number of elements the list holds without growing.
@readonly
routine List[T].capacity() -> Integer
    return Integer(from: me.capacity)

### Returns whether the list has no elements.
@readonly
routine List[T].is_empty() -> Bool
    return me.count == 0_u64

# ============================================================================
# Adding and removing
# ============================================================================

### Adds `value` at the back. The buffer grows when it is full.
### :param value: The value to add.
@reshaping
routine List[T].add_last(value: T)
    if me.count >= me.capacity
        me.reserve_raw(
            new_capacity: next_grow_capacity(
                current: me.capacity,
                min_needed: me.count +% 1,
                element_size: T.data_size().byte_size(),
            ),
        )
    danger
        me.data.offset(T.data_size() * me.count).poke(value)
    me.count = me.count +% 1
    return

### Adds every element of `you` at the back, in order.
### :param you: The elements to add.
@reshaping
routine List[T].add_range(you: Accessing[Iterable[T]])
    each value in you
        me.add_last(value: value)
    return

### Adds `count` elements of `source`, starting at `from`, at the back of this list.
### :param source: The list to copy from.
### :param from: The first position of `source` to copy.
### :param count: How many elements to copy.
@reshaping
routine List[T].add_range!(source: Accessing[List[T]], from: Integer, count: Integer)
needs T obeys Assignable
    var start = source.position(index: from)
    var n = U64(from: count)
    if start + n > source.count
        throw IndexOutOfBoundsError(index: start + n, count: source.count)
    me.reserve_raw(new_capacity: me.count + n)
    var i: U64 = 0
    while i < n
        me.add_last(value: source.get_raw(index: start + i).assign())
        i = i +% 1
    return

### Removes and returns the last element.
### :absent: The list is empty.
@reshaping
routine List[T].remove_last!() -> T
    if me.count == 0_u64
        absent
    me.count = me.count - 1
    return me.get_raw(index: me.count)

### Adds `value` at the front, moving every element one place back.
### :param value: The value to add.
@reshaping
routine List[T].add_first(value: T)
    me.insert_raw(position: 0_u64, value: value)
    return

### Inserts `value` at `index`, moving the elements from there one place back.
### :param index: Where the new element goes, from 0 to `count()`.
### :param value: The value to insert.
@reshaping
routine List[T].add_at!(index: Integer, value: T)
    if index.is_negative()
        throw NegativeIndexError(index: index)
    var position = U64(from: index)
    if position > me.count
        throw IndexOutOfBoundsError(index: position, count: me.count)
    me.insert_raw(position: position, value: value)
    return

### Removes and returns the first element, moving the others one place forward.
### :absent: The list is empty.
@reshaping
routine List[T].remove_first!() -> T
    if me.count == 0_u64
        absent
    return me.remove_raw(position: 0_u64)

### Removes and returns the element at `index`, moving the elements after it one place forward.
### :param index: The position to remove.
@reshaping
routine List[T].remove_at!(index: Integer) -> T
    return me.remove_raw(position: me.position(index: index))

### Keeps the first `new_count` elements and removes the rest.
### :param new_count: How many elements to keep.
@reshaping
routine List[T].truncate!(new_count: Integer)
    if new_count.is_negative()
        throw NegativeIndexError(index: new_count)
    var n = U64(from: new_count)
    if n > me.count
        throw IndexOutOfBoundsError(index: n, count: me.count)
    me.count = n
    return

### Removes every element and keeps the buffer.
@reshaping
routine List[T].clear()
    me.count = 0_u64
    return

### Makes room for at least `new_capacity` elements without growing again.
### :param new_capacity: The number of elements to make room for.
@reshaping
routine List[T].reserve(new_capacity: Integer)
    me.reserve_raw(new_capacity: U64(from: new_capacity))
    return

# ============================================================================
# Reading and writing by position
# ============================================================================

### Returns the first element.
### :absent: The list is empty.
@readonly
routine List[T].first!() -> T
needs T obeys Assignable
    if me.count == 0_u64
        absent
    return me.get_raw(index: 0_u64).assign()

### Returns the last element.
### :absent: The list is empty.
@readonly
routine List[T].last!() -> T
needs T obeys Assignable
    if me.count == 0_u64
        absent
    return me.get_raw(index: me.count - 1).assign()

### Returns the element at `index` (`xs[i]`).
### :param index: The position to read.
@readonly
routine List[T].getitem!(index: Integer) -> T
needs T obeys Assignable
    # A holder of its own: the list keeps its element, the caller gets one more (a share for a handle).
    return me.get_raw(index: me.position(index: index)).assign()

### Replaces the element at `index` (`xs[i] = v`).
### :param index: The position to write.
### :param value: The new element.
routine List[T].setitem!(index: Integer, value: T)
    var position = me.position(index: index)
    danger
        me.data.offset(T.data_size() * position).poke(value)
    return

### Returns a new list of the elements at the positions in `range` (`xs[a til b]`). Positions outside the
### list are skipped, and a descending range gives the elements in reverse.
### :param range: The positions to copy.
@readonly
routine List[T].getitem(range: Range[Integer]) -> List[T]
needs T obeys Assignable
    var result = List[T]()
    each i in range
        if not i.is_negative() and i < me.count()
            result.add_last(value: me.get_raw(index: U64(from: i)).assign())
    return result

# ============================================================================
# Iteration, comparison and display
# ============================================================================

### Returns a walk over the elements, front to back.
@readonly
routine List[T].iter() -> ListEmittable[T]
    return ListEmittable[T](data: me.data, count: me.count, index: 0_u64)

### Returns the next element of the walk.
### :absent: The walk is over.
routine ListEmittable[T].emit!() -> T
    if me.index >= me.count
        absent
    danger
        var result = me.data.offset(T.data_size() * me.index).peek()
        me.index = me.index +% 1
        return result

### Returns whether both lists hold equal elements in the same order.
### :param you: The other list.
@readonly
routine List[T].eq(you: Accessing[List[T]]) -> Bool
needs T obeys Equatable
    if me.count != you.count
        return false
    var i: U64 = 0
    while i < me.count
        if me.get_raw(index: i) != you.get_raw(index: i)
            return false
        i = i +% 1
    return true

### Returns whether some element equals `value` (`xs have v`).
### :param value: The value to look for.
@readonly
routine List[T].contains(value: Accessing[T]) -> Bool
needs T obeys Equatable
    var i: U64 = 0
    while i < me.count
        if me.get_raw(index: i) == value
            return true
        i = i +% 1
    return false

### Returns the list as text: `[1, 2, 3]`.
@readonly
@override
routine List[T].represent() -> Text
    var result = "["
    var i: U64 = 0
    while i < me.count
        if i > 0_u64
            result = result + ", "
        result = result + nested_repr(me.get_raw(index: i))
        i = i +% 1
    return result + "]"

### Returns the list's diagnostic text: its type, count and elements.
@readonly
@override
routine List[T].diagnose() -> Text
    var result = me.full_type_name() + "(count: " + me.count().represent() + ", ["
    var i: U64 = 0
    while i < me.count
        if i > 0_u64
            result = result + ", "
        result = result + nested_repr(me.get_raw(index: i))
        i = i +% 1
    return result + "])"

### Returns a new list holding copies of the elements.
routine List[T].duplicate() -> List[T]
needs T obeys Assignable
    var result = List[T]()
    result.reserve_raw(new_capacity: me.count)
    var i: U64 = 0
    while i < me.count
        result.add_last(value: me.get_raw(index: i).assign())
        i = i +% 1
    return result

### Returns the list as a `SerialValue.List` of its serialized elements.
@readonly
@override
routine List[T].serialize() -> SerialValue
    var result = RF::Core.List[SerialValue]()
    var i: U64 = 0
    while i < me.count
        result.add_last(value: me.get_raw(index: i).serialize())
        i = i +% 1
    return SerialValue(result.duplicate())

# ============================================================================
# Ordering
# ============================================================================

### Sorts the elements in ascending order. The sort is stable: equal elements keep their order.
routine List[T].sort()
needs T obeys Comparable
    me.sort_less()
    return

### Sorts the elements so that `compare(a, b)` holds for every `a` before `b` it decides. Stable.
### :param compare: Returns whether its first argument goes before its second.
routine List[T].sort_by(compare: Routine[(T, T), Bool])
    me.sort_raw(compare: compare)
    return

### Returns a new list of the elements in ascending order.
@readonly
routine List[T].sorted() -> List[T]
needs T obeys Comparable
    var result = me.duplicate()
    result.sort()
    return result

### Returns a new list of the elements, ordered by `compare`.
### :param compare: Returns whether its first argument goes before its second.
@readonly
routine List[T].sorted_by(compare: Routine[(T, T), Bool]) -> List[T]
    var result = me.duplicate()
    result.sort_by(compare: compare)
    return result

### Reverses the order of the elements.
routine List[T].reverse_in_place()
    if me.count <= 1_u64
        return
    var lo: U64 = 0
    var hi = me.count - 1
    while lo < hi
        var temp = me.get_raw(index: lo)
        me.set_raw(index: lo, value: me.get_raw(index: hi))
        me.set_raw(index: hi, value: temp)
        lo = lo + 1
        hi = hi - 1
    return

# ============================================================================
# Inside the list
# ============================================================================

### The buffer position of `index`, checked against the list.
secret routine List[T].position!(index: Integer) -> U64
    if index.is_negative()
        throw NegativeIndexError(index: index)
    var position = U64(from: index)
    if position >= me.count
        throw IndexOutOfBoundsError(index: position, count: me.count)
    return position

### The element at a position already checked.
@readonly
@inline
secret routine List[T].get_raw(index: U64) -> T
    danger
        return me.data.offset(T.data_size() * index).peek()

### Writes the element at a position already checked.
@inline
secret routine List[T].set_raw(index: U64, value: T)
    danger
        me.data.offset(T.data_size() * index).poke(value)
    return

### Grows the buffer to hold at least `new_capacity` elements.
secret routine List[T].reserve_raw(new_capacity: U64)
    if new_capacity <= me.capacity
        return
    var size = T.data_size() * new_capacity
    danger
        if me.data.is_none()
            me.data = hijacked_from[T](rf_allocate_dynamic_uninit(size))
        else
            me.data = hijacked_from[T](
                rf_reallocate_dynamic(ptr: LLVM::pointer_to_int[T, Address](me.data), size: size),
            )
    me.capacity = new_capacity
    return

### Inserts at a position already checked (at most the count), moving the elements after it back.
secret routine List[T].insert_raw(position: U64, value: T)
    if me.count >= me.capacity
        me.reserve_raw(
            new_capacity: next_grow_capacity(
                current: me.capacity,
                min_needed: me.count +% 1,
                element_size: T.data_size().byte_size(),
            ),
        )
    var size = T.data_size()
    if position < me.count
        danger
            rf_copy_bytes_at(
                dest: me.data.offset(size * (position + 1)).get_address(),
                src: me.data.offset(size * position).get_address(),
                size: size * (me.count - position),
            )
    danger
        me.data.offset(size * position).poke(value)
    me.count = me.count + 1
    return

### Removes at a position already checked, moving the elements after it forward.
secret routine List[T].remove_raw(position: U64) -> T
    var size = T.data_size()
    var value = me.get_raw(index: position)
    if position + 1 < me.count
        danger
            rf_copy_bytes_at(
                dest: me.data.offset(size * position).get_address(),
                src: me.data.offset(size * (position + 1)).get_address(),
                size: size * (me.count - 1 - position),
            )
    me.count = me.count - 1
    return value

### Stable merge sort: insertion sort on short runs, then bottom-up merges through a buffer.
secret routine List[T].sort_raw(compare: Routine[(T, T), Bool])
    if me.count <= 1_u64
        return
    var start: U64 = 0
    while start < me.count
        var end = start + SORT_MIN_RUN
        if end > me.count
            end = me.count
        me.insertion_sort_raw(start: start, end: end, compare: compare)
        start = start + SORT_MIN_RUN
    if me.count <= SORT_MIN_RUN
        return
    var buffer = List[T]()
    buffer.reserve_raw(new_capacity: me.count)
    var width = SORT_MIN_RUN
    while width < me.count
        var left: U64 = 0
        while left < me.count
            var mid = left + width
            if mid > me.count
                mid = me.count
            var right = left + width *% 2
            if right > me.count
                right = me.count
            if mid < right
                me.merge_raw(left: left, mid: mid, right: right, buffer: buffer, compare: compare)
            left = left + width *% 2
        width = width *% 2
    # The buffer only borrowed the elements: forget them before it is torn down.
    buffer.count = 0_u64
    return

### Insertion sort of the positions `start` up to `end`.
secret routine List[T].insertion_sort_raw(start: U64, end: U64, compare: Routine[(T, T), Bool])
    var i = start + 1
    while i < end
        var key = me.get_raw(index: i)
        var j = i
        while j > start and compare(key, me.get_raw(index: j - 1))
            me.set_raw(index: j, value: me.get_raw(index: j - 1))
            j = j - 1
        me.set_raw(index: j, value: key)
        i = i + 1
    return

### Merges the sorted runs `left` up to `mid` and `mid` up to `right`, through `buffer`.
secret routine List[T].merge_raw(left: U64, mid: U64, right: U64, buffer: Controlling[List[T]],
    compare: Routine[(T, T), Bool])
    var i = left
    while i < right
        buffer.set_raw(index: i, value: me.get_raw(index: i))
        i = i + 1
    var a = left
    var b = mid
    var out = left
    while a < mid and b < right
        var va = buffer.get_raw(index: a)
        var vb = buffer.get_raw(index: b)
        if compare(vb, va)
            me.set_raw(index: out, value: vb)
            b = b + 1
        else
            me.set_raw(index: out, value: va)
            a = a + 1
        out = out + 1
    while a < mid
        me.set_raw(index: out, value: buffer.get_raw(index: a))
        a = a + 1
        out = out + 1
    while b < right
        me.set_raw(index: out, value: buffer.get_raw(index: b))
        b = b + 1
        out = out + 1
    return

### The same sort, ordering by `<`.
secret routine List[T].sort_less()
needs T obeys Comparable
    if me.count <= 1_u64
        return
    var start: U64 = 0
    while start < me.count
        var end = start + SORT_MIN_RUN
        if end > me.count
            end = me.count
        me.insertion_sort_less(start: start, end: end)
        start = start + SORT_MIN_RUN
    if me.count <= SORT_MIN_RUN
        return
    var buffer = List[T]()
    buffer.reserve_raw(new_capacity: me.count)
    var width = SORT_MIN_RUN
    while width < me.count
        var left: U64 = 0
        while left < me.count
            var mid = left + width
            if mid > me.count
                mid = me.count
            var right = left + width *% 2
            if right > me.count
                right = me.count
            if mid < right
                me.merge_less(left: left, mid: mid, right: right, buffer: buffer)
            left = left + width *% 2
        width = width *% 2
    # The buffer only borrowed the elements: forget them before it is torn down.
    buffer.count = 0_u64
    return

### The same insertion sort, ordering by `<`.
secret routine List[T].insertion_sort_less(start: U64, end: U64)
needs T obeys Comparable
    var i = start + 1
    while i < end
        var key = me.get_raw(index: i)
        var j = i
        while j > start and key < me.get_raw(index: j - 1)
            me.set_raw(index: j, value: me.get_raw(index: j - 1))
            j = j - 1
        me.set_raw(index: j, value: key)
        i = i + 1
    return

### The same merge, ordering by `<`.
secret routine List[T].merge_less(left: U64, mid: U64, right: U64, buffer: Controlling[List[T]])
needs T obeys Comparable
    var i = left
    while i < right
        buffer.set_raw(index: i, value: me.get_raw(index: i))
        i = i + 1
    var a = left
    var b = mid
    var out = left
    while a < mid and b < right
        var va = buffer.get_raw(index: a)
        var vb = buffer.get_raw(index: b)
        if vb < va
            me.set_raw(index: out, value: vb)
            b = b + 1
        else
            me.set_raw(index: out, value: va)
            a = a + 1
        out = out + 1
    while a < mid
        me.set_raw(index: out, value: buffer.get_raw(index: a))
        a = a + 1
        out = out + 1
    while b < right
        me.set_raw(index: out, value: buffer.get_raw(index: b))
        b = b + 1
        out = out + 1
    return

# ============================================================================
# Lifetime
# ============================================================================

### Destroys each element, then frees the buffer.
@override
dangerous routine List[T].destroy()
    var i: U64 = 0
    while i < me.count
        me.data.offset(T.data_size() * i).peek().destroy()
        i = i +% 1
    me.data.invalidate()
    me.hijack().invalidate()
    return

### Cycle-collector trace: reports every element to the collector through the buffer.
@override
dangerous routine List[T].roam_trace()
    me.data.cyclic_trace_buffer(count: me.count)
    return

### Cycle-collector free: frees the buffer and the list's own box, not the elements (the collector frees
### the whole cycle itself).
@override
dangerous routine List[T].roam_free()
    me.data.invalidate()
    me.hijack().invalidate()
    return
