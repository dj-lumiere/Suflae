module Core

import BuilderQuery
import Numerics

### A growable sequence of elements with amortized O(1) append, counted and indexed with `Integer`.
###
### `List[T]` keeps its elements in a `Buffer[T]`. Reading or writing by position is O(1). Appending to the back
### is O(1) amortized because the list moves into a buffer twice the size when it runs out of room. Inserting or
### removing near the front is O(n), since the elements after it move.
###
### Positions count from 0. A negative position crashes with `NegativeIndexError`, one at or past the end
### with `IndexOutOfBoundsError`.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `add_last` | O(1) amortized |
### | `remove_last` | O(1) |
### | `add_first` / `add_at` | O(n) |
### | `remove_first` / `remove_at` | O(n) |
### | `xs[i]` / `xs[i] = v` | O(1) |
### | `have` | O(n) |
### | `sort` | O(n log n) |
### | Iteration | O(n) |
###
### :typeparam T: The element type stored in the list.
entity List[T]
relates BufferEmittable[T] as Iter
obeys Iterable[T], Container, Equatable, Copyable, ListLiteral[T]
    ### The elements, and the room for more.
    secret items: Buffer[T]

# ============================================================================
# Creators
# ============================================================================

### Creates an empty list.
routine List[T]() -> List[T]
    return List[T](items: Buffer[T](capacity: 0))

### Creates an empty list with room for at least `capacity` elements.
### :param capacity: The number of elements to make room for.
routine List[T](capacity: Integer) -> List[T]
    return List[T](items: Buffer[T](capacity: capacity))

### Creates a list of `count` copies of `fill_value`.
### :param count: The number of elements.
### :param fill_value: The value every element starts as.
routine List[T](count: Integer, fill_value: T) -> List[T]
    return List[T](items: Buffer[T](count: count, fill: fill_value))

### Makes a Suflae list of the elements of a list from RazorForge code (a RazorForge library routine's result).
### :param from: The RazorForge list.
routine List[T](from: RF::Core.List[T]) -> List[T]
    var result = List[T](capacity: Integer(from: from.count()))
    each element in from
        result.add_last(value: element)
    return result

### Returns a RazorForge list of copies of the elements, for a RazorForge library routine that takes one.
routine List[T].to_razorforge() -> RF::Core.List[T]
    var result = RF::Core.List[T](capacity: U64(from: me.count()))
    each element in me.items
        result.add_last(value: element)
    return result

### Builds a list from its serialized element list.
### :throws: {SerialShapeError} when the value is not a list or an element does not fit `T`.
routine List[T]!(from: SerialValue) -> List[T]
    var result = List[T]()
    when from
        is RF::Core.List[SerialValue] items =>
            each item in items
                result.add_last(value: serial_decode[T](value: item))
        else =>
            throw SerialShapeError(detail: "expected a list")
    return result

### Builds the list a `[a, b, c]` literal writes.
### :param elements: The elements, in order.
common routine List[T].from_literal(elements...: T) -> List[T]
    var result = List[T](capacity: Integer(from: elements.count()))
    var i: U64 = 0
    # Each element moves into the list: `add_last` makes the list's holder, and the caller releases the
    # literal's own afterwards.
    while i < elements.count()
        result.add_last(value: elements.get_raw(index: i))
        i = i +% 1
    return result

# ============================================================================
# Size
# ============================================================================

### Returns the number of elements.
routine List[T].count() -> Integer
    return me.items.count()

### Returns the number of elements the list holds without growing.
routine List[T].capacity() -> Integer
    return me.items.capacity()

### Returns whether the list has no elements.
routine List[T].is_empty() -> Bool
    return me.items.is_empty()

# ============================================================================
# Adding and removing
# ============================================================================

### Adds `value` at the back. The list moves into a bigger buffer when it is full.
### :param value: The value to add.
routine List[T].add_last(value: T)
    me.make_room(extra: 1)
    me.items.add_last(value: value)
    return

### Adds every element of `you` at the back, in order.
### :param you: The elements to add.
routine List[T].add_range(you: Accessing[Iterable[T]])
    each value in you
        me.add_last(value: value)
    return

### Adds `count` elements of `source`, starting at `from`, at the back of this list.
### :param source: The list to copy from.
### :param from: The first position of `source` to copy.
### :param count: How many elements to copy.
routine List[T].add_range!(source: Accessing[List[T]], from: Integer, count: Integer)
    if from.is_negative()
        throw NegativeIndexError(index: from)
    if count.is_negative()
        throw NegativeIndexError(index: count)
    if from + count > source.count()
        throw IndexOutOfBoundsError(index: U64(from: from + count), count: U64(from: source.count()))
    me.make_room(extra: count)
    var i = 0
    while i < count
        me.items.add_last(value: source.items[from + i])
        i = i + 1
    return

### Removes and returns the last element.
### :absent: The list is empty.
routine List[T].remove_last!() -> T
    if me.items.is_empty()
        absent
    return me.items.remove_last()

### Adds `value` at the front, moving every element one place back.
### :param value: The value to add.
routine List[T].add_first(value: T)
    me.make_room(extra: 1)
    me.items.insert(index: 0, value: value)
    return

### Inserts `value` at `index`, moving the elements from there one place back.
### :param index: Where the new element goes, from 0 to `count()`.
### :param value: The value to insert.
routine List[T].add_at!(index: Integer, value: T)
    me.make_room(extra: 1)
    me.items.insert(index: index, value: value)
    return

### Removes and returns the first element, moving the others one place forward.
### :absent: The list is empty.
routine List[T].remove_first!() -> T
    if me.items.is_empty()
        absent
    return me.items.remove_at(index: 0)

### Removes and returns the element at `index`, moving the elements after it one place forward.
### :param index: The position to remove.
routine List[T].remove_at!(index: Integer) -> T
    return me.items.remove_at(index: index)

### Keeps the first `new_count` elements and removes the rest.
### :param new_count: How many elements to keep.
routine List[T].truncate!(new_count: Integer)
    me.items.truncate(count: new_count)
    return

### Removes every element and keeps the room.
routine List[T].clear()
    me.items.clear()
    return

### Makes room for at least `new_capacity` elements without growing again.
### :param new_capacity: The number of elements to make room for.
routine List[T].reserve(new_capacity: Integer)
    if new_capacity > me.items.capacity()
        me.items.grow(capacity: new_capacity)
    return

# ============================================================================
# Reading and writing by position
# ============================================================================

### Returns the first element.
### :absent: The list is empty.
routine List[T].first!() -> T
    if me.items.is_empty()
        absent
    return me.items[0]

### Returns the last element.
### :absent: The list is empty.
routine List[T].last!() -> T
    if me.items.is_empty()
        absent
    return me.items[me.items.count() - 1]

### Returns the element at `index` (`xs[i]`).
### :param index: The position to read.
routine List[T].getitem!(index: Integer) -> T
    return me.items[index]

### Replaces the element at `index` (`xs[i] = v`).
### :param index: The position to write.
### :param value: The new element.
routine List[T].setitem!(index: Integer, value: T)
    me.items[index] = value
    return

### Returns a new list of the elements at the positions in `range` (`xs[a til b]`). Positions outside the
### list are skipped, and a descending range gives the elements in reverse.
### :param range: The positions to copy.
routine List[T].getitem(range: Range[Integer]) -> List[T]
    var result = List[T]()
    each i in range
        if not i.is_negative() and i < me.count()
            result.add_last(value: me.items[i])
    return result

# ============================================================================
# Iteration, comparison and display
# ============================================================================

### Returns a walk over the elements, front to back.
routine List[T].iter() -> BufferEmittable[T]
    return me.items.iter()

### Returns whether both lists hold equal elements in the same order.
### :param you: The other list.
routine List[T].eq(you: Accessing[List[T]]) -> Bool
needs T obeys Equatable
    if me.count() != you.count()
        return false
    var i = 0
    while i < me.count()
        if me.items[i] != you.items[i]
            return false
        i = i + 1
    return true

### Returns whether some element equals `value` (`xs have v`).
### :param value: The value to look for.
routine List[T].contains(value: Accessing[T]) -> Bool
needs T obeys Equatable
    return me.items.contains(value: value)

### Returns the list as text: `[1, 2, 3]`.
@override
routine List[T].represent() -> Text
    return me.items.elements_text()

### Returns the list's diagnostic text: its type, count and elements.
@override
routine List[T].diagnose() -> Text
    return f"{me.full_type_name()}(count: {me.count()}, {me.items.elements_text()})"

### Returns a new list holding copies of the elements.
routine List[T].duplicate() -> List[T]
    var result = List[T](capacity: me.count())
    each element in me.items
        result.items.add_last(value: element)
    return result

### Returns the list as a `SerialValue.List` of its serialized elements.
@override
routine List[T].serialize() -> SerialValue
    var result = RF::Core.List[SerialValue]()
    each element in me.items
        result.add_last(value: element.serialize())
    return SerialValue(result.duplicate())

# ============================================================================
# Ordering
# ============================================================================

### Sorts the elements in ascending order. The sort is stable: equal elements keep their order.
routine List[T].sort()
needs T obeys Comparable
    me.items.sort()
    return

### Sorts the elements so that `compare(a, b)` holds for every `a` before `b` it decides. Stable.
### :param compare: Returns whether its first argument goes before its second.
routine List[T].sort_by(compare: Routine[(T, T), Bool])
    me.items.sort_by(compare: compare)
    return

### Returns a new list of the elements in ascending order.
routine List[T].sorted() -> List[T]
needs T obeys Comparable
    var result = me.duplicate()
    result.sort()
    return result

### Returns a new list of the elements, ordered by `compare`.
### :param compare: Returns whether its first argument goes before its second.
routine List[T].sorted_by(compare: Routine[(T, T), Bool]) -> List[T]
    var result = me.duplicate()
    result.sort_by(compare: compare)
    return result

### Reverses the order of the elements.
routine List[T].reverse_in_place()
    me.items.reverse()
    return

# ============================================================================
# Inside the list
# ============================================================================

### Moves into a bigger buffer when fewer than `extra` places are free: twice the room, or as much as needed.
secret routine List[T].make_room(extra: Integer)
    var needed = me.items.count() + extra
    var room = me.items.capacity()
    if needed <= room
        return
    var grown = if room < 4 then 4 else room * 2
    if grown < needed
        grown = needed
    me.items.grow(capacity: grown)
    return
