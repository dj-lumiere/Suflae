module Core

import Numerics

# Suflae's surface of the fixed-size `Array[T, COUNT]`: the same record as RazorForge's, counted and indexed with
# `Integer`. A Suflae program calls these in place of the RazorForge routines of the same names.

### Returns the number of elements, `COUNT`.
@readonly
routine Array[T, COUNT].count() -> Integer
    var n: U64 = COUNT
    return Integer(from: n)

### Returns the element at `index` (`a[i]`).
### :param index: The position to read, from 0.
@readonly
routine Array[T, COUNT].getitem!(index: Integer) -> T
needs T obeys Assignable
    var position = position_of(value: index)
    if position >= COUNT
        throw IndexOutOfBoundsError(index: position, count: COUNT)
    return me.get_raw(index: position).assign()

### Replaces the element at `index` (`a[i] = v`).
### :param index: The position to write, from 0.
### :param value: The new element.
routine Array[T, COUNT].setitem!(index: Integer, value: T)
    var position = position_of(value: index)
    if position >= COUNT
        throw IndexOutOfBoundsError(index: position, count: COUNT)
    danger
        LLVM::store_element_ref[Array[T, COUNT], T](me.hijack(), position, value)
    return

### Returns a list of the elements at the positions in `range` (`a[x til y]`). Positions outside the array are
### skipped.
### :param range: The positions to copy.
@readonly
routine Array[T, COUNT].getitem(range: Range[Integer]) -> List[T]
needs T obeys Assignable
    var result = List[T]()
    var n: U64 = COUNT
    var count = Integer(from: n)
    each i in range
        if not i.is_negative() and i < count
            result.add_last(value: me.get_raw(index: U64(from: i)).assign())
    return result

### Returns the position of the first element equal to `value`.
### :param value: The value to look for.
### :absent: No element equals `value`.
@readonly
routine Array[T, COUNT].index_of!(value: T) -> Integer
needs T obeys Equatable
    var i = 0u64
    while i < COUNT
        if me.get_raw(index: i) == value
            return Integer(from: i)
        i = i +% 1u64
    absent
