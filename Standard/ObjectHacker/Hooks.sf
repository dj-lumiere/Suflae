module ObjectHacker

# The change hooks and implants of objects: `when_changed` and `remove_hook` (Hooks.rf) add and remove hooks, and the
# routines the builder writes around every change of a member variable run them. `implant` and `remove_implant`
# (written by the builder from `implant(target: hero, replacing: Hero.attack, with: f)`) replace a member routine for one
# object, and the builder writes a test for a replacement at the top of every member routine of an entity.

secret record ChangeHook
    secret id: U64
    secret handler: failable Callable[(Text, Unknown, Unknown), None]

# The hooks of one object, and the values its member variables had before the changes under way, innermost last.
secret entity HookTable
    secret target: Unknown
    secret hooks: List[ChangeHook]
    secret pending: List[Unknown]
    secret implants: Dict[Text, Unknown]

# Every object's hooks, by the object's key.
secret entity HookRegistry
    secret tables: Dict[U64, HookTable]
    secret next_id: U64
    secret hooked: U64

secret routine hook_registry() -> HookRegistry
    when stored_registry()
        is None =>
            var made = HookRegistry(tables: Dict[U64, HookTable](), next_id: 1, hooked: 0)
            store_registry(registry: Unknown(from: made))
            return made
        else as kept => return kept.to[HookRegistry]()

secret routine add_change_hook(key: U64, target: Unknown, handler: failable Callable[(Text, Unknown, Unknown), None]) -> U64
    var registry = hook_registry()
    var id = registry.next_id
    registry.next_id = id + 1
    when try registry.tables[key]
        is None =>
            var hooks = List[ChangeHook]()
            hooks.add_last(value: ChangeHook(id: id, handler: handler))
            registry.tables[key] = HookTable(target: target, hooks: hooks, pending: List[Unknown](), implants: Dict[Text, Unknown]())
            registry.hooked = registry.hooked + 1
            set_hooked_count(count: registry.hooked)
        else as table => table.hooks.add_last(value: ChangeHook(id: id, handler: handler))
    return id

# Takes an object's table out of the registry once it has neither hooks nor implants.
secret routine forget_if_empty(registry: HookRegistry, key: U64, table: HookTable)
    if table.hooks.count() == 0 and table.implants.count() == 0
        registry.tables.remove(key: key)
        registry.hooked = registry.hooked - 1
        set_hooked_count(count: registry.hooked)

secret routine drop_change_hook(key: U64, hook: U64) -> Bool
    when stored_registry()
        is None => return false
        else as kept =>
            var registry = kept.to[HookRegistry]()
            when try registry.tables[key]
                is None => return false
                else as table =>
                    var left = List[ChangeHook]()
                    var found = false
                    each listed in table.hooks
                        if listed.id == hook
                            found = true
                        else
                            left.add_last(value: listed)
                    table.hooks = left
                    forget_if_empty(registry: registry, key: key, table: table)
                    return found

# What the builder writes for `implant(target: hero, replacing: Hero.attack, with: f)`: from now on a call of that member
# routine on the object runs the replacement instead (an `Unknown` keeping the routine value, whose signature the
# builder checks where `implant` is written). An implant keeps its object alive until it is removed.
secret routine add_implant(key: U64, target: Unknown, routine_key: Text, replacement: Unknown)
    var registry = hook_registry()
    when try registry.tables[key]
        is None =>
            var implants = Dict[Text, Unknown]()
            implants[routine_key] = replacement
            registry.tables[key] = HookTable(target: target, hooks: List[ChangeHook](), pending: List[Unknown](), implants: implants)
            registry.hooked = registry.hooked + 1
            set_hooked_count(count: registry.hooked)
        else as table => table.implants[routine_key] = replacement

secret routine drop_implant(key: U64, routine_key: Text) -> Bool
    when stored_registry()
        is None => return false
        else as kept =>
            var registry = kept.to[HookRegistry]()
            when try registry.tables[key]
                is None => return false
                else as table =>
                    var found = table.implants.remove(key: routine_key)
                    forget_if_empty(registry: registry, key: key, table: table)
                    return found

# Whether the object has a replacement for a member routine: the builder's test at the top of every member routine of
# an entity.
secret routine has_implant(key: U64, routine_key: Text) -> Bool
    when stored_registry()
        is None => return false
        else as kept =>
            when try kept.to[HookRegistry]().tables[key]
                is None => return false
                else as table => return table.implants.has_key(key: routine_key)

# The object's replacement for a member routine, found by `has_implant`.
secret routine implant_of(key: U64, routine_key: Text) -> Unknown
    return hook_registry().tables[key].implants[routine_key]

secret routine hooks_before(key: U64, memvar: Text)
    when stored_registry()
        is None => return
        else as kept =>
            when try kept.to[HookRegistry]().tables[key]
                is None => return
                else as table =>
                    when table.target.peek_memvar(memvar: memvar)
                        is None => return
                        else as old => table.pending.add_last(value: old)

secret routine hooks_after(key: U64, memvar: Text)
    when stored_registry()
        is None => return
        else as kept =>
            when try kept.to[HookRegistry]().tables[key]
                is None => return
                else as table =>
                    if table.pending.count() == 0
                        return
                    var old = table.pending.remove_last()
                    when table.target.peek_memvar(memvar: memvar)
                        is None => return
                        else as now =>
                            # A copy, so a hook may add or remove hooks while they run.
                            var running = List[ChangeHook]()
                            each listed in table.hooks
                                running.add_last(value: listed)
                            each listed in running
                                var handler = listed.handler
                                handler(memvar, old, now)
