### The constant e to `precision` decimal digits.
### :param precision: The number of decimal significant digits.
### :returns: The resulting `Real` value.
common routine Real.e(precision: Integer) -> Real
    return Real.e(precision: S32(from: S64(from: precision)))

### The constant pi to `precision` decimal digits.
### :param precision: The number of decimal significant digits.
### :returns: The resulting `Real` value.
common routine Real.pi(precision: Integer) -> Real
    return Real.pi(precision: S32(from: S64(from: precision)))

### Divides this value by `other`, rounding to `precision` decimal digits.
@readonly
routine Real.divide(you: Real, precision: Integer) -> Real
    return me.divide(you: you, precision: S32(from: S64(from: precision)))

### Raises this value to the power `exp`.
### :param exp: The exponent.
### :returns: The resulting `Real` value.
### :throws: {NumericDomainError} when the base is negative and the exponent is not an
###          integer — that power has no real result (it would be complex).
@readonly
routine Real.pow!(exp: Real) -> Real
    return me.pow(exp: exp)

### Renders this value with exactly `places` digits after the point, the integer part written out in
### full. Same as `represent_with_places`, so ties round away from zero (the binary and decimal floats'
### `fixed` round ties to even).
### :param places: The number of digits after the point (0 for none).
### :returns: The rendered `Text`.
@readonly
routine Real.fixed(places: Integer) -> Text
    return me.fixed(places: U64(from: places))

### Formats this value with EXACTLY `decimal_places` digits after the decimal point,
### rounding to nearest (ties away from zero). A negative `decimal_places` is treated as 0.
### Works by scaling to an integer (`value * 10^places`), rounding, then placing the point on
### the resulting exact digit string — so the output is not perturbed by binary float artifacts.
### :param decimal_places: The number of fractional digits to render.
### :returns: The resulting `Text` value.
@readonly
routine Real.represent_with_places(decimal_places: Integer) -> Text
    return me.represent_with_places(decimal_places: S32(from: S64(from: decimal_places)))

### Returns the phase angle of this complex value in radians.
### :param precision: The decimal precision to use.
### :returns: The resulting `Real` value.
@readonly
routine Complex.arg(precision: Integer = 100) -> Real
    return me.arg(precision: S32(from: S64(from: precision)))

### Computes the principal complex square root.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.sqrt(precision: Integer = 100) -> Complex
    return me.sqrt(precision: S32(from: S64(from: precision)))

### Computes the complex exponential `e^z`.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.exp(precision: Integer = 100) -> Complex
    return me.exp(precision: S32(from: S64(from: precision)))

### Computes the principal natural logarithm of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.log(precision: Integer = 100) -> Complex
    return me.log(precision: S32(from: S64(from: precision)))

### Computes the complex sine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.sin(precision: Integer = 100) -> Complex
    return me.sin(precision: S32(from: S64(from: precision)))

### Computes the complex cosine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.cos(precision: Integer = 100) -> Complex
    return me.cos(precision: S32(from: S64(from: precision)))

### Computes the complex tangent of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.tan(precision: Integer = 100) -> Complex
    return me.tan(precision: S32(from: S64(from: precision)))

### Computes the principal inverse sine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.asin(precision: Integer = 100) -> Complex
    return me.asin(precision: S32(from: S64(from: precision)))

### Computes the principal inverse cosine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.acos(precision: Integer = 100) -> Complex
    return me.acos(precision: S32(from: S64(from: precision)))

### Computes the principal inverse tangent of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.atan(precision: Integer = 100) -> Complex
    return me.atan(precision: S32(from: S64(from: precision)))

### Computes the complex hyperbolic sine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.sinh(precision: Integer = 100) -> Complex
    return me.sinh(precision: S32(from: S64(from: precision)))

### Computes the complex hyperbolic cosine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.cosh(precision: Integer = 100) -> Complex
    return me.cosh(precision: S32(from: S64(from: precision)))

### Computes the complex hyperbolic tangent of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.tanh(precision: Integer = 100) -> Complex
    return me.tanh(precision: S32(from: S64(from: precision)))

### Computes the principal inverse hyperbolic sine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.asinh(precision: Integer = 100) -> Complex
    return me.asinh(precision: S32(from: S64(from: precision)))

### Computes the principal inverse hyperbolic cosine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.acosh(precision: Integer = 100) -> Complex
    return me.acosh(precision: S32(from: S64(from: precision)))

### Computes the principal inverse hyperbolic tangent of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.atanh(precision: Integer = 100) -> Complex
    return me.atanh(precision: S32(from: S64(from: precision)))

### Computes the principal base-10 logarithm of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.log10(precision: Integer = 100) -> Complex
    return me.log10(precision: S32(from: S64(from: precision)))

### Computes the principal base-2 logarithm of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.log2(precision: Integer = 100) -> Complex
    return me.log2(precision: S32(from: S64(from: precision)))

### Returns the multiplicative inverse `1/me` (conjugate divided by the squared magnitude).
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.reciprocal(precision: Integer = 100) -> Complex
    return me.reciprocal(precision: S32(from: S64(from: precision)))

### Returns the polar form of this value as `(radius, angle-in-radians)` — the inverse of
### `from_polar`.
### :param precision: The decimal precision to use for the angle.
### :returns: A tuple `(magnitude, argument)`.
@readonly
routine Complex.to_polar(precision: Integer = 100) -> (Real, Real)
    return me.to_polar(precision: S32(from: S64(from: precision)))

### Raises this value to a complex exponent.
### :param exp: The exponent value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.pow(exp: Complex, precision: Integer = 100) -> Complex
    return me.pow(exp: exp, precision: S32(from: S64(from: precision)))

### Formats this value as `a + bi` / `a - bi` with exactly `places` digits after the point in each
### part (the same as `represent_with_places`; see `Real.fixed`).
### :param places: The number of digits after the point.
### :returns: The resulting `Text` value.
@readonly
routine Complex.fixed(places: Integer) -> Text
    return me.fixed(places: U64(from: places))

### Formats this value as `a +/- bi` with the requested precision.
### :param decimal_places: The number of decimal places to render.
### :returns: The resulting `Text` value.
@readonly
routine Complex.represent_with_places(decimal_places: Integer) -> Text
    return me.represent_with_places(decimal_places: S32(from: S64(from: decimal_places)))

### Returns a diagnostic string with the requested precision.
### :param decimal_places: The number of decimal places to render.
### :returns: The resulting `Text` value.
@readonly
routine Complex.diagnose_with_places(decimal_places: Integer) -> Text
    return me.diagnose_with_places(decimal_places: S32(from: S64(from: decimal_places)))
