module IO/File

import IO/Errors

# Suflae's surface of the directory listings and the storage layers: Suflae lists. A Suflae program calls these in
# place of the shared routines of the same names.

### Returns the names of the directory's entries.
### :param at: The directory.
### :returns: The entry names.
### :throws: {IOError} when the directory cannot be listed.
failable common routine FileManager.list(at: Directory) -> List[Text]
    return FileManager.list(at: at).to[List[Text]]()

### Returns the directory's entries.
### :param at: The directory.
### :returns: The entries.
### :throws: {IOError} when the directory cannot be listed.
failable common routine FileManager.entries(at: Directory) -> List[DirEntry]
    return FileManager.entries(at: at).to[List[DirEntry]]()

### Returns the paths of everything under the directory, at any depth. Symbolic links are not followed.
### :param at: The directory.
### :returns: The full paths.
### :throws: {IOError} when any directory in the tree cannot be listed.
failable common routine FileManager.walk(at: Directory) -> List[Text]
    return FileManager.walk(at: at).to[List[Text]]()

### The storage devices the operating system reports, none where it reports none.
### :returns: The devices.
common routine StorageManager.all() -> List[StorageManager]
    return StorageManager.all().to[List[StorageManager]]()

### The partitions on this device the operating system reports.
### :returns: The partitions.
routine StorageManager.partitions() -> List[PartitionManager]
    return me.partitions().to[List[PartitionManager]]()

### The partitions the operating system has mounted, none where it reports none.
### :returns: The partitions.
common routine PartitionManager.all() -> List[PartitionManager]
    return PartitionManager.all().to[List[PartitionManager]]()
