module IO/Console

import Numerics

# Suflae's surface of the console readers that return lists: Suflae lists. A Suflae program calls these in place
# of the RazorForge routines of the same names.

### Reads all remaining input and splits it into lines. Windows line endings count as one.
routine ask_lines() -> List[Text]
    return List[Text](from: ask_lines())

### Reads all remaining input and splits it into the words between runs of whitespace.
routine ask_words() -> List[Text]
    return List[Text](from: ask_words())
