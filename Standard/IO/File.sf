module IO/File

import IO/Errors
import IO/FileSystem

# Suflae's surface of the directory listings: Suflae lists. A Suflae program calls these in place of the
# RazorForge routines of the same names.

### Returns the names of the directory's entries.
### :throws: {IOError} when the directory cannot be listed.
routine Directory.list!() -> List[Text]
    return me.list().to[List[Text]]()

### Returns the directory's entries.
### :throws: {IOError} when the directory cannot be listed.
routine Directory.entries!() -> List[DirEntry]
    return me.entries().to[List[DirEntry]]()

### Returns the paths of everything under the directory, at any depth. Symbolic links are not followed.
### :throws: {IOError} when any directory in the tree cannot be listed.
routine Directory.walk!() -> List[Text]
    return me.walk().to[List[Text]]()
