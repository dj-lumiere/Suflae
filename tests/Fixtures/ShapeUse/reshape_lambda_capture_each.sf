module Tests/ShapeUse/ReshapeLambdaCaptureEach

import IO/Console
# A lambda that captured the list adds to it while a loop visits the list: the change crashes with
# ReshapingWhileInUseError where the lambda runs.

routine start()
    var nums = [1, 2]
    var grow = () given (nums) => nums.add_last(value: 9)
    each x in nums
        show(f"visiting {x}")
        grow()
    show("not reached")
    return
