module Tests/ShapeUse/ReshapeElementListEach

import IO/Console
# The inner loop visits the first row, and the body adds to that row through `rows[0]`: the change crashes with
# ReshapingWhileInUseError.

routine start()
    var rows = [[1, 2], [3, 4]]
    each row in rows
        each x in row
            show(f"visiting {x}")
            rows[0].add_last(value: x)
    show("not reached")
    return
