module Tests/StdlibSf/AgentStartApi

import IO/Console

# `agent f(...)` computes the arguments now and defers the call into an Agent. start_now() starts it, and
# retrieve() waits for its value (starting it first if nothing has).

record Pair
    a: Integer
    b: Integer

routine Pair.sum() -> Integer
    return me.a + me.b

routine add(a: Integer, b: Integer) -> Integer
    return a + b

routine checked!(n: Integer) -> Integer
    if n < 0
        throw VerificationFailedError()
    return n

routine start()
    var now = agent add(a: 1, b: 2)
    now.start_now()
    show(f"now: {now.retrieve()}")

    var waiting = agent add(a: 7, b: 8)
    show(f"waiting: {waiting.retrieve()}")

    var x = 40
    var early = agent add(a: x, b: 2)
    x = 0
    show(f"arguments now: {early.retrieve()}")

    var p = Pair(a: 2, b: 3)
    show(f"member: {(agent p.sum()).retrieve()}")

    var jobs = [agent add(a: 1, b: 1), agent add(a: 2, b: 2), agent add(a: 3, b: 3)]
    show(f"gather: {jobs.gather()}")

    var failing = try agent checked(n: -1)
    show(f"try agent: {failing.retrieve()}")

    var twice = agent add(a: 1, b: 1)
    twice.start_now()
    when check twice.start_now()
        is AgentStartError as e => show(f"second start: {e.crash_message()}")
        else => show("second start: ran")
    show(f"twice: {twice.retrieve()}")
    show("DONE")
    return
