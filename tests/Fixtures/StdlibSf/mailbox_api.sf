module Tests/StdlibSf/MailboxApi

import IO/Console

# A mailbox carries values from one job to another in order: `add_last` waits while it is full, `for` and
# `remove_first` wait while it is empty, and `for` ends once it is closed and empty.
routine produce(q: Mailbox[Int], n: Int) -> Int
    var i = 1
    until i > n
        q.add_last(value: i)
        i = i + 1
    q.close()
    return n

routine start()
    var q = Mailbox[Int](capacity: 2)
    var job = produce.to[Work](q: q, n: 5)
    job.start_now()
    var first = q.remove_first()
    var total = first
    var seen = List[Int]()
    seen.add_last(value: first)
    for x in q
        total = total + x
        seen.add_last(value: x)
    show(f"total: {total} order: {seen}")
    show(f"sent: {job.retrieve()}")
    show(f"closed: {q.is_closed()} left: {q.count()}")
    show("DONE")
    return
