module Tests/StdlibSf/GenericRoutineApi

import IO/Console
import Numerics
# Free generic functions with type constraints.

routine identity[T](x: T) -> T
    return x

routine min_of[T](a: T, b: T) -> T
needs T obeys Comparable
    if a < b
        return a
    return b

routine pair_eq[T](a: T, b: T) -> Bool
needs T obeys Equatable
    return a == b

routine start()
    # identity: same in, same out, different T's
    var s64_42: S64 = 42
    show(f"identity(42): {identity(x: s64_42)}")
    show(f"identity(\"hi\"): {identity(x: "hi")}")
    show(f"identity(true): {identity(x: true)}")

    # min_of with ordered types
    var s64_3: S64 = 3
    var s64_7: S64 = 7
    show(f"min_of(3, 7): {min_of(a: s64_3, b: s64_7)}")
    var b64_1_5: B64 = 1.5
    var b64_0_5: B64 = 0.5
    show(f"min_of(1.5, 0.5): {min_of(a: b64_1_5, b: b64_0_5)}")
    show(f"min_of(\"abc\", \"abd\"): {min_of(a: "abc", b: "abd")}")

    # pair_eq across types
    var s64_1: S64 = 1
    show(f"pair_eq(1, 1): {pair_eq(a: s64_1, b: s64_1)}")
    var s64_2: S64 = 2
    show(f"pair_eq(1, 2): {pair_eq(a: s64_1, b: s64_2)}")
    show(f"pair_eq(\"x\", \"x\"): {pair_eq(a: "x", b: "x")}")

    show("DONE")
    return
