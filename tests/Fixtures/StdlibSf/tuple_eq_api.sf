module Tests/StdlibSf/TupleEqApi

# Tuples of items that compare, Int and Decimal among them, compare as a whole.

routine start()
    var a = (1, "x")
    var b = (1, "x")
    var c = (2, "x")
    show(a == b)
    show(a == c)
    show(a != c)
    show(a != b)
    show(a < c)
    var d = (1.5, true)
    var e = (1.5, true)
    show(d == e)
    return
