module Tests/StdlibSf/WorkDropApi

# When the last holder of a job lets go of it before anything retrieved it (the end of the routine that holds it,
# or a list that is replaced), its running work is cancelled and waited for.

import IO/Console

routine spin(stopped: Unbroken[S64]) -> Integer
    var turns = 0
    until cancellation_requested()
        waitfor(1ms)
        turns += 1
    stopped.fetch_add(delta: 1)
    return turns

routine leave_running(stopped: Unbroken[S64])
    var job = spin.to[Work](stopped: stopped)
    job.start_now()
    waitfor(5ms)

routine start()
    var stopped = Unbroken[S64](initial: 0)
    leave_running(stopped: stopped)
    show(f"after scope: {stopped.load()}")
    var jobs = [spin.to[Work](stopped: stopped), spin.to[Work](stopped: stopped)]
    jobs[0].start_now()
    waitfor(5ms)
    jobs = []
    show(f"after list: {stopped.load()}")
    show("DONE")
