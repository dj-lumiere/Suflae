module Tests/StdlibSf/WorkDropApi

# When the last holder of a job lets go of it before anything retrieved it (the end of the routine that holds it,
# or a list that is replaced), its running work is cancelled and waited for.

import IO/Console

global stopped: S64 = 0

routine spin() -> Integer
    var turns = 0
    until cancellation_requested()
        waitfor(1ms)
        turns += 1
    stopped += 1
    return turns

routine leave_running()
    var job = spin.to[Work]()
    job.start_now()
    waitfor(5ms)

routine start()
    leave_running()
    show(f"after scope: {stopped}")
    var jobs = [spin.to[Work](), spin.to[Work]()]
    jobs[0].start_now()
    waitfor(5ms)
    jobs = []
    show(f"after list: {stopped}")
    show("DONE")
