module Tests/StdlibSf/SharedStepsApi

import IO/Console

# One-statement steps for state that several jobs share: `set_if_absent` adds a key only when it is missing,
# `items()` walks a copy, `add_last_if_room` never waits on a full mailbox, and `take_finished` collects finished work in
# place, `next_finished` hands jobs over as they finish, and `gather_all` keeps every result and failure.
routine double(n: Int) -> Int
    return n * 2

routine slow(n: Int, wait: Duration) -> Int
    waitfor(duration: wait)
    return n

failable routine risky(n: Int) -> Int
    if n == 2
        throw VerificationFailedError()
    return n * 10

routine start()
    var seats = Dict[Text, Int]()
    show(f"first: {seats.set_if_absent(key: "ada", value: 1)} again: {seats.set_if_absent(key: "ada", value: 9)}")
    seats["bob"] = 2
    each (name, seat) in seats.items()
        seats[f"{name}2"] = seat + 10
    show(f"seats: {seats.count()} ada={seats["ada"]} ada2={seats["ada2"]} bob2={seats["bob2"]}")

    var q = Mailbox[Int](capacity: 2)
    show(f"room: {q.add_last_if_room(value: 1)} {q.add_last_if_room(value: 2)} {q.add_last_if_room(value: 3)} count={q.count()}")
    q.close()
    var closed = try q.add_last_if_room(value: 4)
    show(f"after close: {closed is None}")

    var jobs = List[Work[Int]]()
    jobs.add_last(value: double.to[Work](n: 1))
    jobs.add_last(value: double.to[Work](n: 2))
    jobs.add_last(value: double.to[Work](n: 3))
    var two = jobs[1].retrieve()
    var done = jobs.take_finished()
    show(f"taken: {done.count()} left: {jobs.count()} value: {two}")
    show(f"rest: {jobs.gather()}")

    var racers = [slow.to[Work](n: 1, wait: 60ms), slow.to[Work](n: 2, wait: 5ms), slow.to[Work](n: 3, wait: 30ms)]
    var order = List[Int]()
    until racers.is_empty()
        order.add_last(value: racers.next_finished().retrieve())
    show(f"finish order: {order}")

    var tries = [risky.to[Work](n: 1), risky.to[Work](n: 2), risky.to[Work](n: 3)]
    var outcomes = tries.gather_all()
    show(f"all: {outcomes.count()} first: {outcomes[0]} third: {outcomes[2]}")
    show("DONE")
    return
