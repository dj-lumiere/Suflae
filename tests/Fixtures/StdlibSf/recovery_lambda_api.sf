module Tests/StdlibSf/RecoveryLambdaApi

import IO/Console
import IterTools
# A lambda that can fail, handed to a `failable Callable`, passes its failure up through the routine it was handed
# to, so `try` and `check` receive it: through the emitter adapters (`select`, `where`) and the terminals that drive
# them, through `any`/`all`/`sort_by`, through a routine that calls the value it was handed, a value passed down two
# levels, a value kept in a member variable, and an `each` loop over an adapter in a failable routine.

routine apply(f: failable Callable[(Int,), Int], x: Int) -> Int
    return f(x)

routine apply_twice(f: failable Callable[(Int,), Int], x: Int) -> Int
    return apply(f: f, x: apply(f: f, x: x))

failable routine sum_inverse(xs: List[Int]) -> Int
    var total = 0
    each y in xs.select(transform: x => 100 // x)
        total += y
    return total

failable routine hundred_over(x: Int) -> Int
    return 100 // x

record Holder
    f: failable Callable[(Int,), Int]

routine run(holder: Holder, x: Int) -> Int
    return holder.f(x)

routine start()
    var ok = List[Int]()
    ok.add_last(value: 5)
    ok.add_last(value: 2)
    var bad = List[Int]()
    bad.add_last(value: 5)
    bad.add_last(value: 0)

    # select (lazy: the lambda runs when List() drives it)
    show(f"select ok: {try ok.select(transform: x => 10 // x).to[List]()}")
    show(f"select try: {try bad.select(transform: x => 10 // x).to[List]()}")
    show(f"select grab: {check bad.select(transform: x => 10 // x).to[List]()}")
    show(f"select lookup: {check bad.select(transform: x => 10 // x).to[List]()}")
    when check bad.select(transform: x => 10 // x).to[List]()
        is DivisionByZeroError as e => show(f"select arm: {e.crash_title()}")
        is Crashables as e => show(f"select other: {e.crash_title()}")
        else as values => show(f"select values: {values}")

    # where
    show(f"where ok: {try ok.where(predicate: x => 10 // x > 2).to[List]()}")
    show(f"where try: {try bad.where(predicate: x => 10 // x > 1).to[List]()}")

    # any / all
    show(f"any ok: {try ok.any(predicate: x => 10 // x == 2)}")
    show(f"any try: {try bad.any(predicate: x => 10 // x == 7)}")
    show(f"all grab: {check bad.all(predicate: x => 10 // x > 0)}")

    # sort_by: the routine returns nothing, so try gives Bool
    show(f"sort try: {try bad.sort_by(compare: (a, b) => 10 // a < 10 // b)}")

    # each over an adapter, inside a routine called beneath the keyword
    show(f"each ok: {try sum_inverse(xs: ok)}")
    show(f"each try: {try sum_inverse(xs: bad)}")

    # a routine that calls the value it was handed, a captured local, a value passed down two levels
    show(f"apply ok: {try apply(f: x => 10 // x, x: 5)}")
    show(f"apply try: {try apply(f: x => 10 // x, x: 0)}")
    var divisor = 0
    show(f"capture try: {try apply(f: x => x // divisor, x: 7)}")
    show(f"two levels ok: {try apply_twice(f: x => 64 // x, x: 2)}")
    show(f"two levels try: {try apply_twice(f: x => 64 // (x - 32), x: 32)}")
    show(f"two levels lookup: {check apply_twice(f: x => 64 // (x - 2), x: 2)}")

    # a routine named as a value
    show(f"named ok: {try apply(f: hundred_over, x: 4)}")
    show(f"named try: {try apply(f: hundred_over, x: 0)}")

    # a value kept in a record, called later beneath the keyword
    var holder = Holder(f: x => 10 // x)
    show(f"stored ok: {try run(holder: holder, x: 2)}")
    show(f"stored try: {try run(holder: holder, x: 0)}")

    # a local routine value called directly beneath the keyword
    var g: failable Callable[(Int,), Int] = x => 10 // x
    show(f"local try: {try g(0)}")
    show(f"local ok: {try g(5)}")
    show("DONE")
    return
