module Tests/StdlibSf/MatrixSfApi

import IO/Console
import Math3D
# Exercises Matrix2R2C, Matrix3R3C and Matrix4R4C from Suflae: construction, arithmetic, and the inverse,
# inverse_unchecked and solve of all three. The matrices have small integer elements, so most results are exact.
# Each inverse is also checked against the identity: every element of inverse · A - I is at most 16 units in the
# last place of 1.0 (16 × 2^-23), the bound these cases keep with the B32 rounding of the product included.

### The largest |element| of a 2x2 matrix.
routine largest2(m: Matrix2R2C) -> B32
    var size: U64 = 2
    var largest: B32 = 0.0
    for r in 0 til size
        for c in 0 til size
            largest = largest.max(you: m.get(row: r, col: c).abs())
    return largest

### The largest |element| of a 3x3 matrix.
routine largest3(m: Matrix3R3C) -> B32
    var size: U64 = 3
    var largest: B32 = 0.0
    for r in 0 til size
        for c in 0 til size
            largest = largest.max(you: m.get(row: r, col: c).abs())
    return largest

### The largest |element| of a 4x4 matrix.
routine largest4(m: Matrix4R4C) -> B32
    var size: U64 = 4
    var largest: B32 = 0.0
    for r in 0 til size
        for c in 0 til size
            largest = largest.max(you: m.get(row: r, col: c).abs())
    return largest

routine start()
    var tolerance: B32 = 0.0000019073486328125

    var a2 = Matrix2R2C(c0: vec2(4.0, 2.0), c1: vec2(7.0, 6.0))
    show(f"a2: {a2}, determinant: {a2.determinant()}, transpose: {a2.transpose()}")
    show(f"a2 * a2: {a2 * a2}, a2 transforms (1, 1): {a2.transform(v: vec2(1.0, 1.0))}")
    show(f"a2 row 1: {a2[1]}, element (0, 1): {a2[0][1]}")
    var inv2 = a2.inverse()
    show(f"a2 inverse: {inv2}, inverse * A within tolerance: {largest2(m: inv2 * a2 - Matrix2R2C.identity()) <= tolerance}")
    show(f"solve2 (5, 10): {Matrix2R2C(c0: vec2(2.0, 1.0), c1: vec2(1.0, 3.0)).solve(b: vec2(5.0, 10.0))}")
    when check Matrix2R2C(c0: vec2(1.0, 2.0), c1: vec2(2.0, 4.0)).inverse()
        is Matrix2R2C as m => show(f"after pivot2 inverse: {m}")
        is SingularMatrixError as e => show(f"after pivot2 inverse: {e.crash_message()}")
        is Crashables as e => show(f"after pivot2 other: {e.crash_message()}")
    var raw2 = Matrix2R2C(c0: vec2(0.0, 0.0), c1: vec2(1.0, 2.0)).inverse_unchecked()
    show(f"zero column2 inverse_unchecked (0, 0) finite: {raw2.get(row: 0, col: 0).is_finite()}")

    var t3 = Matrix3R3C(c0: vec3(1.0, 4.0, 7.0), c1: vec3(2.0, 5.0, 8.0), c2: vec3(3.0, 6.0, 10.0))
    show(f"t3: {t3}, determinant: {t3.determinant()}")
    var inv3 = t3.inverse()
    show(f"t3 inverse * A within tolerance: {largest3(m: inv3 * t3 - Matrix3R3C.identity()) <= tolerance}")
    var s3 = Matrix3R3C(c0: vec3(1.0, 0.0, 2.0), c1: vec3(1.0, 2.0, 5.0), c2: vec3(1.0, 5.0, -1.0))
    show(f"solve3 (6, -4, 27): {s3.solve(b: vec3(6.0, -4.0, 27.0))}")
    var r3 = Matrix3R3C.rotation_z(angle: 1.5707963).transform(v: vec3(1.0, 0.0, 0.0))
    show(f"rotation_z(90) maps x to y: {r3[0] * r3[0] + (r3[1] - 1.0) * (r3[1] - 1.0) < 0.000001}")
    when check Matrix3R3C(
        c0: vec3(0.0, 0.0, 0.0),
        c1: vec3(1.0, 3.0, 5.0),
        c2: vec3(2.0, 4.0, 6.0),
    ).solve(b: vec3(1.0, 1.0, 1.0))
        is SingularMatrixError as e => show(f"zero column3 solve: {e.crash_message()}")
        is Crashables as e => show(f"zero column3 other: {e.crash_message()}")
        else as x => show(f"zero column3 solve: {x}")

    var a4 = Matrix4R4C(
        c0: vec4(x: 4.0, y: 3.0, z: 2.0, w: 1.0),
        c1: vec4(x: 3.0, y: 4.0, z: 3.0, w: 2.0),
        c2: vec4(x: 2.0, y: 3.0, z: 4.0, w: 3.0),
        c3: vec4(x: 1.0, y: 2.0, z: 3.0, w: 4.0),
    )
    var inv4 = a4.inverse()
    show(f"a4 inverse * A within tolerance: {largest4(m: inv4 * a4 - Matrix4R4C.identity()) <= tolerance}")
    var p4 = Matrix4R4C(
        c0: vec4(x: -2.0, y: -4.0, z: 3.0, w: 1.0),
        c1: vec4(x: -3.0, y: -4.0, z: 3.0, w: 1.0),
        c2: vec4(x: 3.0, y: 3.0, z: -3.0, w: 0.0),
        c3: vec4(x: -3.0, y: 4.0, z: -2.0, w: -2.0),
    )
    when check p4.inverse()
        is Matrix4R4C as m => show(f"after pivot4 inverse: {m}")
        is SingularMatrixError as e => show(f"after pivot4 inverse: {e.crash_message()}")
        is Crashables as e => show(f"after pivot4 other: {e.crash_message()}")
    show(f"translation4 inverse: {Matrix4R4C.translation(tx: 1.0, ty: 2.0, tz: 3.0).inverse()}")
