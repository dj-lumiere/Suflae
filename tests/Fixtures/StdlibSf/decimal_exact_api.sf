module Tests/StdlibSf/DecimalExactApi

# `+ - *` on Decimal are exact: a result that needs more than 34 significant digits stops instead of rounding, and
# `try` recovers it. Division rounds to the nearest 34-digit value. Every rounding is half up: x goes to the n with
# n - 0.5 <= x < n + 0.5 (at the digit kept).

import IO/Console

routine start()
    var big: Decimal = 9999999999999999999999999999999999
    var half: Decimal = 0.5
    var x: Decimal = 1.234567890123456789
    show(try (big + half))
    show(try (big - half))
    show(try (x * x))
    show(big + 1)
    show(big * 10)
    show(0.1 + 0.2)
    show(1 / 3)
    when check (big + half)
        is NumericOverflowError as e => show(e.crash_message())
        else => show("fits")
    var up: Decimal = 2.5
    var down: Decimal = -2.5
    var nhalf: Decimal = -0.5
    var past: Decimal = -2.6
    var m: Decimal = -7.125
    var p: Decimal = 7.125
    show(f"round: {up.round()} {down.round()} {nhalf.round()} {past.round()}")
    show(f"fixed: {p.fixed(places: 2)} {m.fixed(places: 2)} {down.fixed(places: 0)}")
    show(f"floor ceil trunc: {down.floor()} {down.ceil()} {down.trunc()}")
    var odd: Decimal = 2000000000000000000000000000000001
    show(f"divide: {odd / 2} {-odd / 2}")
