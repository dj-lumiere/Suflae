module Tests/StdlibSf/CaughtErrorDisplay

# A caught error shown whole (`show(e)`) shows its message, and the name an `else as` arm binds when only `None` is
# left holds `none`.

failable routine half(n: S64) -> S64
    if n % 2 != 0
        throw AbsentValueError()
    return n // 2

routine start()
    when check half(n: 3)
        is S64 as v => show(v)
        else as e => show(e)
    when try half(n: 3)
        is S64 as v => show(v)
        else as e => show(e)
    when try half(n: 4)
        is S64 as v => show(v)
        else as e => show(e)
