module Tests/StdlibSf/EntityEqualityApi

# `==` on an entity the program writes and on a record holding one, with no `obeys Equatable`, and a record
# holding an entity that declares `obeys Hashable` as a `Set` element.
entity Player
obeys Hashable
    name: Text

record Team
    lead: Player
    size: Int

record Seat
    holder: Player
    row: Int

routine start()
    var ada = Player(name: "Ada")
    show(f"same entity: {ada == ada}")
    show(f"same contents: {ada == Player(name: "Ada")}")
    show(f"other contents: {ada == Player(name: "Bo")}")
    show(f"same team: {Team(lead: ada, size: 3) == Team(lead: ada, size: 3)}")
    show(f"other lead: {Team(lead: ada, size: 3) == Team(lead: Player(name: "Bo"), size: 3)}")
    show(f"other size: {Team(lead: ada, size: 3) != Team(lead: ada, size: 4)}")
    var seats = Set[Seat]()
    seats.add(Seat(holder: ada, row: 1))
    seats.add(Seat(holder: ada, row: 1))
    seats.add(Seat(holder: Player(name: "Bo"), row: 1))
    show(f"seats: {seats.count()}")
