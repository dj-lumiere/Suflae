module Tests/StdlibSf/EmitterApi

# Emitters used directly, emitters collected with to[...], and a list of Works started together.
import IterTools
import Collections

routine square(n: Integer) -> Integer
    return n * n

routine make() -> List[Integer]
    return [4, 1, 3, 1]

routine start()
    var xs = make()

    # An emitter kept in a variable walks on from where it is.
    var it = xs.emitter()
    show(f"first: {it.emit()}")
    each x in it
        show(f"rest: {x}")
    when try it.emit()
        is None => show("after the end: none")
        else as v => show(f"after the end: {v}")

    # An adapter kept in a variable keeps its list alive when the name gets another list.
    var big = xs.where(predicate: v => v > 1)
    xs = [7, 8]
    var noise = [100, 200, 300, 400]
    each b in big
        show(f"big: {b}")

    # Collecting.
    var pairs = [(2, "b"), (1, "a"), (2, "c")]
    var d = pairs.to[Dict]()
    show(f"dict: {d.count()} {d[2]}")
    show(f"sorted list: {make().to[SortedList]()}")
    show(f"sorted set: {make().to[SortedSet]()}")
    show(f"sorted dict: {pairs.to[SortedDict]()}")
    show(f"rotatable: {make().to[RotatableList]()}")
    show(f"bits: {[true, false].to[BitList]()}")
    show(f"queue: {pairs.to[PriorityQueue]().count()}")
    show(f"noise: {noise.count()}")

    # A list of Works started together, then collected.
    var jobs = List[Work[Integer]]()
    each i in 1 to 3
        jobs.add_last(value: square.to[Work](n: i))
    jobs.start_now()
    show(f"now: {jobs.gather()}")
    var lazy = [square.to[Work](n: 5), square.to[Work](n: 6)]
    show(f"lazy: {lazy.gather()}")
