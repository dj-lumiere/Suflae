module Tests/StdlibSf/UnionApi

import IO/Console
# A variant written in place, `A | B`: the same set of types in any order is one type, a value of one of its types
# goes in as it is (argument, initializer, return, reassignment), and a smaller one is held as a larger one.

define Circle | Square as Shape

record Circle
    r: Int

record Square
    side: Int

routine area(s: Shape) -> Int
    when s
        is Circle as c => return 3 * c.r * c.r
        is Square as q => return q.side * q.side
    return 0

routine parse_cell(text: Text) -> Int | Text
    if text == "x"
        return text
    return 7

routine describe(v: Int | Text | Bool) -> Text
    when v
        is Int as n => return f"number {n}"
        is Text as t => return f"text {t}"
        is Bool as b => return f"flag {b}"
    return "?"

routine start()
    show(f"{area(s: Circle(r: 2))} {area(s: Square(side: 3))}")
    var v: Text | Int = parse_cell(text: "x")
    when v
        is Text as t => show(f"text {t}")
        is Int as n => show(f"number {n}")
    var w = parse_cell(text: "y")
    if w is Int as n
        show(f"n={n}")
    var shapes = List[Circle | Square]()
    shapes.add_last(value: Circle(r: 1))
    shapes.add_last(value: Square(side: 2))
    var total = 0
    for s in shapes
        total += area(s: s)
    show(f"{total}")
    var wide: Int | Text | Bool = parse_cell(text: "x")
    show(describe(v: wide))
    show(describe(v: parse_cell(text: "y")))
    show(describe(v: true))
    show("DONE")
    return
