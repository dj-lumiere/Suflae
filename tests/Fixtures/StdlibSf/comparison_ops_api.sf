module Tests/StdlibSf/ComparisonOpsApi

import IO/Console
# Builder-generated lt/le/gt/ge from compare on types that obey Comparable.
record Score
obeys Comparable
    value: S64

routine Score.eq(you: Score) -> Bool
    return me.value == you.value

# Score auto-derives Equatable/Hashable; we expose compare manually so lt/le/gt/ge
# can be derived from it.
routine Score.compare(you: Score) -> ComparisonSign
    if me.value < you.value
        return ComparisonSign.ME_SMALL
    if me.value > you.value
        return ComparisonSign.ME_LARGE
    return ComparisonSign.SAME

routine start()
    var a = Score(value: 10)
    var b = Score(value: 20)
    var c = Score(value: 10)

    show(f"a < b: {a < b}")
    show(f"a <= b: {a <= b}")
    show(f"a == c: {a == c}")
    show(f"a != b: {a != b}")
    show(f"a >= c: {a >= c}")
    show(f"b > a: {b > a}")

    # Numeric chain
    var s64_1: S64 = 1
    var s64_2: S64 = 2
    var s64_3: S64 = 3
    show(f"1 < 2 < 3: {s64_1 < s64_2 and s64_2 < s64_3}")
    var s64_7: S64 = 7
    var s64_5: S64 = 5
    show(f"max chain: {s64_3.max(you: s64_7).max(you: s64_5)}")

    # Text ordering
    show(f"'abc' < 'abd': {"abc" < "abd"}")
    show(f"'abc' < 'abcd': {"abc" < "abcd"}")
    show(f"'A' < 'a': {"A" < "a"}")

    show("DONE")
    return
