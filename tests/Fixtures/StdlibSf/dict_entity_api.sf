module Tests/StdlibSf/DictEntityApi

import IO/Console
# SF entities held as Dict values lower to `Roamed[Node]`. The cycle collector's auto roam-trace must
# walk the Dict's live `vals` buffer (the sparse-buffer trace, skipping tombstoned slots) so container-
# held entities stay visible to collection — the open-addressing counterpart of the dense List buffer.
entity Node
    id: S64

routine start()
    var d = Dict[S64, Node]()
    d[1] = Node(id: 10)
    d[2] = Node(id: 20)
    d[3] = Node(id: 30)
    show(f"count: {d.count()}")
    show(f"d[2].id: {d[2].id}")

    # Remove tombstones an entry — the sparse trace must SKIP it (live-only, R2).
    d.remove(key: 2)
    show(f"count after remove(2): {d.count()}")
    for e in d
        show(f"entry {e.item0} -> {e.item1.id}")

    show("DONE")
    return
