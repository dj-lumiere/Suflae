module Tests/StdlibSf/InfixApi

import IO/Console
# A routine marked `@infix` is written between its operands.

record Vec
    x: Int
    y: Int

@infix
routine Vec.dot(you: Vec) -> Int
    return me.x * you.x + me.y * you.y

routine start()
    var a = Vec(x: 1, y: 2)
    var b = Vec(x: 3, y: 4)
    show(f"{a dot b}")
    show("DONE")
