module Tests/StdlibSf/MemoryApi

import IO/Console
import ObjectHacker

# Suflae's Memory: a row of places that start as zero, and its ranges, spans that share the same places.

entity Counter
    hits: Integer

entity Box
    holder: Holder?
    id: Integer

entity Holder
    kids: Memory[Box]

routine keep_view() -> Span[Integer]
    var whole = Memory[Integer](count: 6, fill: 0)
    whole[4] = 40
    # The span outlives the name `whole`: it keeps the memory alive.
    return whole[3 til 6]

routine start()
    var buf = Memory[Integer](count: 5, fill: 7)
    show(f"made: {buf} capacity={buf.capacity()}")
    var empty = Memory[Text](capacity: 3)
    show(f"zero places: {empty} first is empty: {empty[0] == ""}")

    buf[0] = 1
    buf[4] = 9
    show(f"written: {buf[0]} {buf[4]}")

    var part = buf[1 til 4]
    part[0] = 20
    show(f"view: {part} memory: {buf}")

    var kept = keep_view()
    show(f"kept view: {kept}")

    each x in buf
        buf[0] = x
    show(f"after loop: {buf}")
    show(f"have 20: {buf.has(20)} have 3: {buf.has(3)}")

    var words = Memory[Text](count: 3, fill: "a")
    words[1] = "b" + "c"
    show(f"took: {words.take(index: 1)} left: {words}")
    words.erase(index: 0)
    show(f"erased: {words}")

    var shared = Counter(hits: 0)
    var counters = Memory[Counter](count: 2, fill: shared)
    counters[1].hits = 5
    show(f"shared: {shared.hits} {counters[0].hits}")

    var unfilled = Memory[Counter](capacity: 2)
    var empty_entity = try unfilled[0]
    show(f"empty entity place: {empty_entity is None}")

    var missing = try buf[10]
    show(f"out of range: {missing is None}")
    var negative = try buf[-1]
    show(f"negative: {negative is None}")

    var row = Memory[Text](capacity: 5)
    row[0] = "a"
    row[1] = "b"
    row[2] = "c"
    row.move(from: 0, into: 2, count: 3)
    show(f"moved: {row}")
    row.rotate_left(count: 2)
    show(f"rotated: {row}")
    row.grow(capacity: 7)
    show(f"grown: {row} capacity={row.capacity()}")

    var nums = Memory[Integer](capacity: 40)
    var k = 0
    until k >= 40
        nums[k] = (k * 17) % 40
        k = k + 1
    nums.sort()
    show(f"sorted: {nums[0]} {nums[1]} {nums[20]} {nums[39]}")
    nums.sort_by(compare: (a, b) => a > b)
    show(f"sorted down: {nums[0]} {nums[39]}")
    nums[0 til 10].reverse()
    nums.swap(first: 0, second: 39)
    show(f"part reversed and swapped: {nums[0]} {nums[9]} {nums[39]}")

    var names = Memory[Text](count: 4, fill: "m")
    names[1] = "c"
    names[2] = "a"
    names[1 til 3].sort()
    show(f"sorted part: {names}")

    # What the places hold goes away with the memory, and a cycle through a memory is reaped.
    var box = Box(holder: none, id: 1)
    var seen = watch(target: box)
    var holder = Holder(kids: Memory[Box](count: 2, fill: box))
    show(f"read through a field: {holder.kids[1].id}")
    holder.kids[0] = box
    box.holder = holder
    box = Box(holder: none, id: 0)
    holder = Holder(kids: Memory[Box](count: 1, fill: box))
    show(f"cycle alive: {seen.is_alive()}")
    show(f"collected: {cyclic_collect()} alive: {seen.is_alive()}")

    var lone = Box(holder: none, id: 2)
    var lone_seen = watch(target: lone)
    var boxes = Memory[Box](capacity: 3)
    boxes[0] = lone
    boxes[2] = lone
    boxes.move(from: 2, into: 1, count: 1)
    lone = Box(holder: none, id: 0)
    boxes.take(index: 0)
    boxes = Memory[Box](capacity: 0)
    show(f"released: {not lone_seen.is_alive()}")
    show("DONE")
    return
