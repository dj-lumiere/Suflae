module Tests/StdlibSf/OwnSerialApi

import IO/Console

# Suflae's own list reads back from its serialized form, and `try` recovers a value that does not fit.
routine start()
    var xs = [3, 1, 2]
    var back = List[Integer](from: xs.serialize())
    show(f"back={back} count={back.count()} first={back[0] + 1}")
    var bad = try List[Integer](from: "x".serialize())
    show(f"bad={bad is None}")
    show("DONE")
    return
