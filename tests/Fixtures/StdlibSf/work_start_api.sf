module Tests/StdlibSf/WorkStartApi

import IO/Console

# `f.to[Work](...)` computes the arguments now and defers the call into a Work. start_now() starts it, and
# retrieve() waits for its value (starting it first if nothing has).

record Pair
    a: Integer
    b: Integer

routine Pair.sum() -> Integer
    return me.a + me.b

routine add(a: Integer, b: Integer) -> Integer
    return a + b

failable routine checked(n: Integer) -> Integer
    if n < 0
        throw VerificationFailedError()
    return n

routine start()
    var now = add.to[Work](a: 1, b: 2)
    now.start_now()
    show(f"now: {now.retrieve()}")

    var waiting = add.to[Work](a: 7, b: 8)
    show(f"waiting: {waiting.retrieve()}")

    var x = 40
    var early = add.to[Work](a: x, b: 2)
    x = 0
    show(f"arguments now: {early.retrieve()}")

    var p = Pair(a: 2, b: 3)
    show(f"member: {p.sum.to[Work]().retrieve()}")

    var jobs = [add.to[Work](a: 1, b: 1), add.to[Work](a: 2, b: 2), add.to[Work](a: 3, b: 3)]
    show(f"gather: {jobs.gather()}")

    var failing = checked.to[Work](n: -1)
    show(f"try retrieve: {try failing.retrieve()}")

    var twice = add.to[Work](a: 1, b: 1)
    twice.start_now()
    when check twice.start_now()
        is WorkStartError as e => show(f"second start: {e.crash_message()}")
        else => show("second start: ran")
    show(f"twice: {twice.retrieve()}")
    show("DONE")
    return
