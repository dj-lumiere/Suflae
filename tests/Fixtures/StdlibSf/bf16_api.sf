module Tests/StdlibSf/Bf16Api

# BF16 arithmetic (worked on the B32 values, rounded once) and its correctly rounded library functions.

import IO/Console

routine start()
    var x = "1.5".to[BF16]()
    var y = "0.1".to[BF16]()
    var two = "2".to[BF16]()
    show(f"x + y: {x + y}  x * y: {x * y}  x / y: {x / y}  sqrt(2): {two.sqrt()}")
    show(f"exp(1): {"1".to[BF16]().exp()}  sin(1): {"1".to[BF16]().sin()}  2^10: {two.pow("10".to[BF16]())}")
    var one = "1".to[BF16]()
    var half = "0.5".to[BF16]()
    var (s1, c1) = one.sin_cos()
    show(f"exp2_m1(1): {one.exp2_m1()}  log10_1p(9): {"9".to[BF16]().log10_1p()}  acos_pi(0.5): {half.acos_pi()}  atan2_pi(1, 1): {atan2_pi(y: one, x: one)}")
    show(f"sin_cos(1): {s1} {c1}  rsqrt(2): {two.rsqrt()}  compound(0.5, 2): {half.compound(two)}")
    show(f"hypot(2, 3, 6): {hypot(x: two, y: "3".to[BF16](), z: "6".to[BF16]())}")
    when try ("3e38".to[BF16]()).add("3e38".to[BF16]())
        is None => show("3e38 + 3e38: overflow")
        else as v => show(f"3e38 + 3e38: {v}")
