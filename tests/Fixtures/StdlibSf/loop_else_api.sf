module Tests/StdlibSf/LoopElseApi

import IO/Console
# The `else` of a `while` or an `each` runs only when the body ran zero times: the condition was false at the
# very first check, or the source was empty. Once the body has run it never runs, however the loop ended (the
# condition turning false, the source running out, `break`). A failure in a `while … else` condition is a
# failure point like any other: a recovery keyword above it recovers it.

routine count_down(from: Integer) -> Text
    var n = from
    var steps = 0
    while n > 0
        n -= 1
        steps += 1
    else
        return "never started"
    return f"counted {steps}"

routine first_negative(xs: List[Integer]) -> Text
    each x in xs
        if x < 0
            return f"found {x}"
    else
        return "empty"
    return "none negative"

routine stop_at_three(limit: Integer) -> Text
    var n = 0
    while n < limit
        n += 1
        if n == 3
            break
    else
        return "never started"
    return f"stopped at {n}"

routine ratio_steps(numerator: Integer, divisor: Integer) -> Integer
    var n = 0
    while n < numerator // divisor
        n += 1
    else
        return -1
    return n

routine start()
    show(count_down(from: 0))
    show(count_down(from: 3))
    show(stop_at_three(limit: 0))
    show(stop_at_three(limit: 10))
    show(stop_at_three(limit: 2))

    var empty = List[Integer]()
    show(first_negative(xs: empty))
    var some = List[Integer]()
    some.add_last(value: 4)
    some.add_last(value: 7)
    show(first_negative(xs: some))
    some.add_last(value: -2)
    show(first_negative(xs: some))

    each x in empty
        show(f"body {x}")
    else
        show("each else: empty source")
    each x in some
        if x == 7
            break
    else
        show("each else: not printed")
    show("each with break: no else")

    show(f"ratio ok: {try ratio_steps(numerator: 6, divisor: 2)}")
    show(f"ratio zero steps: {try ratio_steps(numerator: 0, divisor: 2)}")
    show(f"ratio try: {try ratio_steps(numerator: 6, divisor: 0)}")
    show(f"ratio grab: {grab ratio_steps(numerator: 6, divisor: 0)}")
    show(f"ratio lookup: {lookup ratio_steps(numerator: 6, divisor: 0)}")
    show("DONE")
    return
