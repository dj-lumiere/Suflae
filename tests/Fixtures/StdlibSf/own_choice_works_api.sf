module Tests/StdlibSf/OwnChoiceWorksApi

import IO/Console

# A Suflae choice or flags hands its cases back in Suflae's own list, counted with Int, and a Suflae
# list of jobs runs them together.
choice Color
    RED
    GREEN
    BLUE

flags Perm
    READ
    WRITE

routine fetch(id: Int) -> Int
    waitfor(5ms)
    return id * 10

routine slow(id: Int) -> Int
    for i in 0 til 100
        if cancellation_requested()
            return -1
        waitfor(5ms)
    return id

routine names(colors: List[Color]) -> Text
    var out = ""
    for c in colors
        out = out + f"{c} "
    return out

routine start()
    show(f"colors={names(colors: Color.all_cases())}count={Color.count() * 10}")
    show(f"perms={Perm.all_cases().count()} count={Perm.count()}")
    var jobs = [fetch.to[Work](id: 1), fetch.to[Work](id: 2), fetch.to[Work](id: 3)]
    show(f"gather={jobs.gather()}")
    var racers = [fetch.to[Work](id: 4), fetch.to[Work](id: 5)]
    show(f"race={racers.race() > 0}")
    var stoppers = [slow.to[Work](id: 6), slow.to[Work](id: 7)]
    stoppers.cancel_all()
    show(f"cancel={stoppers[0].is_done()} {stoppers[1].is_done()}")
    show("DONE")
    return
