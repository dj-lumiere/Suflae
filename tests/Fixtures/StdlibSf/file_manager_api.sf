module Tests/StdlibSf/FileManagerApi

import IO/Environment
import IO/Errors

# OsFileManager in Suflae: a file is made before it is written, a missing one fails, listings are Suflae lists, rename
# changes only a name and move puts a file into another directory.
routine start()
    var place = OsEnvironment.temp_directory().go_to(name: "sf_fixture_file_manager")
    if OsFileManager.exists(at: place)
        OsFileManager.delete_all(at: place)
    var root = OsFileManager.make_directory(at: place, parents: true)
    var notes = OsFileManager.make_file(at: root.file(name: "notes.txt"), replacing: true)
    OsFileManager.write_text(at: notes, content: "hello")
    show(OsFileManager.read_text(at: notes))
    OsFileManager.make_file(at: root.file(name: "a.txt"), replacing: true)
    show(OsFileManager.list(at: root).sorted())
    show(OsFileManager.entries(at: root).count())
    show(try OsFileManager.read_text(at: root.file(name: "missing.txt")))
    when check OsFileManager.make_file(at: notes)
        is File => show("made again")
        is IOError => show("already exists")
    when check OsFileManager.write_text(at: root.file(name: "missing.txt"), content: "x")
        is None => show("written")
        is NotFoundError => show("not found")
    var renamed = OsFileManager.rename(at: notes, to: "renamed.txt")
    show(renamed.name())
    var inner = OsFileManager.make_directory(at: root.go_to(name: "inner"))
    var moved = OsFileManager.move(at: renamed, into: inner)
    show(f"{moved.parent().name()} {OsFileManager.exists(at: moved)} {OsFileManager.exists(at: renamed)}")
    var storage = OsFileManager.open_storage[Byte](at: moved)
    storage[0] = b'H'
    show(storage.count())
    storage.close()
    show(OsFileManager.read_text(at: moved))
    show(f"PATH set: {(try OsEnvironment.variable(name: "PATH")).is_present()}")
    # The snapshot keeps each name as the system spells it, and Windows spells this one Path.
    var path_listed = false
    each name in OsEnvironment.to[Dict[Text, Text]]().keys()
        if name.to_uppercase() == "PATH"
            path_listed = true
    show(f"PATH in the snapshot: {path_listed}")
    show(OsEnvironment.arguments().count())
    OsFileManager.delete_all(at: root)
    show(OsFileManager.exists(at: root))
