module Tests/StdlibSf/FileManagerApi

import IO/Environment
import IO/Errors

# FileManager in Suflae: a file is made before it is written, a missing one fails, listings are Suflae lists, rename
# changes only a name and move puts a file into another directory.
routine start()
    var place = Environment.temp_directory().go_to(name: "sf_fixture_file_manager")
    if FileManager.exists(at: place)
        FileManager.delete_all(at: place)
    var root = FileManager.make_directory(at: place, parents: true)
    var notes = FileManager.make_file(at: root.file(name: "notes.txt"), replacing: true)
    FileManager.write_text(at: notes, content: "hello")
    show(FileManager.read_text(at: notes))
    FileManager.make_file(at: root.file(name: "a.txt"), replacing: true)
    show(FileManager.list(at: root).sorted())
    show(FileManager.entries(at: root).count())
    show(try FileManager.read_text(at: root.file(name: "missing.txt")))
    when check FileManager.make_file(at: notes)
        is File => show("made again")
        is IOError => show("already exists")
    when check FileManager.write_text(at: root.file(name: "missing.txt"), content: "x")
        is None => show("written")
        is NotFoundError => show("not found")
    var renamed = FileManager.rename(at: notes, to: "renamed.txt")
    show(renamed.name())
    var inner = FileManager.make_directory(at: root.go_to(name: "inner"))
    var moved = FileManager.move(at: renamed, into: inner)
    show(f"{moved.parent().name()} {FileManager.exists(at: moved)} {FileManager.exists(at: renamed)}")
    show(FileManager.read_text(at: moved))
    show(f"PATH set: {(try Environment.variable(name: "PATH")).is_present()}")
    # The snapshot keeps each name as the system spells it, and Windows spells this one Path.
    var path_listed = false
    each name in Environment.to[Dict[Text, Text]]().keys()
        if name.to_uppercase() == "PATH"
            path_listed = true
    show(f"PATH in the snapshot: {path_listed}")
    show(Environment.arguments().count())
    FileManager.delete_all(at: root)
    show(FileManager.exists(at: root))
