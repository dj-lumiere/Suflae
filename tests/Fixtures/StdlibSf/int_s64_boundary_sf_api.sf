module Tests/StdlibSf/IntS64BoundarySfApi

# Int around the S64 line, where a value stops being held in the value itself and gets a shared list of limbs:
# S64_MIN and S64_MAX and one past each, 2^64 - 1 and 2^64, mixed signs, the conversions that read both forms, and
# literals outside the S64 range used in loops, kept in globals and lists, and handed to Work jobs. Each use of
# such a literal shares one list laid down once, and every value made from it gives its share back when it ends: a
# use that gave back too much would end that list while other values still read it.

import IO/Console

global seen: Int = 0

routine describe(label: Text, v: Int)
    var s64 = try v.to[S64]()
    var u64 = try v.to[U64]()
    var s = when s64
        is None => "none"
        else as x => f"{x}"
    var u = when u64
        is None => "none"
        else as x => f"{x}"
    show(f"{label}: {v} neg={v.is_negative()} bits={v.bit_length()} even={v.is_even()} s64={s} u64={u}")

routine sum_with_literal(times: Int) -> Int
    var total = 0
    var i = 0
    until i >= times
        total = total + 18446744073709551616 - 9223372036854775808
        i += 1
    seen += 18446744073709551616
    return total

routine start()
    var s64_max = 9223372036854775807
    var s64_min = -9223372036854775808
    var two_63 = 9223372036854775808
    var below_min = -9223372036854775809
    var u64_max = 18446744073709551615
    var two_64 = 18446744073709551616

    describe(label: "S64_MAX", v: s64_max)
    describe(label: "S64_MIN", v: s64_min)
    describe(label: "2^63", v: two_63)
    describe(label: "-2^63 - 1", v: below_min)
    describe(label: "2^64 - 1", v: u64_max)
    describe(label: "2^64", v: two_64)

    show(f"S64_MAX + 1 = {s64_max + 1}, same as 2^63: {s64_max + 1 == two_63}")
    show(f"2^63 - 1 = {two_63 - 1}, same as S64_MAX: {two_63 - 1 == s64_max}")
    show(f"S64_MIN - 1 = {s64_min - 1}, same: {s64_min - 1 == below_min}")
    show(f"-2^63 - 1 + 1 = {below_min + 1}, same as S64_MIN: {below_min + 1 == s64_min}")
    show(f"-S64_MIN = {-s64_min}, -(2^63) = {-two_63}, same as S64_MIN: {-two_63 == s64_min}")
    show(f"S64_MIN // -1 = {s64_min // -1}, S64_MIN * -1 = {s64_min * -1}, S64_MAX * 2 = {s64_max * 2}")
    show(f"2^64 - 1 + 1 = {u64_max + 1}, 1 << 63 = {1 << 63}, 1 << 64 = {1 << 64}, S64_MIN >> 63 = {s64_min >> 63}")
    show(f"2^64 + S64_MIN = {two_64 + s64_min}, S64_MIN - 2^64 = {s64_min - two_64}, -2^63 - 1 + 2^63 = {below_min + two_63}")
    show(f"2^64 // -3 = {two_64 // -3}, 2^64 % -3 = {two_64 % -3}, S64_MIN // 7 = {s64_min // 7}, S64_MIN % 7 = {s64_min % 7}")
    show(f"S64_MIN & 2^64 - 1 = {s64_min & u64_max}, 2^63 ^ S64_MIN = {two_63 ^ s64_min}")
    show(f"compare: {s64_max < two_63} {s64_min > below_min} {two_63 > s64_min} {u64_max < two_64}")
    show(f"B64: {two_63.to[B64]()} {u64_max.to[B64]()} {s64_min.to[B64]()} {two_64.to[B64]()}")
    show(f"2^63 / 2 = {two_63 / 2}")

    # A list indexed past and with values past the S64 line.
    var values = [s64_max, two_63, below_min, two_64]
    values[0] = values[0] + 1
    show(f"list: {values} {values[0] == values[1]}")

    var total = sum_with_literal(times: 1000)
    show(f"loop total: {total}")
    var jobs = [sum_with_literal.to[Work](times: 2000), sum_with_literal.to[Work](times: 3000),
        sum_with_literal.to[Work](times: 4000), sum_with_literal.to[Work](times: 5000)]
    jobs.start_now()
    var results = jobs.gather()
    show(f"jobs: {results[0]} {results[1]} {results[2]} {results[3]}")
    show(f"seen: {seen}")
    show(f"still 2^64: {two_64} {two_64 == 18446744073709551616}")
