module Tests/StdlibSf/RecoveryAccessApi

import IO/Console
# With `try` or `check` in front of a call, a failing subscript or conversion anywhere beneath it is
# recovered: an index out of range on a list or a text, a missing dictionary key, a value that does not fit
# the target type, a text that does not parse, also in a routine that is not failable. Only the carrier
# differs.

crashable NopeError
    what: Text

routine NopeError.crash_message() -> Text
    return f"nope: {me.what}"

routine pick!(items: List[Integer], i: Integer) -> Integer
    if i < 0
        throw NopeError(what: "negative")
    var v = items[i]
    return v

routine letter!(t: Text, i: Integer) -> Char
    if i < 0
        throw AbsentValueError()
    return t[i]

routine score!(ages: Dict[Text, Integer], name: Text) -> Integer
    if name == ""
        throw NopeError(what: "empty")
    return ages[name] * 10

routine narrow!(n: S64) -> S8
    if n < 0
        throw AbsentValueError()
    var b = S8(from: n)
    return b

routine parsed!(t: Text) -> Integer
    if t == ""
        throw AbsentValueError()
    return Integer(text: t)

# a routine that is not failable, with a subscript, called bare by a failable one
routine last_of(items: List[Integer]) -> Integer
    return items[items.count() - 1]

routine last_plus_one!(items: List[Integer]) -> Integer
    if items.count() > 1000
        throw AbsentValueError()
    return last_of(items: items) + 1

routine start()
    var nums = [4, 5]
    var empty: List[Integer] = []
    show(f"try pick(1): {try pick(items: nums, i: 1)}")
    show(f"try pick(9): {try pick(items: nums, i: 9)}")
    show(f"grab pick(9): {check pick(items: nums, i: 9)}")
    show(f"check pick(9): {check pick(items: nums, i: 9)}")
    show(f"try letter(1): {try letter(t: "abc", i: 1)}")
    show(f"grab letter(9): {check letter(t: "abc", i: 9)}")
    var ages = {"ann": 3}
    show(f"try score(ann): {try score(ages: ages, name: "ann")}")
    show(f"check score(bob): {check score(ages: ages, name: "bob")}")
    show(f"grab score(empty): {check score(ages: ages, name: "")}")
    show(f"try narrow(100): {try narrow(n: 100)}")
    show(f"grab narrow(300): {check narrow(n: 300)}")
    show(f"try parsed(42): {try parsed(t: "42")}")
    show(f"grab parsed(4x): {check parsed(t: "4x")}")
    show(f"try last_plus_one(nums): {try last_plus_one(items: nums)}")
    show(f"grab last_plus_one(empty): {check last_plus_one(items: empty)}")
    show(f"try nums[7]: {try nums[7]}")
    show("DONE")
    return
