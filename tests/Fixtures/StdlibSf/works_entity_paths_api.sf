module Tests/StdlibSf/WorksEntityPathsApi

# An entity reaching several jobs by a path other than an argument still takes its lock around each statement:
# captured by a lambda the jobs call, sent on a shared channel, or read as an element of a list the jobs share.
# Every update is kept.

import IO/Console

entity Cell
    n: Int

routine call_times(f: Callable[(), Int], times: S64)
    each i in 0 til times
        f()

routine drain(rx: SharedReceiver[Cell]) -> Int
    var taken = 0
    each c in rx
        each i in 0 til 500
            c.n = c.n + 1
        taken = taken + 1
    return taken

routine bump_first(cs: List[Cell], times: S64)
    each i in 0 til times
        cs[0].n = cs[0].n + 1

routine start()
    var captured = Cell(n: 0)
    var bump = () given (captured) => captured.n = captured.n + 1
    var calls = [call_times.to[Work](f: bump, times: 1000), call_times.to[Work](f: bump, times: 1000)]
    calls.gather()
    show(f"lambda {captured.n}")

    var sent = Cell(n: 0)
    var (tx, rx) = make_shared_channel[Cell](capacity: 4)
    var drains = [drain.to[Work](rx: rx), drain.to[Work](rx: rx)]
    each d in drains
        d.start_now()
    each i in 0 til 4
        tx.transmit(item: sent)
    tx.close()
    var taken = drains.gather()
    show(f"channel {sent.n} {taken[0] + taken[1]}")

    var cells = [Cell(n: 0)]
    var bumps = [bump_first.to[Work](cs: cells, times: 1000), bump_first.to[Work](cs: cells, times: 1000)]
    bumps.gather()
    show(f"element {cells[0].n}")
