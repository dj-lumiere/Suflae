module Tests/StdlibSf/CoroSuspendedApi

import IO/Console
# SF twin of Stdlib/coro_suspended_api.rf. `agent f(...)` over a plain routine yields an Agent[T]
# handle, and `retrieve()` starts it, drives it to completion (through every yield) and returns its
# value. SF spells the yield through the `yield_now()` surface (RF's fixture uses the raw
# `C::rf_coro_yield()`, which SF hides); the driven result is identical, so the expected output matches.

routine compute(x: S64) -> S64
    return x * 2

routine counter() -> S64
    var n: S64 = 10
    yield_now()
    n = n + 5
    yield_now()
    n = n + 5
    return n

routine start()
    var c = compute.to[Agent](x: 21)
    show(f"compute => {c.retrieve()}")

    var k = counter.to[Agent]()
    show(f"counter => {k.retrieve()}")
    return
