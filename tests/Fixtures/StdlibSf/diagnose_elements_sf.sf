module Tests/StdlibSf/DiagnoseElementsSf

import IO/Console

# diagnose never reads two different values the same: a variant names the member type its value has, and a text
# element is quoted with its escapes, in a list, a set and a dict.

routine start()
    var a: S32 | S64 = 1.to[S32]()
    var b: S32 | S64 = 1.to[S64]()
    show(f"a: {a:?}")
    show(f"b: {b:?}")
    var nums = List[S32 | S64]()
    nums.add_last(value: a)
    nums.add_last(value: b)
    show(f"list of variants: {nums:?}")
    var one = ["a\", \"b"]
    var two = ["a", "b"]
    show(f"one text: {one:?}")
    show(f"two texts: {two:?}")
    show(f"represent stays plain: {two}")
    var keyed = {"k\"": 2}
    show(f"dict: {keyed:?}")
    var tags = {"t\\"}
    show(f"set: {tags:?}")
