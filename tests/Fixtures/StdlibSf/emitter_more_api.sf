module Tests/StdlibSf/EmitterMoreApi

# Collecting into a fixed-size Array, and terminals and adapters straight on an emitter.
import IterTools

# An emitter the program writes: each step hands out the next number up to `last`.
entity Steps
obeys Emitter[Integer]
    current: Integer
    last: Integer

failable routine Steps.emit() -> Integer
    if me.current > me.last
        throw AbsentValueError()
    var value = me.current
    me.current = me.current + 1
    return value

routine make() -> List[Integer]
    return [1, 5, 7]

routine start()
    var xs = [4, 1, 3]

    # to[Array[T, N]]: the bracket names the size, a different count fails.
    show(f"array: {xs.to[Array[Integer, 3]]()}")
    show(f"array from where: {xs.where(predicate: v => v > 1).to[Array[Integer, 2]]()}")
    when try xs.to[Array[Integer, 2]]()
        is None => show("array of 2: none")
        else => show("array of 2: some")
    var short = check xs.to[Array[Integer, 5]]()
    when short
        is ElementCountMismatchError as e => show(e.crash_message())
        else => show("array of 5: some")

    # Terminals and adapters on an emitter go on from where it is.
    var it = xs.emitter()
    show(f"first: {it.emit()}")
    show(f"rest: {it.to[List]()}")
    var counting = (1 to 5).emitter()
    show(f"skipped: {counting.emit()}")
    show(f"sum of the rest: {counting.sum()}")
    var walk = xs.emitter()
    show(f"skipped: {walk.emit()}")
    show(f"where on the rest: {walk.where(predicate: v => v > 1).to[List]()}")

    # Walking an emitter the program writes goes through the emitter itself.
    var steps = Steps(current: 1, last: 3)
    show(f"first step: {steps.emit()}")
    each n in steps
        show(f"step: {n}")

    # An adapter given another value later keeps the list it now walks, a list made in that statement too.
    var kept = xs.where(predicate: v => v > 3)
    kept = make().where(predicate: v => v > 4)
    var noise = [100, 200, 300, 400]
    each k in kept
        show(f"kept: {k}")
    show(f"noise: {noise.count()}")
