module Tests/StdlibSf/RangeCounterApi

# An `each` over a range walks every value once: the ends of a type, steps both ways, `break`, `continue` and
# `return` inside, ranges kept in a variable, and ranges over decimals.

import IO/Console

routine first_over(limit: Int) -> Int
    each i in 0 til 100
        if i * i > limit
            return i
    return -1

routine walk_by(step: Int) -> Text
    var out = ""
    each i in 10 to 0 by step
        out = out + f"{i} "
    return out

routine start()
    var top = ""
    var near: S64 = S64_MAX - 2
    each i in near to S64_MAX
        top = top + f"{i - near} "
    show(f"to S64_MAX: {top}")
    var u8_250: U8 = 250
    var count = 0
    each b in u8_250 to U8_MAX
        count = count + 1
    show(f"250 to U8_MAX: {count}")
    var bottom = ""
    var u_3: U64 = 3
    var u_0: U64 = 0
    each u in u_3 til u_0 by -1
        bottom = bottom + f"{u} "
    show(f"3 til 0 by -1 (U64): {bottom}")
    show(f"10 to 0 by -3: {walk_by(step: -3)}")
    show(f"10 to 0 by 4: {walk_by(step: 4)}")
    var skipped = ""
    each i in 0 til 10
        if i % 2 == 0
            continue
        if i > 7
            break
        skipped = skipped + f"{i} "
    show(f"odd below 8: {skipped}")
    var inclusive = ""
    each i in 1 to 6
        if i == 2
            continue
        if i == 5
            break
        inclusive = inclusive + f"{i} "
    show(f"1 to 6 skipping 2, stop at 5: {inclusive}")
    show(f"first over 50: {first_over(limit: 50)}")
    var empty = 0
    each _ in 5 til 5
        empty = empty + 1
    each _ in 5 to 4
        empty = empty + 1
    each _ in 4 to 5 by -1
        empty = empty + 1
    show(f"empty: {empty}")
    var pairs = 0
    each i in 0 til 4
        each j in i to 3
            pairs = pairs + 1
    show(f"pairs: {pairs}")
    var kept = 2 to 8 by 3
    var walked = ""
    each i in kept
        walked = walked + f"{i} "
    show(f"kept range: {walked}")
    var quarters = ""
    each x in 0.0 to 1.0 by 0.25
        quarters = quarters + f"{x} "
    show(f"decimals: {quarters}")
    var evaluated = ""
    var hi = 3
    each i in 0 til hi
        hi = 10
        evaluated = evaluated + f"{i} "
    show(f"end read once: {evaluated}")
    show("DONE")
