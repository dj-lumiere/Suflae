module Tests/StdlibSf/ObjectHackerApi

import IO/Console
import ObjectHacker
# ObjectHacker reads and changes live objects from the outside: what an object is made of, one member
# variable (secret ones included), and a change every alias sees.
entity Hero
    name: Text
    hp: S64
    secret seed: S64

record Point
    x: S64
    y: S64

routine count_secret(infos: List[MemberVariableInfo]) -> Integer
    var n = 0
    each info in infos
        if info.is_secret
            n = n + 1
    return n

routine start()
    var hero = Hero(name: "Ada", hp: 10, seed: 7)
    var alias = hero

    show(f"type: {type_name(of: hero)}")
    each info in memvars(of: hero)
        show(f"memvar {info.order}: {info.name}: {info.type_name}, secret: {info.is_secret}")
    show(f"memvars: {count_secret(infos: memvars(of: hero))} secret, last at {memvars(of: hero)[^1].order + 1}")

    show(f"peek: {peek(target: hero)}")
    show(f"peek hp: {peek(target: hero, memvar: "hp")}")
    show(f"peek seed: {peek(target: hero, memvar: "seed")}")
    when try peek(target: hero, memvar: "mana")
        is None => show("peek mana: absent")
        else v => show(f"peek mana: {v}")

    poke(target: hero, memvar: "hp", value: SerialValue(from: 25_s64))
    show(f"after poke, alias.hp: {alias.hp}")
    when grab poke(target: hero, memvar: "mana", value: SerialValue(from: 1_s64))
        is NoSuchMemberVariableError e => show(f"poke mana: {e.crash_message()}")
        else => show("poke mana: done")

    var p = Point(x: 3, y: 4)
    show(f"point: {type_name(of: p)} {peek(target: p, memvar: "y")}")

    var seen = watch(target: hero)
    show(f"watched alive: {seen.is_alive()}")

    show("DONE")
    return
