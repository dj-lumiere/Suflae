<Project Sdk="Microsoft.NET.Sdk">
  <!-- Suflae: the Suflae front end (its lexer) and the `suflae` command line, over the Anvila builder core.
       A Suflae build analyzes the RazorForge standard library as well, so this references the RazorForge
       front end (its lexer and standard library) until the shared library moves to Ingrid. -->
  <PropertyGroup>
    <SonarQubeTestProject>false</SonarQubeTestProject>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.5.0</Version>
    <AssemblyName>Suflae</AssemblyName>
    <RootNamespace>Suflae</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>suflae</ToolCommandName>
    <PackageId>Suflae</PackageId>
    <Description>The Suflae toolchain.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Anvila\Anvila.csproj"/>
    <ProjectReference Include="..\RazorForge\RazorForge.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Suflae.Tests"/>
  </ItemGroup>

  <!-- The Suflae standard library, laid out as Standard\Suflae next to the executable. -->
  <ItemGroup>
    <Content Include="Standard\**\*" Link="Standard\Suflae\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" PackageCopyToOutput="true"/>
    <None Remove="Standard\**\*"/>
  </ItemGroup>

  <Import Project="..\Ingrid\StageIngridRuntime.targets"/>
  <Import Project="..\Anvila\PatchMacLibLlvm.targets"/>

  <!-- rider-plugin\ is the Rider plugin, a Gradle project of its own. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);rider-plugin\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- tests\ is its own project. -->
  <ItemGroup>
    <Compile Remove="tests\**"/>
    <None Remove="tests\**"/>
    <Content Remove="tests\**"/>
    <EmbeddedResource Remove="tests\**"/>
  </ItemGroup>

  <!-- A file moved or deleted in the library's sources leaves its old copy in the output, where the builder would read
       it as part of the library: every copy under Standard/RazorForge whose source is gone is taken out before the copy. -->
  <Target Name="RemoveStaleRazorForgeLibrary" BeforeTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <_RemoveStaleRazorForgeLibrarySource Include="$(MSBuildProjectDirectory)/../RazorForge/Standard/**/*"/>
      <_RemoveStaleRazorForgeLibraryKept Include="@(_RemoveStaleRazorForgeLibrarySource->'$(OutDir)Standard/RazorForge/%(RecursiveDir)%(Filename)%(Extension)')"/>
      <_RemoveStaleRazorForgeLibraryCopy Include="$(OutDir)Standard/RazorForge/**/*"/>
      <_RemoveStaleRazorForgeLibraryStale Include="@(_RemoveStaleRazorForgeLibraryCopy)" Exclude="@(_RemoveStaleRazorForgeLibraryKept)"/>
    </ItemGroup>
    <Delete Files="@(_RemoveStaleRazorForgeLibraryStale)"/>
  </Target>

  <!-- A file moved or deleted in the library's sources leaves its old copy in the output, where the builder would read
       it as part of the library: every copy under Standard/Suflae whose source is gone is taken out before the copy. -->
  <Target Name="RemoveStaleSuflaeLibrary" BeforeTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <_RemoveStaleSuflaeLibrarySource Include="$(MSBuildProjectDirectory)/Standard/**/*"/>
      <_RemoveStaleSuflaeLibraryKept Include="@(_RemoveStaleSuflaeLibrarySource->'$(OutDir)Standard/Suflae/%(RecursiveDir)%(Filename)%(Extension)')"/>
      <_RemoveStaleSuflaeLibraryCopy Include="$(OutDir)Standard/Suflae/**/*"/>
      <_RemoveStaleSuflaeLibraryStale Include="@(_RemoveStaleSuflaeLibraryCopy)" Exclude="@(_RemoveStaleSuflaeLibraryKept)"/>
    </ItemGroup>
    <Delete Files="@(_RemoveStaleSuflaeLibraryStale)"/>
  </Target>
</Project>
